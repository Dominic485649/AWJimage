{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-x64-debug",
      "displayName": "Windows MSVC x64 Debug",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/x64/Debug",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg-overlays",
        "AWJ_VCPKG_LIBRARY_CONFIG": "Debug",
        "AVIF_STATIC_MSVC_RUNTIME": "ON",
        "AVIF_STATIC_SLINT": "ON",
        "AWJ_ENABLE_ZENRAVIF": "ON"
      }
    },
    {
      "name": "windows-msvc-x64-release",
      "displayName": "Windows MSVC x64 Release",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/x64/Release",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg-overlays",
        "AWJ_VCPKG_LIBRARY_CONFIG": "Release",
        "AVIF_STATIC_MSVC_RUNTIME": "ON",
        "AVIF_STATIC_SLINT": "ON",
        "AWJ_ENABLE_ZENRAVIF": "ON",
        "AWJ_ENABLE_X64_V3": "ON",
        "AVIF_ENABLE_RELEASE_IPO": "ON"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "description": "Portable Linux base: toolchain comes from the environment. Set VCPKG_ROOT, and CC/CXX if the default cc/c++ is not a C++23-modules-capable compiler.",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg-overlays",
        "AVIF_STATIC_MSVC_RUNTIME": "OFF",
        "AVIF_STATIC_SLINT": "ON",
        "AWJ_ENABLE_ZENRAVIF": "ON",
        "AWJ_ENABLE_SVTAV1HDR": "ON",
        "AWJ_ENABLE_JPEGLI": "ON",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "linux-x64-debug",
      "displayName": "Linux x64 Debug (portable)",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/linux-x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AWJ_VCPKG_LIBRARY_CONFIG": "Debug"
      }
    },
    {
      "name": "linux-x64-release",
      "displayName": "Linux x64 Release (portable)",
      "inherits": "linux-base",
      "binaryDir": "${sourceDir}/build/linux-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG",
        "CMAKE_C_FLAGS_RELEASE": "-O3 -DNDEBUG",
        "AWJ_VCPKG_LIBRARY_CONFIG": "Release",
        "AVIF_ENABLE_RELEASE_IPO": "ON",
        "AWJ_ENABLE_X64_V3": "ON"
      }
    },
    {
