        "AVIF_STATIC_SLINT": "ON",
        "AWJ_ENABLE_ZENRAVIF": "ON",
        "AWJ_ENABLE_SVTAV1HDR": "ON",
        "AWJ_ENABLE_JPEGLI": "ON",
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Debug",
        "AWJ_VCPKG_LIBRARY_CONFIG": "Debug"
      },
      "binaryDir": "${sourceDir}/build/linux-clang-x64-debug"
    },
    {
      "name": "linux-clang-x64-release",
      "displayName": "Linux Clang 20 x64 Release",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/clang-20",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++-20",
