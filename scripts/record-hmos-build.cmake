cmake_minimum_required(VERSION 3.30)
get_filename_component(repo "${CMAKE_CURRENT_LIST_DIR}/.." REALPATH)
include("${repo}/cmake/sdk-hmos-cross-build.cmake")
# 薄采集入口：prepare 在真实构建前生成一次 nonce；record 签发 B；verify 只核对，不刷新标记。
# 此脚本不运行编译器生成目标代码，也不运行任何目标程序。
if(NOT ACTION MATCHES "^(check-source|prepare|record|verify)$")
    message(FATAL_ERROR "ACTION 必须为 check-source、prepare、record 或 verify")
endif()
if(NOT DEFINED MODE)
    set(MODE formal)
endif()
if(NOT MODE MATCHES "^(formal|candidate)$")
    message(FATAL_ERROR "MODE 必须为 formal 或 candidate")
endif()
awj_sdk_hmos_reject_execution_options()
file(REAL_PATH "${WORK_ROOT}" work)
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" OR NOT "${work}/src" STREQUAL repo OR
    work MATCHES "^/mnt/[A-Za-z](/|$)")
    message(FATAL_ERROR "HMOS 采集必须使用本项目原生工作根及其 src 源码")
endif()
file(STRINGS "${repo}/VERSION" version)
awj_sdk_select_profile("${version}" hmos-arm64-api26-clang23 Linux x86_64 profile)
awj_sdk_require_hmos_cross_scope("${version}" profile)
execute_process(COMMAND git -C "${repo}" rev-parse HEAD OUTPUT_VARIABLE head
    OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND git -C "${repo}" status --porcelain=v1 OUTPUT_VARIABLE status
    OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
set(source_dirty false)
if(NOT status STREQUAL "")
    set(source_dirty true)
endif()
if(MODE STREQUAL "formal")
    execute_process(COMMAND git -C "${repo}" describe --exact-match --tags HEAD OUTPUT_VARIABLE tag
        OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    if(source_dirty OR NOT tag STREQUAL version)
        message(FATAL_ERROR "formal HMOS 构建要求干净源码及精确 VERSION tag")
    endif()
endif()
execute_process(COMMAND bash "${repo}/scripts/release-source-fingerprint.sh" --repository "${repo}"
    OUTPUT_VARIABLE fingerprint OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
awj_sdk_require_hash("${fingerprint}" source_fingerprint)
if(ACTION STREQUAL "check-source")
    message(STATUS "HMOS ${MODE} 源码前置检查完成；未构建或执行目标程序")
    return()
endif()
foreach(key IN ITEMS BUILD_DIRECTORY RECORD_DIRECTORY DEPENDENCY_DIRECTORY VCPKG_ROOT
    TARGET_NATIVE_SDK_DIRECTORY TARGET_RESOURCE_DIRECTORY TARGET_CMAKE_TOOLCHAIN_FILE LLVM_DIRECTORY)
    if(NOT IS_ABSOLUTE "${${key}}" OR "${${key}}" MATCHES "[ \t\r\n;\"\\\\]" OR
        "${${key}}" MATCHES "^/mnt/[A-Za-z](/|$)")
        message(FATAL_ERROR "HMOS 缺少无歧义原生绝对 CLI 路径：${key}")
    endif()
    file(REAL_PATH "${${key}}" "${key}")
endforeach()
foreach(key IN ITEMS BUILD_DIRECTORY RECORD_DIRECTORY DEPENDENCY_DIRECTORY)
    assert_under("${work}" "${${key}}")
endforeach()
if(NOT IS_DIRECTORY "${RECORD_DIRECTORY}" OR NOT IS_DIRECTORY "${DEPENDENCY_DIRECTORY}/arm64-ohos-clang23")
    message(FATAL_ERROR "HMOS 结果目录及已安装目标依赖必须已存在")
endif()
file(REAL_PATH "${repo}/cmake/toolchains/ohos-clang23.cmake" expected_toolchain)
if(NOT TARGET_CMAKE_TOOLCHAIN_FILE STREQUAL expected_toolchain)
    message(FATAL_ERROR "HMOS 采集只使用当前源码的既定 OHOS 工具链")
endif()
awj_sdk_compiler_identity(profile identity)
awj_sdk_find_llvm_tool(readobj llvm-readobj 23)
awj_sdk_hmos_input_identity(inputs)
awj_sdk_hmos_tree_identity("${DEPENDENCY_DIRECTORY}/arm64-ohos-clang23" dependency_hash)
foreach(path IN ITEMS "${VCPKG_ROOT}/vcpkg" "${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake")
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
        message(FATAL_ERROR "HMOS 缺少真实 vcpkg 输入")
    endif()
endforeach()
file(SHA256 "${VCPKG_ROOT}/vcpkg" vcpkg_hash)
awj_sdk_hmos_tree_identity("${VCPKG_ROOT}/scripts" vcpkg_scripts_hash)
set(state "{\"schema\":1,\"kind\":\"hmos-build-input-snapshot\",\"source_dirty\":${source_dirty}}")
foreach(pair IN ITEMS "mode|${MODE}" "version|${version}" "git_head|${head}" "source_fingerprint|${fingerprint}"
    "source_directory|${repo}" "build_directory|${BUILD_DIRECTORY}" "record_directory|${RECORD_DIRECTORY}"
    "dependency_identity_sha256|${dependency_hash}" "input_identity_sha256|${inputs_sha256}"
    "vcpkg_sha256|${vcpkg_hash}" "vcpkg_scripts_sha256|${vcpkg_scripts_hash}")
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 key)
    list(GET parts 1 value)
    awj_sdk_json_quote(quoted "${value}")
    string(JSON state SET "${state}" "${key}" "${quoted}")
endforeach()
string(JSON state SET "${state}" inputs "${inputs}")
set(before_path "${RECORD_DIRECTORY}/hmos-inputs-before.json")
set(options_path "${RECORD_DIRECTORY}/hmos-configure-options.txt")
if(ACTION STREQUAL "prepare")
    if(EXISTS "${before_path}" OR EXISTS "${options_path}" OR EXISTS "${RECORD_DIRECTORY}/hmos-build.json")
        message(FATAL_ERROR "HMOS 来源采集目录已经使用；不覆盖 nonce 或历史证明")
    endif()
    string(RANDOM LENGTH 64 ALPHABET 0123456789abcdef nonce)
    string(JSON state SET "${state}" nonce "\"${nonce}\"")
    file(WRITE "${before_path}" "${state}\n")
    # 只输出逐行 -D 参数，由 shell 数组读取；不 source/eval 生成文件。
    file(WRITE "${options_path}"
        "-DAWJ_HMOS_RECORD_MODE=${MODE}\n-DAWJ_HMOS_GIT_HEAD=${head}\n-DAWJ_HMOS_SOURCE_FINGERPRINT=${fingerprint}\n-DAWJ_HMOS_INPUT_IDENTITY=${inputs_sha256}\n-DAWJ_HMOS_DEPENDENCY_IDENTITY=${dependency_hash}\n-DAWJ_HMOS_RECORD_NONCE=${nonce}\n-DAWJ_HMOS_EVIDENCE_DIRECTORY=${RECORD_DIRECTORY}\n")
    message(STATUS "已生成本轮私有构建输入；只重编本项目目标，不清理第三方缓存")
    return()
endif()
awj_sdk_read_file("${before_path}" 1048576 before)
awj_sdk_json_get(nonce "${before}" STRING nonce)
awj_sdk_require_hash("${nonce}" nonce)
string(JSON state SET "${state}" nonce "\"${nonce}\"")
string(JSON normalized_before GET "${before}")
if(NOT normalized_before STREQUAL state)
    message(FATAL_ERROR "HMOS 构建前后源码/Native/resource/工具/依赖输入变化；必须重新真实构建")
endif()
foreach(key IN ITEMS BUILD_LOG BUILD_COMMANDS INSTALL_DIRECTORY AUDIT_DIRECTORY)
    if(NOT IS_ABSOLUTE "${${key}}")
        message(FATAL_ERROR "HMOS 采集缺少可信绝对路径：${key}")
    endif()
    assert_under("${work}" "${${key}}")
endforeach()
if(NOT DEFINED TARGET_MANIFEST)
    set(TARGET_MANIFEST "${BUILD_DIRECTORY}/awj-hmos-targets-Release.json")
endif()
if(NOT DEFINED CROSS_TEST_BINARY_DIRECTORY)
    set(CROSS_TEST_BINARY_DIRECTORY "${RECORD_DIRECTORY}/runtime/Release")
endif()
assert_under("${work}" "${CROSS_TEST_BINARY_DIRECTORY}")
set(TARGET_LINK_MAP "${RECORD_DIRECTORY}/awj-sdk.map")
awj_sdk_read_file("${BUILD_DIRECTORY}/CMakeCache.txt" 4194304 cache)
# 只解析 cache 文本，不 include 可能被替换的生成脚本；拒绝迁移缓存和另一套依赖。
foreach(pair IN ITEMS "CMAKE_HOME_DIRECTORY|${repo}/sdk/harmonyos" "CMAKE_BUILD_TYPE|Release"
    "CMAKE_GENERATOR|Ninja" "CMAKE_TOOLCHAIN_FILE|${VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    "VCPKG_CHAINLOAD_TOOLCHAIN_FILE|${TARGET_CMAKE_TOOLCHAIN_FILE}" "VCPKG_INSTALLED_DIR|${DEPENDENCY_DIRECTORY}"
    "VCPKG_TARGET_TRIPLET|arm64-ohos-clang23" "AWJ_HMOS_RECORD_MODE|${MODE}"
    "AWJ_HMOS_GIT_HEAD|${head}" "AWJ_HMOS_SOURCE_FINGERPRINT|${fingerprint}" "AWJ_HMOS_RECORD_NONCE|${nonce}"
    "AWJ_RUNTIME_OUTPUT_ROOT|${RECORD_DIRECTORY}/runtime")
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 key)
    list(GET parts 1 expected)
    string(REGEX MATCHALL "(^|\n)${key}:[^=\r\n]+=[^\r\n]*" matches "${cache}")
    list(LENGTH matches count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "HMOS cache 缺少唯一真实配置：${key}")
    endif()
    list(GET matches 0 line)
    string(REGEX REPLACE "^\n?${key}:[^=]+=" "" actual "${line}")
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "HMOS cache 的源码/工具链/依赖/输入身份不匹配：${key}")
    endif()
endforeach()
awj_sdk_hmos_collect_targets("${TARGET_MANIFEST}" "${work}" "${repo}" "${BUILD_DIRECTORY}"
    profile identity "${readobj}" "${AUDIT_DIRECTORY}" targets)
foreach(field IN ITEMS mode version git_head source_fingerprint input_identity_sha256 dependency_identity_sha256 nonce)
    awj_sdk_json_get(value "${state}" STRING "${field}")
    awj_sdk_json_expect("${targets_manifest}" STRING "${value}" "${field}")
endforeach()
awj_sdk_json_get(map "${targets_manifest}" STRING targets awj_sdk link_map)
if(NOT map STREQUAL TARGET_LINK_MAP)
    message(FATAL_ERROR "HMOS SDK link map 不是本轮可信路径")
endif()
awj_sdk_check_install("${INSTALL_DIRECTORY}" profile)
awj_sdk_hmos_check_installed_sources("${INSTALL_DIRECTORY}" "${repo}")
file(SHA256 "${INSTALL_DIRECTORY}/${profile_library}" library_hash)
if(NOT library_hash STREQUAL targets_library_hash)
    message(FATAL_ERROR "HMOS 安装库不是本轮真实构建目标")
endif()
awj_sdk_read_file("${BUILD_LOG}" 268435456 build_log)
awj_sdk_read_file("${BUILD_COMMANDS}" 268435456 commands)
# 要求八次实际最终链接出现在本轮 --verbose 日志中，不能以 Ninja 无工作替代。
awj_sdk_hmos_program_names(programs)
foreach(target IN ITEMS awj_sdk ${programs})
    awj_sdk_json_get(link_inputs "${targets_manifest}" STRING targets "${target}" link_inputs)
    foreach(text IN ITEMS build_log commands)
        string(FIND "${${text}}" "--dependency-file=${link_inputs}" found)
        if(found LESS 0)
            message(FATAL_ERROR "HMOS 本轮真实命令缺少最终链接：${target}")
        endif()
    endforeach()
endforeach()
awj_sdk_read_file("${BUILD_DIRECTORY}/compile_commands.json" 134217728 compile_commands)
string(JSON count LENGTH "${compile_commands}")
if(count EQUAL 0 OR count GREATER 50000)
    message(FATAL_ERROR "HMOS 缺少有界的真实编译命令")
endif()
set(compiled)
math(EXPR last "${count} - 1")
foreach(index RANGE 0 ${last})
    awj_sdk_json_get(command "${compile_commands}" STRING "${index}" command)
    foreach(target IN ITEMS awj_sdk ${programs})
        if(NOT command MATCHES "CMakeFiles/${target}\\.dir/")
            continue()
        endif()
        if(NOT command MATCHES "(^| )-O3( |$)" OR NOT command MATCHES "(^| )-flto(=thin|=full)?( |$)" OR
            NOT command MATCHES "--target=aarch64-(unknown-)?linux-ohos" OR
            command MATCHES "(^| )(-O[012szg]|-Ofast|-fno-lto|-ffast-math)( |$)")
            message(FATAL_ERROR "HMOS 实际编译命令存在目标/Release/IPO 降档：${target}")
        endif()
        string(FIND "${command}" "-include${BUILD_DIRECTORY}/awj-hmos-build-run.h" found)
        if(found LESS 0)
            message(FATAL_ERROR "HMOS 实际编译命令未绑定本轮私有输入")
        endif()
        separate_arguments(tokens UNIX_COMMAND "${command}")
        list(GET tokens 0 driver)
        file(REAL_PATH "${driver}" driver)
        file(REAL_PATH "${identity_compiler}" expected_driver)
        awj_sdk_json_get(c_driver "${targets_manifest}" STRING compiler_c)
        file(REAL_PATH "${c_driver}" c_driver)
        if(NOT driver STREQUAL expected_driver AND NOT driver STREQUAL c_driver)
            message(FATAL_ERROR "HMOS 实际编译命令使用了其他编译器")
        endif()
        list(APPEND compiled "${target}")
    endforeach()
endforeach()
foreach(target IN ITEMS awj_sdk ${programs})
    if(NOT target IN_LIST compiled)
        message(FATAL_ERROR "HMOS 实际编译命令缺少目标：${target}")
    endif()
endforeach()
set(proof "{\"schema\":1,\"kind\":\"hmos-cross-build\",\"mode\":\"${MODE}\",\"status\":\"cross-linked\",\"validation_tier\":\"cross-build\",\"target_execution\":\"not-run\",\"target_loader\":\"not-run\",\"profile\":\"hmos-arm64-api26-clang23\",\"platform\":\"hmos-arm64-api26\",\"target_triple\":\"aarch64-unknown-linux-ohos\",\"abi\":1,\"native_codecs\":true,\"compiler_id\":\"Clang\",\"source_dirty\":${source_dirty},\"native_sdk_version\":\"26.0.0.105\",\"api\":26,\"libcxx_version\":15004,\"libcxx_abi_version\":1,\"libcxx_abi_namespace\":\"__n1\",\"runtime_linkage\":\"native-static\",\"features\":{\"d3d11\":false,\"shm\":false,\"ffmpeg\":false,\"stream\":false,\"gpu\":false},\"encoders\":[\"png\",\"webp\",\"jxl\",\"jpegli\",\"avif\"],\"build_strategy\":\"project-targets-only\",\"flags_source\":\"cmake-generated-target-profile\"}")
foreach(field IN ITEMS version git_head source_fingerprint input_identity_sha256 dependency_identity_sha256 nonce vcpkg_sha256 vcpkg_scripts_sha256)
    awj_sdk_json_get(value "${state}" STRING "${field}")
    string(JSON proof SET "${proof}" "${field}" "\"${value}\"")
endforeach()
foreach(pair IN ITEMS "library_sha256|${library_hash}" "compiler_version|${identity_compiler_version}"
    "compiler_sha256|${identity_compiler_hash}" "target_manifest_sha256|${targets_manifest_hash}")
    string(REPLACE "|" ";" parts "${pair}")
    list(GET parts 0 key)
    list(GET parts 1 value)
    string(JSON proof SET "${proof}" "${key}" "\"${value}\"")
endforeach()
awj_sdk_json_quote(banner "${identity_banner}")
string(JSON proof SET "${proof}" compiler_banner "${banner}")
foreach(field IN ITEMS toolchain_sha256 libcxx_config_sha256 libcxx_config_site_sha256 libcxx_static_sha256 libunwind_sha256)
    awj_sdk_json_get(value "${inputs}" STRING "${field}")
    string(JSON proof SET "${proof}" "${field}" "\"${value}\"")
endforeach()
set(files "${BUILD_LOG}" "${BUILD_COMMANDS}" "${BUILD_DIRECTORY}/compile_commands.json" "${BUILD_DIRECTORY}/CMakeCache.txt" "${TARGET_LINK_MAP}" "${before_path}")
set(keys build_log_sha256 build_commands_sha256 compile_commands_sha256 cmake_cache_sha256 link_map_sha256 inputs_snapshot_sha256)
foreach(path key IN ZIP_LISTS files keys)
    file(SHA256 "${path}" hash)
    string(JSON proof SET "${proof}" "${key}" "\"${hash}\"")
endforeach()
file(SHA256 "${BUILD_LOG}" build_log_hash)
string(JSON proof SET "${proof}" inputs_before "${inputs}")
string(JSON proof SET "${proof}" inputs_after "${inputs}")
awj_sdk_json_get(library_record "${targets_records}" OBJECT awj_sdk)
string(JSON proof SET "${proof}" library "${library_record}")
string(JSON programs REMOVE "${targets_records}" awj_sdk)
string(JSON proof SET "${proof}" test_programs "${programs}")
awj_sdk_hmos_verification(build checks)
string(JSON proof SET "${proof}" verification "${checks}")
awj_sdk_hmos_native_inputs("${proof}" "${work}" "${readobj}" native)
awj_sdk_validate_hmos_cross_proof("${proof}" profile "${version}" "${head}" "${fingerprint}" "${library_hash}"
    "${identity_compiler_version}" "${identity_compiler_hash}" "${targets_records}" "${targets_manifest}"
    "${targets_manifest_hash}" "${inputs}" "${build_log_hash}" "${MODE}")
# 封存前再次核对源码；期间变化即拒绝，绝不改旧来源字段补新证明。
execute_process(COMMAND git -C "${repo}" rev-parse HEAD OUTPUT_VARIABLE final_head
    OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND git -C "${repo}" status --porcelain=v1 OUTPUT_VARIABLE final_status
    OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND bash "${repo}/scripts/release-source-fingerprint.sh" --repository "${repo}"
    OUTPUT_VARIABLE final_fingerprint OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(NOT final_head STREQUAL head OR NOT final_status STREQUAL status OR NOT final_fingerprint STREQUAL fingerprint)
    message(FATAL_ERROR "HMOS 签发/核对期间源码变化")
endif()
if(MODE STREQUAL "formal")
    execute_process(COMMAND git -C "${repo}" describe --exact-match --tags HEAD OUTPUT_VARIABLE final_tag
        OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    if(NOT final_tag STREQUAL version)
        message(FATAL_ERROR "HMOS 签发/核对期间版本 tag 变化")
    endif()
endif()
if(ACTION STREQUAL "record")
    if(EXISTS "${RECORD_DIRECTORY}/hmos-build.json")
        message(FATAL_ERROR "拒绝覆盖已经签发的 HMOS 构建证明")
    endif()
    file(WRITE "${RECORD_DIRECTORY}/hmos-build.json" "${proof}\n")
else()
    assert_under("${work}" "${BUILD_EVIDENCE}")
    if(IS_SYMLINK "${BUILD_EVIDENCE}")
        message(FATAL_ERROR "HMOS 构建附件必须是普通文件")
    endif()
    awj_sdk_read_file("${BUILD_EVIDENCE}" 1048576 reported)
    awj_sdk_hmos_no_execution_claims("${reported}")
    string(JSON reported GET "${reported}")
    if(NOT reported STREQUAL proof)
        message(FATAL_ERROR "HMOS 构建证明与当前真实来源/配置/命令/输入/库/七程序不匹配")
    endif()
endif()
message(STATUS "HMOS ${MODE} 构建证明 ${ACTION} 完成；目标执行和 loader 均为 not-run")
