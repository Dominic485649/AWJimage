function(build_consumers extracted build out)
    # OHOS 仅搜索目标 root；显式绑定本次回解包，避免忽略宿主路径下的 prefix。
    set(arguments -DCMAKE_BUILD_TYPE=Release "-DCMAKE_PREFIX_PATH=${extracted}"
        "-DAWJimage_DIR=${extracted}/lib/cmake/AWJimage"
        -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF
        "-DAWJ_CONSUMER_SOURCE_DIRECTORY=${extracted}/share/AWJimage/examples/basic"
        "-DAWJ_HMOS_PROFILE=${profile_hmos}")
    if(profile_legacy)
        list(APPEND arguments -DAWJ_MODERN_PROFILE=OFF)
    else()
        list(APPEND arguments -DAWJ_MODERN_PROFILE=ON)
    endif()
    if(profile_hmos)
        awj_sdk_find_llvm_tool(consumer_c clang "${profile_major}")
        list(APPEND arguments "-DCMAKE_TOOLCHAIN_FILE=${TARGET_CMAKE_TOOLCHAIN_FILE}"
            "-DCMAKE_C_COMPILER=${consumer_c}" "-DCMAKE_CXX_COMPILER=${identity_compiler}"
            -DCMAKE_SKIP_RPATH=ON "-DAWJ_TRUSTED_CLANG=${identity_compiler}"
            "-DAWJ_CLANG_VERSION=${identity_compiler_version}" "-DAWJ_NATIVE_SDK_DIRECTORY=${native_native}"
            "-DAWJ_HMOS_COMPILER_TARGET_PATTERN=${AWJ_SDK_HMOS_COMPILER_TARGET_PATTERN}")
    elseif(profile_platform STREQUAL "windows-x64")
        if(profile_family STREQUAL "MSVC")
            list(APPEND arguments "-DCMAKE_C_COMPILER=${identity_compiler}" "-DCMAKE_CXX_COMPILER=${identity_compiler}")
        else()
            list(APPEND arguments -DCMAKE_C_COMPILER=cl -DCMAKE_CXX_COMPILER=cl)
        endif()
    else()
        find_program(consumer_c NAMES gcc REQUIRED)
        find_program(consumer_cxx NAMES g++ REQUIRED)
        list(APPEND arguments "-DCMAKE_C_COMPILER=${consumer_c}" "-DCMAKE_CXX_COMPILER=${consumer_cxx}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${output}/consumer-project" -B "${build}" -G Ninja
        ${arguments} COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" --parallel 2 COMMAND_ERROR_IS_FATAL ANY)
    awj_sdk_read_file("${build}/consumer-paths.json" 65536 paths)
    set(records "{}")
    set(consumer_names installed_c_consumer installed_cxx_consumer)
    if(NOT profile_legacy)
        list(APPEND consumer_names installed_cxx17_consumer)
    endif()
    foreach(consumer IN LISTS consumer_names)
        awj_sdk_json_get(path "${paths}" STRING "${consumer}" path)
        assert_under("${build}" "${path}")
        if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}" OR IS_SYMLINK "${path}")
            message(FATAL_ERROR "回解 SDK 未生成真实安装消费者：${consumer}")
        endif()
        file(SHA256 "${path}" hash)
        awj_sdk_json_get(standard "${paths}" STRING "${consumer}" standard)
        string(JSON records SET "${records}" "${consumer}" "{\"sha256\":\"${hash}\",\"standard\":\"${standard}\"}")
        if(profile_hmos)
            awj_sdk_check_binary("${path}" profile "${readobj}" "${build}/${consumer}-identity.txt" consumer)
        endif()
    endforeach()
    if(NOT profile_hmos)
        get_filename_component(cmake_bin "${CMAKE_COMMAND}" DIRECTORY)
        find_program(ctest NAMES ctest HINTS "${cmake_bin}" REQUIRED)
        execute_process(COMMAND "${ctest}" --test-dir "${build}" --output-on-failure
            --output-junit "${build}/consumers.xml" COMMAND_ERROR_IS_FATAL ANY)
        awj_sdk_validate_junit("${build}/consumers.xml" "${consumer_names}")
        file(SHA256 "${build}/consumers.xml" hash)
        set(${out}_consumer_hash "${hash}" PARENT_SCOPE)
    endif()
    set(${out}_records "${records}" PARENT_SCOPE)
    set(${out}_paths "${paths}" PARENT_SCOPE)
endfunction()

write_build_record("")
archive_roundtrip("${output}/roundtrip")
set(extracted "${output}/roundtrip")
verify_exports("${extracted}")
if(NOT profile_hmos)
    if(profile_platform STREQUAL "windows-x64")
        execute_process(COMMAND "${extracted}/${stream}" --help COMMAND_ERROR_IS_FATAL ANY)
    else()
        execute_process(COMMAND test -x "${extracted}/${stream}" COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=LD_LIBRARY_PATH
            "${extracted}/${stream}" --help COMMAND_ERROR_IS_FATAL ANY)
    endif()
endif()
build_consumers("${extracted}" "${output}/consumers" initial)
if(profile_hmos)
    if(TARGET_RUNNER)
        file(MAKE_DIRECTORY "${output}/target-run")
        # The hook receives data paths, never commands from evidence. It must run
        # the supplied exact binaries on the target and write the bound report
        # and its JUnit/raw-log attachments. This script never chooses a device.
        file(READ "${package}/SDK-BUILD.json" request)
        string(JSON request SET "${request}" schema 1)
        string(JSON request SET "${request}" kind "\"target-execution-request\"")
        string(JSON request SET "${request}" mode "\"formal\"")
        foreach(field IN ITEMS library_path sdk_test_report_path)
            if(field STREQUAL "library_path")
                set(value "${extracted}/${library}")
            else()
                set(value "${TEST_REPORT}")
            endif()
            awj_sdk_json_quote(value "${value}")
            string(JSON request SET "${request}" "${field}" "${value}")
        endforeach()
        string(JSON request SET "${request}" consumers "${initial_records}")
        string(JSON request SET "${request}" consumer_paths "${initial_paths}")
        file(WRITE "${output}/target-run/request.json" "${request}\n")
        set(TARGET_EXECUTION_EVIDENCE "${output}/target-run/evidence.json")
        execute_process(COMMAND "${TARGET_RUNNER}" --request "${output}/target-run/request.json"
            --evidence "${TARGET_EXECUTION_EVIDENCE}" RESULT_VARIABLE runner_result TIMEOUT 1800
            OUTPUT_FILE "${output}/target-run/runner.stdout.log" ERROR_FILE "${output}/target-run/runner.stderr.log")
        if(NOT runner_result EQUAL 0)
            message(FATAL_ERROR "显式 HMOS TARGET_RUNNER 执行失败")
        endif()
    endif()
    awj_sdk_verify_target_execution("${TARGET_EXECUTION_EVIDENCE}" "${work}" profile "${version}" "${head}"
        "${fingerprint}" "${library_hash}" "${test_hash}" "${initial_records}" target)
    # Seal the target report hash in SDK-BUILD, then validate the FINAL archive,
    # including a second real compile. Never rewrite a prior target report to
    # accommodate changed paths/RPATH/timestamps or changed consumer bytes.
    write_build_record("${target_report_hash}")
    archive_roundtrip("${output}/roundtrip-final")
    set(extracted "${output}/roundtrip-final")
    verify_exports("${extracted}")
    build_consumers("${extracted}" "${output}/consumers-final" final)
    if(NOT "${initial_records}" STREQUAL "${final_records}")
        message(FATAL_ERROR "HMOS 最终归档回解消费者字节变化；不能复用先前目标执行证据")
    endif()
    awj_sdk_verify_target_execution("${TARGET_EXECUTION_EVIDENCE}" "${work}" profile "${version}" "${head}"
        "${fingerprint}" "${library_hash}" "${test_hash}" "${final_records}" final_target)
    if(NOT final_target_report_hash STREQUAL target_report_hash OR NOT final_target_consumer_hash STREQUAL target_consumer_hash)
        message(FATAL_ERROR "HMOS 目标执行证据在封存期间变化")
    endif()
    set(consumer_hash "${target_consumer_hash}")
else()
    set(consumer_hash "${initial_consumer_hash}")
endif()
file(SHA256 "${output}/${name}" archive_hash)
file(SIZE "${output}/${name}" archive_size)
file(SHA256 "${BUILD_EVIDENCE}" final_proof_hash)
file(SHA256 "${TEST_REPORT}" final_test_hash)
file(SHA256 "${identity_compiler}" final_compiler_hash)
file(SHA256 "${INSTALL_DIRECTORY}/${library}" final_library_hash)
file(SHA256 "${extracted}/${library}" final_extracted_library_hash)
if(NOT final_extracted_library_hash STREQUAL library_hash)
    message(FATAL_ERROR "SDK 最终归档库与实际编译/TestReport 绑定不一致")
endif()
if(NOT final_proof_hash STREQUAL proof_hash OR NOT final_test_hash STREQUAL test_hash OR
    NOT final_compiler_hash STREQUAL identity_compiler_hash OR NOT final_library_hash STREQUAL library_hash)
    message(FATAL_ERROR "SDK 构建输入/真实编译器/库/报告在打包期间变化")
endif()
if(profile_hmos)
    awj_sdk_hmos_native_inputs("${proof}" "${work}" "${readobj}" final_native)
endif()
git_read(final_head rev-parse HEAD)
git_read(final_status status --porcelain=v1)
git_read(final_tag describe --exact-match --tags HEAD)
source_fingerprint(final_fingerprint)
if(NOT final_head STREQUAL head OR NOT final_status STREQUAL "" OR NOT final_fingerprint STREQUAL fingerprint OR NOT final_tag STREQUAL version)
    message(FATAL_ERROR "SDK 打包期间源码发生变化")
endif()
file(READ "${package}/SDK-BUILD.json" receipt)
string(JSON receipt SET "${receipt}" schema 1)
string(JSON receipt SET "${receipt}" kind "\"sdk\"")
string(JSON receipt SET "${receipt}" mode "\"formal\"")
string(JSON receipt SET "${receipt}" status "\"passed\"")
string(JSON receipt SET "${receipt}" source_dirty false)
string(JSON receipt SET "${receipt}" archive "{\"name\":\"${name}\",\"size\":${archive_size},\"sha256\":\"${archive_hash}\"}")
set(verification "{\"sdk_tests\":\"passed\",\"installed_consumers\":\"passed\",\"exports\":\"passed\",\"archive_roundtrip\":\"passed\",\"compiler_identity\":\"passed\",\"target_identity\":\"passed\"}")
if(profile_family STREQUAL "MSVC")
    string(JSON verification SET "${verification}" msvc_release_optimization "\"passed\"")
endif()
if(profile_hmos)
    string(JSON verification SET "${verification}" target_execution "\"passed\"")
    string(JSON verification SET "${verification}" target_loader "\"passed\"")
else()
    string(JSON verification SET "${verification}" relocated_stream "\"passed\"")
endif()
string(JSON receipt SET "${receipt}" verification "${verification}")
string(JSON receipt SET "${receipt}" consumer_report_sha256 "\"${consumer_hash}\"")
file(WRITE "${output}/asset-evidence.json" "${receipt}\n")
message(STATUS "SDK 正式资产已完成 ${profile_profile} 身份、目标执行、导出、消费者和归档往返门禁：${name}")
