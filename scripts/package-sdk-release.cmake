function(write_build_record execution_hash)
    set(record "{}")
    foreach(field IN ITEMS version platform git_head source_fingerprint profile compiler_version target_triple compiler_banner compiler_sha256)
        if(field STREQUAL "git_head")
            set(value "${head}")
        elseif(field STREQUAL "source_fingerprint")
            set(value "${fingerprint}")
        elseif(field STREQUAL "profile")
            set(value "${profile_profile}")
        elseif(field STREQUAL "compiler_version")
            set(value "${identity_compiler_version}")
        elseif(field STREQUAL "target_triple")
            set(value "${profile_triple}")
        elseif(field STREQUAL "compiler_banner")
            set(value "${identity_banner}")
        elseif(field STREQUAL "compiler_sha256")
            set(value "${identity_compiler_hash}")
        else()
            set(value "${${field}}")
        endif()
        awj_sdk_json_quote(quoted "${value}")
        string(JSON record SET "${record}" "${field}" "${quoted}")
    endforeach()
    string(JSON record SET "${record}" abi 1)
    string(JSON record SET "${record}" linkage "\"shared\"")
    string(JSON record SET "${record}" compiler "\"${profile_family} ${identity_compiler_version}\"")
    string(JSON record SET "${record}" compiler_id "\"${profile_family}\"")
    if(profile_family STREQUAL "MSVC")
        string(JSON toolchain GET "${proof}" toolchain)
        string(JSON record SET "${record}" toolchain "${toolchain}")
    endif()
    string(JSON record SET "${record}" source_fingerprint_algorithm "\"sha256/git-normalized-source-v1\"")
    string(JSON record SET "${record}" library_sha256 "\"${library_hash}\"")
    string(JSON record SET "${record}" build_evidence_sha256 "\"${proof_hash}\"")
    string(JSON record SET "${record}" test_report_sha256 "\"${test_hash}\"")
    if(profile_hmos)
        foreach(field IN ITEMS native_sdk_version api libcxx_version libcxx_abi_version libcxx_abi_namespace runtime_linkage
            toolchain_sha256 libcxx_config_sha256 libcxx_config_site_sha256 libcxx_static_sha256 libunwind_sha256 link_map_sha256)
            string(JSON value GET "${proof}" "${field}")
            string(JSON type TYPE "${proof}" "${field}")
            if(type STREQUAL "STRING")
                awj_sdk_json_quote(value "${value}")
            endif()
            string(JSON record SET "${record}" "${field}" "${value}")
        endforeach()
        if(NOT execution_hash STREQUAL "")
            string(JSON record SET "${record}" target_execution_report_sha256 "\"${execution_hash}\"")
        endif()
    endif()
    file(WRITE "${package}/SDK-BUILD.json" "${record}\n")
endfunction()

# Reused for HMOS's candidate and sealed archives. SHA256SUMS never hashes itself.
function(archive_roundtrip destination)
    check_tree("${package}")
    file(GLOB_RECURSE entries LIST_DIRECTORIES false RELATIVE "${package}" "${package}/*")
    list(SORT entries)
    set(hashes "")
    foreach(relative IN LISTS entries)
        if(relative STREQUAL "SHA256SUMS")
            continue()
        endif()
        file(SHA256 "${package}/${relative}" hash)
        string(APPEND hashes "${hash}  ${relative}\n")
    endforeach()
    file(WRITE "${package}/SHA256SUMS" "${hashes}")
    if(profile_platform STREQUAL "windows-x64")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${output}/${name}" --format=zip -- .
            WORKING_DIRECTORY "${package}" COMMAND_ERROR_IS_FATAL ANY)
    else()
        execute_process(COMMAND "${CMAKE_COMMAND}" -E tar czf "${output}/${name}" --format=gnutar -- .
            WORKING_DIRECTORY "${package}" COMMAND_ERROR_IS_FATAL ANY)
    endif()
    file(MAKE_DIRECTORY "${destination}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${output}/${name}"
        WORKING_DIRECTORY "${destination}" COMMAND_ERROR_IS_FATAL ANY)
    awj_sdk_check_install("${destination}" profile)
    check_installed_sources("${destination}")
    file(GLOB_RECURSE expected_entries LIST_DIRECTORIES true RELATIVE "${package}" "${package}/*")
    file(GLOB_RECURSE actual_entries LIST_DIRECTORIES true RELATIVE "${destination}" "${destination}/*")
    list(SORT expected_entries)
    list(SORT actual_entries)
    if(NOT "${expected_entries}" STREQUAL "${actual_entries}")
        message(FATAL_ERROR "SDK 归档往返成员不一致")
    endif()
    foreach(relative IN LISTS expected_entries)
        if(IS_SYMLINK "${package}/${relative}")
            file(READ_SYMLINK "${package}/${relative}" expected_target)
            if(NOT IS_SYMLINK "${destination}/${relative}")
                message(FATAL_ERROR "SDK 归档丢失符号链接：${relative}")
            endif()
            file(READ_SYMLINK "${destination}/${relative}" actual_target)
            if(NOT actual_target STREQUAL expected_target)
                message(FATAL_ERROR "SDK 归档改变符号链接：${relative}")
            endif()
        elseif(IS_SYMLINK "${destination}/${relative}")
            message(FATAL_ERROR "SDK 归档意外增加符号链接：${relative}")
        elseif(IS_DIRECTORY "${package}/${relative}")
            if(NOT IS_DIRECTORY "${destination}/${relative}")
                message(FATAL_ERROR "SDK 归档改变目录类型：${relative}")
            endif()
        else()
            file(SHA256 "${package}/${relative}" expected_hash)
            file(SHA256 "${destination}/${relative}" actual_hash)
            if(NOT actual_hash STREQUAL expected_hash)
                message(FATAL_ERROR "SDK 归档往返内容不一致：${relative}")
            endif()
        endif()
    endforeach()
endfunction()

function(verify_exports extracted)
    if(profile_platform STREQUAL "windows-x64")
        find_program(pwsh NAMES pwsh REQUIRED)
        execute_process(COMMAND "${pwsh}" -NoProfile -File "${repo}/scripts/verify-sdk-exports.ps1"
            -Library "${extracted}/${library}" -IncludeDirectory "${extracted}/include" -ReadObject "${readobj}"
            COMMAND_ERROR_IS_FATAL ANY)
    else()
        execute_process(COMMAND "${CMAKE_COMMAND}" "-DLIBRARY=${extracted}/${library}"
            "-DINCLUDE_DIRECTORY=${extracted}/include" "-DNM=${nm}" -P "${repo}/scripts/verify-sdk-exports.cmake"
            COMMAND_ERROR_IS_FATAL ANY)
    endif()
endfunction()

