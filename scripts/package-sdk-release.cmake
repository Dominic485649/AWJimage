# Fingerprinting is a HOST operation; it is independent of the target profile.
function(source_fingerprint out)
    if(CMAKE_HOST_WIN32)
        find_program(pwsh NAMES pwsh REQUIRED)
        string(REPLACE "'" "''" quoted_repo "${repo}")
        execute_process(COMMAND "${pwsh}" -NoProfile -Command
            "Import-Module '${quoted_repo}/scripts/release-safety.psm1' -Force -DisableNameChecking; Get-AwjSourceFingerprint -RepositoryRoot '${quoted_repo}'"
            RESULT_VARIABLE result OUTPUT_VARIABLE fingerprint OUTPUT_STRIP_TRAILING_WHITESPACE)
    else()
        execute_process(COMMAND bash "${repo}/scripts/release-source-fingerprint.sh" --repository "${repo}"
            RESULT_VARIABLE result OUTPUT_VARIABLE fingerprint OUTPUT_STRIP_TRAILING_WHITESPACE)
    endif()
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "源码指纹命令失败")
    endif()
    awj_sdk_require_hash("${fingerprint}" source_fingerprint)
    set(${out} "${fingerprint}" PARENT_SCOPE)
endfunction()
source_fingerprint(fingerprint)
awj_sdk_compiler_identity(profile identity)
awj_sdk_find_llvm_tool(readobj llvm-readobj "${profile_llvm_major}")
awj_sdk_find_llvm_tool(nm llvm-nm "${profile_llvm_major}")
