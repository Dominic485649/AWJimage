cmake_minimum_required(VERSION 3.30)
get_filename_component(repo "${CMAKE_CURRENT_LIST_DIR}/.." REALPATH)
foreach(required IN ITEMS WORK_ROOT INSTALL_DIRECTORY OUTPUT_DIRECTORY BUILD_EVIDENCE TEST_REPORT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "缺少 ${required}")
    endif()
endforeach()
file(REAL_PATH "${WORK_ROOT}" work)
if(NOT work STREQUAL repo AND NOT "${work}/src" STREQUAL repo)
    message(FATAL_ERROR "工作根必须属于当前项目")
endif()

function(assert_under base path)
    file(REAL_PATH "${base}" base_real)
    file(REAL_PATH "${path}" path_real)
    cmake_path(IS_PREFIX base_real "${path_real}" NORMALIZE inside)
    if(NOT inside OR path_real STREQUAL base_real)
        message(FATAL_ERROR "路径越过项目工作范围：${path}")
    endif()
endfunction()
if(NOT IS_DIRECTORY "${INSTALL_DIRECTORY}" OR NOT EXISTS "${BUILD_EVIDENCE}" OR NOT EXISTS "${TEST_REPORT}")
    message(FATAL_ERROR "缺少安装目录、构建来源或测试记录")
endif()
foreach(path IN ITEMS "${INSTALL_DIRECTORY}" "${BUILD_EVIDENCE}" "${TEST_REPORT}")
    assert_under("${work}" "${path}")
endforeach()
get_filename_component(output_parent "${OUTPUT_DIRECTORY}" DIRECTORY)
get_filename_component(output_name "${OUTPUT_DIRECTORY}" NAME)
if(NOT IS_DIRECTORY "${output_parent}")
    message(FATAL_ERROR "SDK 输出的项目父目录必须已存在")
endif()
file(REAL_PATH "${output_parent}" output_parent)
cmake_path(SET output NORMALIZE "${output_parent}/${output_name}")
cmake_path(IS_PREFIX work "${output}" NORMALIZE output_inside)
if(NOT output_inside OR output STREQUAL work OR EXISTS "${output}")
    message(FATAL_ERROR "SDK 正式输出目录必须位于项目内且全新")
endif()

function(git_read out)
    execute_process(COMMAND git -C "${repo}" ${ARGN} RESULT_VARIABLE result
        OUTPUT_VARIABLE text ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Git 检查失败：${error}")
    endif()
    set(${out} "${text}" PARENT_SCOPE)
endfunction()
file(READ "${repo}/VERSION" version)
string(STRIP "${version}" version)
git_read(head rev-parse HEAD)
git_read(status status --porcelain=v1)
if(NOT status STREQUAL "")
    message(FATAL_ERROR "SDK 正式打包要求干净源码和匹配 VERSION 的 tag")
endif()
git_read(tag describe --exact-match --tags HEAD)
if(NOT tag STREQUAL version)
    message(FATAL_ERROR "SDK 正式打包要求干净源码和匹配 VERSION 的 tag")
endif()
if(CMAKE_HOST_WIN32)
    set(platform windows-x64)
    set(name AWJ_SDK_Win_x64.zip)
    set(library "bin/awj_sdk.dll")
    set(stream "bin/awj-stream.exe")
    find_program(pwsh NAMES pwsh REQUIRED)
    string(REPLACE "'" "''" quoted_repo "${repo}")
    execute_process(COMMAND "${pwsh}" -NoProfile -Command
        "Import-Module '${quoted_repo}/scripts/release-safety.psm1' -Force -DisableNameChecking; Get-AwjSourceFingerprint -RepositoryRoot '${quoted_repo}'"
        RESULT_VARIABLE fingerprint_result OUTPUT_VARIABLE fingerprint OUTPUT_STRIP_TRAILING_WHITESPACE)
else()
    if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
        message(FATAL_ERROR "SDK 正式包仅支持 Windows/Linux 原生环境")
    endif()
    set(platform linux-x64)
    set(name AWJ_SDK_Linux_x64.tar.gz)
    set(library "lib/libawj_sdk.so.${version}")
    set(stream "bin/awj-stream")
    execute_process(COMMAND bash "${repo}/scripts/release-source-fingerprint.sh" --repository "${repo}"
        RESULT_VARIABLE fingerprint_result OUTPUT_VARIABLE fingerprint OUTPUT_STRIP_TRAILING_WHITESPACE)
endif()
string(LENGTH "${fingerprint}" fingerprint_length)
if(NOT fingerprint_result EQUAL 0 OR NOT fingerprint_length EQUAL 64 OR NOT fingerprint MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "源码指纹无效")
endif()
file(READ "${BUILD_EVIDENCE}" proof)
string(JSON proof_schema GET "${proof}" schema)
string(JSON proof_schema_type TYPE "${proof}" schema)
if(NOT proof_schema_type STREQUAL "NUMBER" OR NOT proof_schema EQUAL 1)
    message(FATAL_ERROR "SDK 构建记录 schema 无效")
endif()
foreach(field IN ITEMS mode platform version git_head source_fingerprint)
    string(JSON type TYPE "${proof}" ${field})
    string(JSON value GET "${proof}" ${field})
    if(field STREQUAL "mode")
        set(expected formal)
    elseif(field STREQUAL "git_head")
        set(expected "${head}")
    elseif(field STREQUAL "source_fingerprint")
        set(expected "${fingerprint}")
    else()
        set(expected "${${field}}")
    endif()
    if(NOT type STREQUAL "STRING" OR NOT value STREQUAL expected)
        message(FATAL_ERROR "SDK 构建记录不匹配：${field}")
    endif()
endforeach()
foreach(field IN ITEMS source_dirty native_codecs compiled_source_verified)
    string(JSON type TYPE "${proof}" ${field})
    string(JSON value GET "${proof}" ${field})
    if(NOT type STREQUAL "BOOLEAN" OR (field STREQUAL "source_dirty" AND value)
        OR (NOT field STREQUAL "source_dirty" AND NOT value))
        message(FATAL_ERROR "SDK 构建状态无效：${field}")
    endif()
endforeach()
string(JSON compiler_version GET "${proof}" compiler_version)
if(NOT compiler_version MATCHES "^21\\.[0-9]+\\.[0-9]+$")
    message(FATAL_ERROR "本次 SDK 发布使用已验证的 Clang 21 工具链")
endif()
foreach(required IN ITEMS "${library}" "${stream}" "include/awj/awj.h" "include/awj/awj_shm.h"
    "include/awj/awj_ffmpeg.h" "lib/cmake/AWJimage/AWJimageConfig.cmake"
    "share/AWJimage/LICENSE" "share/AWJimage/THIRD_PARTY_NOTICES.txt"
    "share/AWJimage/sdk.md" "share/AWJimage/examples/basic/CMakeLists.txt")
    if(NOT EXISTS "${INSTALL_DIRECTORY}/${required}")
        message(FATAL_ERROR "完整 SDK 安装缺少 ${required}")
    endif()
endforeach()
if(CMAKE_HOST_WIN32 AND NOT EXISTS "${INSTALL_DIRECTORY}/include/awj/awj_d3d11.h")
    message(FATAL_ERROR "Windows SDK 缺少 D3D11 公共头")
endif()
file(SHA256 "${INSTALL_DIRECTORY}/${library}" library_hash)
string(JSON expected_library_hash GET "${proof}" library_sha256)
if(NOT library_hash STREQUAL expected_library_hash)
    message(FATAL_ERROR "安装库与实际编译记录不匹配")
endif()
file(SHA256 "${TEST_REPORT}" test_hash)
string(JSON expected_test_hash GET "${proof}" test_report_sha256)
if(NOT test_hash STREQUAL expected_test_hash)
    message(FATAL_ERROR "SDK 测试记录已变化")
endif()
file(READ "${TEST_REPORT}" xml)
string(REGEX MATCH "<testsuite[ \t\r\n][^>]*>" suite "${xml}")
foreach(field IN ITEMS tests failures disabled skipped)
    string(REGEX MATCH "${field}=\"([0-9]+)\"" match "${suite}")
    if(NOT match)
        message(FATAL_ERROR "SDK JUnit 缺少 ${field}")
    endif()
    set(${field} "${CMAKE_MATCH_1}")
endforeach()
if(tests LESS 2 OR NOT failures EQUAL 0 OR NOT disabled EQUAL 0 OR NOT skipped EQUAL 0)
    message(FATAL_ERROR "SDK 测试存在失败、禁用或跳过")
endif()

function(check_tree directory)
    file(GLOB_RECURSE entries LIST_DIRECTORIES true RELATIVE "${directory}" "${directory}/*")
    list(LENGTH entries count)
    if(count GREATER 4096)
        message(FATAL_ERROR "SDK 安装树包含过多成员")
    endif()
    foreach(relative IN LISTS entries)
        string(TOLOWER "${relative}" lower)
        if(lower MATCHES "(^|/)(release-signing\\.local\\.json|[^/]*(secret|seed|private[-_]?key)[^/]*)$"
            OR lower MATCHES "\\.(pem|pfx|key|seed|pcm|pch|pdb)$"
            OR lower MATCHES "(^|/)(avutil[^/]*\\.dll|libavutil[^/]*\\.so[^/]*|[^/]*\\.a)$")
            message(FATAL_ERROR "SDK 出现非分发成员：${relative}")
        endif()
        if(IS_SYMLINK "${directory}/${relative}")
            assert_under("${directory}" "${directory}/${relative}")
            if(IS_DIRECTORY "${directory}/${relative}" OR NOT EXISTS "${directory}/${relative}")
                message(FATAL_ERROR "SDK 符号链接无效：${relative}")
            endif()
        endif()
    endforeach()
endfunction()
check_tree("${INSTALL_DIRECTORY}")
file(MAKE_DIRECTORY "${output}/package" "${output}/roundtrip")
set(package "${output}/package")
file(COPY "${INSTALL_DIRECTORY}/" DESTINATION "${package}")
file(WRITE "${package}/SDK-BUILD.json"
    "{\n  \"version\":\"${version}\",\n  \"platform\":\"${platform}\",\n  \"abi\":1,\n  \"linkage\":\"shared\",\n  \"git_head\":\"${head}\",\n  \"source_fingerprint_algorithm\":\"sha256/git-normalized-source-v1\",\n  \"source_fingerprint\":\"${fingerprint}\",\n  \"compiler\":\"Clang ${compiler_version}\"\n}\n")
file(GLOB_RECURSE entries LIST_DIRECTORIES false RELATIVE "${package}" "${package}/*")
list(SORT entries)
set(hashes "")
foreach(relative IN LISTS entries)
    file(SHA256 "${package}/${relative}" hash)
    string(APPEND hashes "${hash}  ${relative}\n")
endforeach()
file(WRITE "${package}/SHA256SUMS" "${hashes}")
set(archive "${output}/${name}")
if(CMAKE_HOST_WIN32)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${archive}" --format=zip -- .
        WORKING_DIRECTORY "${package}" COMMAND_ERROR_IS_FATAL ANY)
else()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar czf "${archive}" --format=gnutar -- .
        WORKING_DIRECTORY "${package}" COMMAND_ERROR_IS_FATAL ANY)
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${archive}"
    WORKING_DIRECTORY "${output}/roundtrip" COMMAND_ERROR_IS_FATAL ANY)
set(extracted "${output}/roundtrip")
check_tree("${extracted}")
file(GLOB_RECURSE expected_entries LIST_DIRECTORIES true RELATIVE "${package}" "${package}/*")
file(GLOB_RECURSE actual_entries LIST_DIRECTORIES true RELATIVE "${extracted}" "${extracted}/*")
list(SORT expected_entries)
list(SORT actual_entries)
if(NOT "${expected_entries}" STREQUAL "${actual_entries}")
    message(FATAL_ERROR "SDK 归档往返成员不一致")
endif()
foreach(relative IN LISTS expected_entries)
    if(IS_SYMLINK "${package}/${relative}")
        file(READ_SYMLINK "${package}/${relative}" expected_target)
        if(NOT IS_SYMLINK "${extracted}/${relative}")
            message(FATAL_ERROR "SDK 归档丢失符号链接：${relative}")
        endif()
        file(READ_SYMLINK "${extracted}/${relative}" actual_target)
        if(NOT actual_target STREQUAL expected_target)
            message(FATAL_ERROR "SDK 归档改变符号链接：${relative}")
        endif()
    elseif(NOT IS_DIRECTORY "${package}/${relative}")
        file(SHA256 "${package}/${relative}" expected_hash)
        file(SHA256 "${extracted}/${relative}" actual_hash)
        if(NOT actual_hash STREQUAL expected_hash)
            message(FATAL_ERROR "SDK 归档往返内容不一致：${relative}")
        endif()
    endif()
endforeach()
if(CMAKE_HOST_WIN32)
    find_program(readobj NAMES llvm-readobj HINTS "${LLVM_DIRECTORY}" REQUIRED)
    execute_process(COMMAND "${pwsh}" -NoProfile -File "${repo}/scripts/verify-sdk-exports.ps1"
        -Library "${extracted}/${library}" -IncludeDirectory "${extracted}/include" -ReadObject "${readobj}"
        COMMAND_ERROR_IS_FATAL ANY)
    set(consumer_c cl)
    set(consumer_cxx cl)
    execute_process(COMMAND "${extracted}/${stream}" --help COMMAND_ERROR_IS_FATAL ANY)
else()
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DLIBRARY=${extracted}/${library}"
        "-DINCLUDE_DIRECTORY=${extracted}/include" -P "${repo}/scripts/verify-sdk-exports.cmake"
        COMMAND_ERROR_IS_FATAL ANY)
    find_program(consumer_c NAMES gcc REQUIRED)
    find_program(consumer_cxx NAMES g++ REQUIRED)
    execute_process(COMMAND test -x "${extracted}/${stream}" COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=LD_LIBRARY_PATH
        "${extracted}/${stream}" --help COMMAND_ERROR_IS_FATAL ANY)
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${extracted}/share/AWJimage/examples/basic"
    -B "${output}/consumers" -G Ninja -DCMAKE_BUILD_TYPE=Release "-DCMAKE_PREFIX_PATH=${extracted}"
    "-DCMAKE_C_COMPILER=${consumer_c}" "-DCMAKE_CXX_COMPILER=${consumer_cxx}"
    COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${output}/consumers" --parallel 2 COMMAND_ERROR_IS_FATAL ANY)
get_filename_component(cmake_bin "${CMAKE_COMMAND}" DIRECTORY)
find_program(ctest NAMES ctest HINTS "${cmake_bin}" REQUIRED)
execute_process(COMMAND "${ctest}" --test-dir "${output}/consumers" --output-on-failure
    --output-junit "${output}/consumers.xml" COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${output}/consumers.xml" consumer_hash)
file(SHA256 "${archive}" archive_hash)
file(SIZE "${archive}" archive_size)
git_read(final_head rev-parse HEAD)
git_read(final_status status --porcelain=v1)
if(NOT final_head STREQUAL head OR NOT final_status STREQUAL "")
    message(FATAL_ERROR "SDK 打包期间源码发生变化")
endif()
file(WRITE "${output}/asset-evidence.json"
    "{\n  \"schema\":1,\n  \"kind\":\"sdk\",\n  \"mode\":\"formal\",\n  \"status\":\"passed\",\n  \"version\":\"${version}\",\n  \"platform\":\"${platform}\",\n  \"git_head\":\"${head}\",\n  \"source_dirty\":false,\n  \"source_fingerprint\":\"${fingerprint}\",\n  \"archive\":{\"name\":\"${name}\",\"size\":${archive_size},\"sha256\":\"${archive_hash}\"},\n  \"verification\":{\"sdk_tests\":\"passed\",\"installed_consumers\":\"passed\",\"exports\":\"passed\",\"archive_roundtrip\":\"passed\",\"relocated_stream\":\"passed\"},\n  \"test_report_sha256\":\"${test_hash}\",\n  \"consumer_report_sha256\":\"${consumer_hash}\"\n}\n")
message(STATUS "SDK 正式资产已完成原生安装、导出、迁移执行与归档往返验证：${name}")
