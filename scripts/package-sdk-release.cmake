    foreach(required IN ITEMS BUILD_DIRECTORY RECORD_DIRECTORY DEPENDENCY_DIRECTORY VCPKG_ROOT BUILD_LOG BUILD_COMMANDS
        CROSS_TEST_BINARY_DIRECTORY TARGET_CMAKE_TOOLCHAIN_FILE TARGET_NATIVE_SDK_DIRECTORY TARGET_RESOURCE_DIRECTORY TARGET_LINK_MAP LLVM_DIRECTORY)
        if(NOT IS_ABSOLUTE "${${required}}" OR NOT EXISTS "${${required}}")
            message(FATAL_ERROR "HMOS 正式交叉构建缺少可信绝对 CLI 输入：${required}")
        endif()
        file(REAL_PATH "${${required}}" "${required}")
    endforeach()
    foreach(path IN ITEMS "${BUILD_DIRECTORY}" "${RECORD_DIRECTORY}" "${DEPENDENCY_DIRECTORY}"
        "${BUILD_LOG}" "${BUILD_COMMANDS}" "${CROSS_TEST_BINARY_DIRECTORY}")
        assert_under("${work}" "${path}")
    endforeach()
    if(NOT DEFINED TARGET_MANIFEST)
        set(TARGET_MANIFEST "${BUILD_DIRECTORY}/awj-hmos-targets-Release.json")
    endif()
    # 生成的消费者脚本和 LLD 依赖规则使用原生绝对路径，拒绝歧义字符。
    foreach(path IN ITEMS "${work}" "${repo}" "${output}" "${INSTALL_DIRECTORY}" "${BUILD_DIRECTORY}"
        "${RECORD_DIRECTORY}" "${TARGET_NATIVE_SDK_DIRECTORY}" "${TARGET_RESOURCE_DIRECTORY}" "${LLVM_DIRECTORY}")
        if(NOT path MATCHES "^/[A-Za-z0-9_./+-]+$")
            message(FATAL_ERROR "HMOS 打包必须使用无歧义原生绝对路径：${path}")
        endif()
    endforeach()
    if(NOT TARGET_LINK_MAP STREQUAL "${RECORD_DIRECTORY}/awj-sdk.map")
        message(FATAL_ERROR "HMOS link map 必须是本轮构建采集的实际输入")
    endif()
    awj_sdk_hmos_reject_output_overlap("${output}" "${repo}" "${TARGET_NATIVE_SDK_DIRECTORY}"
        "${LLVM_DIRECTORY}" "${VCPKG_ROOT}" "${TARGET_RESOURCE_DIRECTORY}" "${DEPENDENCY_DIRECTORY}"
        "${BUILD_DIRECTORY}" "${RECORD_DIRECTORY}" "${INSTALL_DIRECTORY}")
