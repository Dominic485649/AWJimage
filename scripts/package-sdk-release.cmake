    assert_under("${work}" "${TEST_REPORT}")
endif()

function(source_fingerprint out)
    if(CMAKE_HOST_WIN32)
        find_program(pwsh NAMES pwsh REQUIRED)
        string(REPLACE "'" "''" quoted_repo "${repo}")
        execute_process(COMMAND "${pwsh}" -NoProfile -Command
            "Import-Module '${quoted_repo}/scripts/release-safety.psm1' -Force -DisableNameChecking; Get-AwjSourceFingerprint -RepositoryRoot '${quoted_repo}'"
            RESULT_VARIABLE result OUTPUT_VARIABLE fingerprint OUTPUT_STRIP_TRAILING_WHITESPACE)
    else()
        execute_process(COMMAND bash "${repo}/scripts/release-source-fingerprint.sh" --repository "${repo}"
            RESULT_VARIABLE result OUTPUT_VARIABLE fingerprint OUTPUT_STRIP_TRAILING_WHITESPACE)
    endif()
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "源码指纹命令失败")
    endif()
    awj_sdk_require_hash("${fingerprint}" source_fingerprint)
    set(${out} "${fingerprint}" PARENT_SCOPE)
endfunction()

# 同一真实 producer 再核对生成配置、真实命令、Native/resource、私有 stamp 与八个映像。
# 验证阶段只写独立审计输出，不刷新 nonce、配置或任何构建输入。
function(verify_cross_build phase)
    execute_process(COMMAND "${CMAKE_COMMAND}" -DACTION=verify -DMODE=formal
        "-DWORK_ROOT=${work}" "-DBUILD_DIRECTORY=${BUILD_DIRECTORY}" "-DRECORD_DIRECTORY=${RECORD_DIRECTORY}"
        "-DDEPENDENCY_DIRECTORY=${DEPENDENCY_DIRECTORY}" "-DVCPKG_ROOT=${VCPKG_ROOT}"
        "-DBUILD_LOG=${BUILD_LOG}" "-DBUILD_COMMANDS=${BUILD_COMMANDS}" "-DBUILD_EVIDENCE=${BUILD_EVIDENCE}"
        "-DINSTALL_DIRECTORY=${INSTALL_DIRECTORY}" "-DTARGET_MANIFEST=${TARGET_MANIFEST}"
        "-DCROSS_TEST_BINARY_DIRECTORY=${CROSS_TEST_BINARY_DIRECTORY}"
        "-DTARGET_CMAKE_TOOLCHAIN_FILE=${TARGET_CMAKE_TOOLCHAIN_FILE}" "-DLLVM_DIRECTORY=${LLVM_DIRECTORY}"
        "-DTARGET_NATIVE_SDK_DIRECTORY=${TARGET_NATIVE_SDK_DIRECTORY}" "-DTARGET_RESOURCE_DIRECTORY=${TARGET_RESOURCE_DIRECTORY}"
        "-DAUDIT_DIRECTORY=${output}/build-audit-${phase}" -P "${repo}/scripts/record-hmos-build.cmake"
        COMMAND_ERROR_IS_FATAL ANY)
endfunction()

