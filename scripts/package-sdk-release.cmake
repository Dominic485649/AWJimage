awj_sdk_validate_junit("${TEST_REPORT}" "${required_tests}")
# Bind whitelist inputs AND the CMake/source code we will actually compile to
# the clean source, rather than executing a stale/substituted installed example.
function(check_installed_sources installed)
    file(GLOB installed_headers "${installed}/include/awj/*")
    foreach(header IN LISTS installed_headers)
        get_filename_component(header_name "${header}" NAME)
        file(SHA256 "${header}" installed_hash)
        file(SHA256 "${repo}/include/awj/${header_name}" source_hash)
        if(NOT installed_hash STREQUAL source_hash)
            message(FATAL_ERROR "安装公共头与本次源码不匹配：${header_name}")
        endif()
    endforeach()
    set(example "${installed}/share/AWJimage/examples/basic")
    file(GLOB_RECURSE expected LIST_DIRECTORIES false RELATIVE "${repo}/examples/basic" "${repo}/examples/basic/*")
    file(GLOB_RECURSE actual LIST_DIRECTORIES false RELATIVE "${example}" "${example}/*")
    list(SORT expected)
    list(SORT actual)
    if(NOT "${expected}" STREQUAL "${actual}")
        message(FATAL_ERROR "安装消费者源码集合与本次源码不匹配")
    endif()
    foreach(relative IN LISTS expected)
        file(SHA256 "${repo}/examples/basic/${relative}" source_hash)
        file(SHA256 "${example}/${relative}" installed_hash)
        if(NOT source_hash STREQUAL installed_hash)
            message(FATAL_ERROR "安装消费者源码与本次源码不匹配：${relative}")
        endif()
    endforeach()
endfunction()
check_installed_sources("${INSTALL_DIRECTORY}")
