git_read(status status --porcelain=v1)
git_read(tag describe --exact-match --tags HEAD)
if(NOT status STREQUAL "" OR NOT tag STREQUAL version)
    message(FATAL_ERROR "发布预览资产同样要求干净源码和精确版本 tag")
endif()
