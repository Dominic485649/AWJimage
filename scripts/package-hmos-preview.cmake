cmake_path(IS_PREFIX installed "${output}" NORMALIZE in_install)
if(NOT inside OR output STREQUAL work OR in_install OR EXISTS "${output}")
    message(FATAL_ERROR "预览输出必须是项目内全新目录，且不在安装树内")
endif()
function(git_read out)
    execute_process(COMMAND git -C "${repo}" ${ARGN} OUTPUT_VARIABLE value
        OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    set(${out} "${value}" PARENT_SCOPE)
endfunction()
function(source_fingerprint out)
    execute_process(COMMAND bash "${repo}/scripts/release-source-fingerprint.sh" --repository "${repo}"
        OUTPUT_VARIABLE value OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    awj_sdk_require_hash("${value}" source_fingerprint)
    set(${out} "${value}" PARENT_SCOPE)
endfunction()
