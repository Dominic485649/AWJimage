project(AWJPreviewConsumers LANGUAGES C CXX)
file(REAL_PATH "${CMAKE_CXX_COMPILER}" actual)
file(REAL_PATH "${AWJ_TRUSTED_CLANG}" expected)
file(REAL_PATH "${CMAKE_SYSROOT}" actual_sysroot)
file(REAL_PATH "${AWJ_NATIVE_SDK_DIRECTORY}/sysroot" expected_sysroot)
if(NOT CMAKE_CROSSCOMPILING OR NOT CMAKE_SYSTEM_NAME STREQUAL "OHOS" OR
        NOT CMAKE_SYSTEM_VERSION VERSION_EQUAL 26 OR NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$" OR
