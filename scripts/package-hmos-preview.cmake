function(build_consumers directory build out)
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${output}/consumer-project" -B "${build}" -G Ninja
        -DCMAKE_BUILD_TYPE=Release "-DCMAKE_TOOLCHAIN_FILE=${TARGET_CMAKE_TOOLCHAIN_FILE}"
        "-DCMAKE_C_COMPILER=${consumer_c}" "-DCMAKE_CXX_COMPILER=${identity_compiler}" -DCMAKE_SKIP_RPATH=ON
        "-DAWJimage_DIR=${directory}/lib/cmake/AWJimage"
        "-DAWJ_CONSUMER_SOURCE_DIRECTORY=${directory}/share/AWJimage/examples/basic"
        "-DAWJ_TRUSTED_CLANG=${identity_compiler}" "-DAWJ_CLANG_VERSION=${identity_compiler_version}"
        "-DAWJ_NATIVE_SDK_DIRECTORY=${native_native}"
        -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF
        COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" --parallel 1 COMMAND_ERROR_IS_FATAL ANY)
    awj_sdk_read_file("${build}/consumer-paths.json" 65536 paths)
    set(records "{}")
    foreach(standard IN ITEMS c99 cxx11 cxx17)
        awj_sdk_json_get(path "${paths}" STRING "${standard}")
        assert_under("${build}" "${path}")
        if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}" OR IS_SYMLINK "${path}")
            message(FATAL_ERROR "缺少真实链接的预览安装消费者")
        endif()
        awj_sdk_check_binary("${path}" profile "${readobj}" "${build}/${standard}-identity.txt" consumer)
        file(SHA256 "${path}" hash)
        string(JSON records SET "${records}" "${standard}" "{\"sha256\":\"${hash}\",\"execution\":\"not-run\"}")
    endforeach()
    set(${out} "${records}" PARENT_SCOPE)
endfunction()
