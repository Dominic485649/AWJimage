        message(FATAL_ERROR "缺少真实最终链接的预览目标程序：${program}")
    endif()
    assert_under("${work}" "${path}")
    file(READ "${path}" magic LIMIT 4 HEX)
    if(NOT magic STREQUAL "7f454c46")
        message(FATAL_ERROR "预览测试程序不是 ELF 映像")
    endif()
    execute_process(COMMAND "${readobj}" --file-headers --needed-libs --dynamic-table "${path}"
        OUTPUT_VARIABLE text COMMAND_ERROR_IS_FATAL ANY)
    awj_sdk_check_hmos_preview_program_text("${text}")
    file(WRITE "${output}/program-identities/${program}.txt" "${text}")
    file(SHA256 "${path}" hash)
    string(JSON programs SET "${programs}" "${program}" "{\"sha256\":\"${hash}\"}")
endforeach()
awj_sdk_validate_hmos_preview_proof("${proof}" profile "${version}" "${head}" "${fingerprint}"
    "${library_hash}" "${identity_compiler_version}" "${identity_compiler_hash}" "${programs}" "${build_log_hash}")
awj_sdk_hmos_native_inputs("${proof}" "${work}" "${readobj}" native)
function(check_sources directory)
    file(SHA256 "${directory}/include/awj/awj.h" actual)
    file(SHA256 "${repo}/include/awj/awj.h" expected)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "预览公共 C 头与本次源码不匹配")
    endif()
    file(GLOB_RECURSE expected_files LIST_DIRECTORIES false RELATIVE "${repo}/examples/basic" "${repo}/examples/basic/*")
    file(GLOB_RECURSE actual_files LIST_DIRECTORIES false RELATIVE "${directory}/share/AWJimage/examples/basic" "${directory}/share/AWJimage/examples/basic/*")
    list(SORT expected_files)
    list(SORT actual_files)
    if(NOT expected_files STREQUAL actual_files)
        message(FATAL_ERROR "预览安装示例源码集合不匹配")
    endif()
    foreach(relative IN LISTS expected_files)
        file(SHA256 "${repo}/examples/basic/${relative}" expected)
        file(SHA256 "${directory}/share/AWJimage/examples/basic/${relative}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "预览示例与本次源码不匹配：${relative}")
        endif()
    endforeach()
endfunction()
