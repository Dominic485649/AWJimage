file(GLOB_RECURSE actual LIST_DIRECTORIES true RELATIVE "${extracted}" "${extracted}/*")
list(SORT expected)
list(SORT actual)
if(NOT expected STREQUAL actual)
    message(FATAL_ERROR "预览归档往返成员集合变化")
endif()
foreach(relative IN LISTS expected)
    if(IS_SYMLINK "${package}/${relative}")
        message(FATAL_ERROR "HMOS 预览安装不得引入符号链接")
    elseif(IS_DIRECTORY "${package}/${relative}")
        if(NOT IS_DIRECTORY "${extracted}/${relative}" OR IS_SYMLINK "${extracted}/${relative}")
            message(FATAL_ERROR "预览归档目录类型变化")
        endif()
    else()
        file(SHA256 "${package}/${relative}" expected_hash)
        file(SHA256 "${extracted}/${relative}" actual_hash)
        if(NOT expected_hash STREQUAL actual_hash OR IS_SYMLINK "${extracted}/${relative}")
            message(FATAL_ERROR "预览归档字节或文件类型变化：${relative}")
        endif()
    endif()
endforeach()
