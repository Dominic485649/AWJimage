        CROSS_TEST_BINARY_DIRECTORY TARGET_CMAKE_TOOLCHAIN_FILE TARGET_NATIVE_SDK_DIRECTORY TARGET_LINK_MAP LLVM_DIRECTORY)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
