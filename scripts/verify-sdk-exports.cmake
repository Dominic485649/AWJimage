cmake_minimum_required(VERSION 3.30)
foreach(required IN ITEMS LIBRARY INCLUDE_DIRECTORY)
    if(NOT DEFINED ${required} OR NOT EXISTS "${${required}}")
        message(FATAL_ERROR "缺少有效的 ${required}")
    endif()
endforeach()
if(NOT NM)
    find_program(NM NAMES llvm-nm nm REQUIRED)
endif()
file(GLOB headers "${INCLUDE_DIRECTORY}/awj/*.h")
set(expected)
foreach(header IN LISTS headers)
    file(READ "${header}" text)
    string(REGEX MATCHALL "AWJ_API[ \t\r\n]+[^;]+AWJ_CALL[ \t\r\n]+awj_[A-Za-z0-9_]+[ \t\r\n]*\\(" declarations "${text}")
    foreach(declaration IN LISTS declarations)
        string(REGEX REPLACE ".*AWJ_CALL[ \t\r\n]+(awj_[A-Za-z0-9_]+)[ \t\r\n]*\\(" "\\1" symbol "${declaration}")
        if(symbol IN_LIST expected)
            message(FATAL_ERROR "重复的公共符号：${symbol}")
        endif()
        list(APPEND expected "${symbol}")
    endforeach()
endforeach()
execute_process(COMMAND "${NM}" -D --defined-only --format=posix "${LIBRARY}"
    RESULT_VARIABLE result OUTPUT_VARIABLE exports ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "读取 ELF 导出失败：${error}")
endif()
string(REPLACE "\n" ";" lines "${exports}")
set(actual)
foreach(line IN LISTS lines)
    if(line STREQUAL "")
        continue()
    endif()
    string(REGEX MATCH "^[^ \t]+" symbol "${line}")
    # 只排除本 SDK 的 ELF version node，不隐藏未知的 C++/第三方导出。
    if(symbol STREQUAL "AWJ_1")
        continue()
    endif()
    string(REGEX REPLACE "@@AWJ_1$" "" symbol "${symbol}")
    list(APPEND actual "${symbol}")
endforeach()
list(SORT expected)
list(SORT actual)
if(NOT expected OR NOT "${actual}" STREQUAL "${expected}")
    set(extra "${actual}")
    set(missing "${expected}")
    list(REMOVE_ITEM extra ${expected})
    list(REMOVE_ITEM missing ${actual})
    message(FATAL_ERROR "ELF 导出不匹配；额外：${extra}；缺少：${missing}")
endif()
list(LENGTH actual count)
message(STATUS "ELF 精确导出白名单通过：${count} 个公共 C 符号，无 C++ 或第三方接口。")
