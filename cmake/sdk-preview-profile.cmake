include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/sdk-hmos-cross-build.cmake")

# 此入口只实现用户分别明确批准的 1.3.1、1.3.3、1.3.4 HMOS 组件预览范围。
# 原有正式 SDK 的 JUnit、目标运行与 loader 门禁保持不变。
function(awj_sdk_require_hmos_preview_scope version prefix)
    if((NOT version STREQUAL "1.3.1" AND NOT version STREQUAL "1.3.3" AND NOT version STREQUAL "1.3.4") OR
            NOT ${prefix}_hmos OR NOT "${${prefix}_profile}" STREQUAL "hmos-arm64-api26-clang23")
        message(FATAL_ERROR "HMOS 预览范围只授权给 1.3.1、1.3.3、1.3.4 的明确目标 profile")
    endif()
endfunction()

function(awj_sdk_hmos_preview_program_names out)
    awj_sdk_hmos_program_names(names)
    set(${out} "${names}" PARENT_SCOPE)
endfunction()

function(awj_sdk_validate_hmos_preview_proof proof prefix version head fingerprint library_hash compiler_version compiler_hash programs build_log_hash)
    awj_sdk_require_hmos_preview_scope("${version}" "${prefix}")
    awj_sdk_json_expect("${proof}" NUMBER 1 schema)
    awj_sdk_json_expect("${proof}" STRING hmos-cross-build kind)
    awj_sdk_json_expect("${proof}" STRING preview mode)
    awj_sdk_json_expect("${proof}" STRING cross-linked status)
    awj_sdk_json_expect("${proof}" STRING cross-build-preview validation_tier)
    awj_sdk_json_expect("${proof}" STRING not-run target_execution)
    awj_sdk_json_expect("${proof}" STRING not-run target_loader)
    awj_sdk_json_expect("${proof}" STRING "${version}" version)
    awj_sdk_json_expect("${proof}" STRING "${head}" git_head)
    awj_sdk_json_expect("${proof}" STRING "${fingerprint}" source_fingerprint)
    awj_sdk_json_expect("${proof}" BOOLEAN OFF source_dirty)
    awj_sdk_json_expect("${proof}" BOOLEAN ON native_codecs)
    awj_sdk_json_expect("${proof}" BOOLEAN ON compiled_source_verified)
    awj_sdk_json_expect("${proof}" STRING "${${prefix}_profile}" profile)
    awj_sdk_json_expect("${proof}" STRING "${${prefix}_platform}" platform)
    awj_sdk_json_expect("${proof}" STRING "${${prefix}_triple}" target_triple)
    awj_sdk_json_expect("${proof}" NUMBER 1 abi)
    awj_sdk_json_expect("${proof}" STRING Clang compiler_id)
    awj_sdk_parse_compiler_banner("clang version ${compiler_version}" 23 ignored)
    foreach(field IN ITEMS fingerprint library_hash compiler_hash build_log_hash)
        awj_sdk_require_hash("${${field}}" "${field}")
    endforeach()
    awj_sdk_json_expect("${proof}" STRING "${compiler_version}" compiler_version)
    awj_sdk_json_expect("${proof}" STRING "${compiler_hash}" compiler_sha256)
    awj_sdk_json_expect("${proof}" STRING "${library_hash}" library_sha256)
    awj_sdk_json_expect("${proof}" STRING "${build_log_hash}" build_log_sha256)
    awj_sdk_hmos_metadata("${proof}")
    foreach(feature IN ITEMS d3d11 shm ffmpeg stream gpu)
        awj_sdk_json_expect("${proof}" BOOLEAN OFF features "${feature}")
    endforeach()
    awj_sdk_json_get(encoders "${proof}" ARRAY encoders)
    string(JSON count LENGTH "${encoders}")
    if(NOT count EQUAL 5)
        message(FATAL_ERROR "预览 SDK 也必须包含完整五编码器")
    endif()
    set(actual)
    foreach(index RANGE 0 4)
        awj_sdk_json_get(encoder "${encoders}" STRING "${index}")
        list(APPEND actual "${encoder}")
    endforeach()
    list(SORT actual)
    if(NOT actual STREQUAL "avif;jpegli;jxl;png;webp")
        message(FATAL_ERROR "预览 SDK 也必须包含完整五编码器")
    endif()
    # 交叉链接预览不接收伪装成运行验收的报告字段。
    foreach(field IN ITEMS test_report_sha256 consumer_report_sha256 target_execution_report_sha256)
        string(JSON ignored ERROR_VARIABLE error TYPE "${proof}" "${field}")
        if(error STREQUAL "NOTFOUND")
            message(FATAL_ERROR "预览证明不得携带运行验收字段：${field}")
        endif()
    endforeach()
    awj_sdk_hmos_preview_program_names(names)
    awj_sdk_json_get(records "${proof}" OBJECT test_programs)
    string(JSON count LENGTH "${records}")
    if(NOT count EQUAL 7)
        message(FATAL_ERROR "预览必须绑定七个真实最终链接的目标程序")
    endif()
    foreach(name IN LISTS names)
        awj_sdk_json_get(expected "${programs}" STRING "${name}" sha256)
        awj_sdk_require_hash("${expected}" "${name}")
        awj_sdk_json_expect("${records}" STRING "${expected}" "${name}" sha256)
    endforeach()
endfunction()

# 七个目标程序包含独立兼容辅助测试；允许未导入 SDK 的辅助程序，
# 但都必须是真实 AArch64 ELF 可执行映像及原 Native 运行库闭包。
function(awj_sdk_check_hmos_preview_program_text text)
    awj_sdk_check_hmos_program_text("${text}")
endfunction()
