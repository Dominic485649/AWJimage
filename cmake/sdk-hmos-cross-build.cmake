include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/sdk-release-profiles.cmake")

# 历史预览与正式跨构建共用中性能力；本模块绝不执行目标程序。
function(awj_sdk_hmos_program_names out)
    set(${out} awj_sdk_tests awj_sdk_c_consumer awj_sdk_encode_tests
        awj_sdk_pixel_tests awj_sdk_yuv_readonly_tests awj_sdk_stdlib_tests
        awj_sdk_worker_failure_tests PARENT_SCOPE)
endfunction()

function(awj_sdk_hmos_program_role name out)
    if(name MATCHES "^(awj_sdk_tests|awj_sdk_c_consumer|awj_sdk_encode_tests|awj_sdk_yuv_readonly_tests)$")
        set(role sdk-consumer)
    elseif(name MATCHES "^(awj_sdk_pixel_tests|awj_sdk_stdlib_tests|awj_sdk_worker_failure_tests)$")
        set(role standalone-helper)
    else()
        message(FATAL_ERROR "未知 HMOS 最终程序：${name}")
    endif()
    set(${out} "${role}" PARENT_SCOPE)
endfunction()

function(awj_sdk_require_hmos_cross_scope version prefix)
    awj_sdk_select_validation_tier("${version}" "${${prefix}_profile}" tier)
    if(NOT ${prefix}_hmos OR NOT tier STREQUAL "cross-build")
        message(FATAL_ERROR "正式 HMOS cross-build 只适用于 >=1.3.5 的精确目标 profile")
    endif()
endfunction()

# 在创建任何审计或归档文件前，将输出与所有只读及已绑定输入隔离。
# 输出父目录必须已存在，借此解析真实祖先，防止别名路径绕过前缀检查。
function(awj_sdk_hmos_reject_output_overlap output)
    if(NOT IS_ABSOLUTE "${output}")
        message(FATAL_ERROR "HMOS 打包输出必须是绝对路径")
    endif()
    get_filename_component(parent "${output}" DIRECTORY)
    get_filename_component(leaf "${output}" NAME)
    if(NOT IS_DIRECTORY "${parent}" OR leaf STREQUAL "" OR leaf MATCHES "^[.][.]?$")
        message(FATAL_ERROR "HMOS 打包输出需要存在的父目录及全新子目录")
    endif()
    file(REAL_PATH "${parent}" parent)
    cmake_path(SET proposed NORMALIZE "${parent}/${leaf}")
    foreach(input IN LISTS ARGN)
        if(NOT IS_ABSOLUTE "${input}" OR NOT IS_DIRECTORY "${input}")
            message(FATAL_ERROR "HMOS 输出保护缺少可信输入目录：${input}")
        endif()
        file(REAL_PATH "${input}" protected)
        cmake_path(IS_PREFIX protected "${proposed}" NORMALIZE inside_input)
        cmake_path(IS_PREFIX proposed "${protected}" NORMALIZE contains_input)
        if(inside_input OR contains_input)
            message(FATAL_ERROR "HMOS 打包输出与只读或已绑定输入重叠：${proposed} / ${protected}")
        endif()
    endforeach()
endfunction()

# 按存在性而非真值拒绝，空串、null、OFF 不能伪装成未传入。
function(awj_sdk_hmos_reject_execution_options)
    get_cmake_property(variables VARIABLES)
    foreach(key IN LISTS variables)
        string(TOLOWER "${key}" lower)
        if(lower MATCHES "^(test_report|sdk_test_report|consumer_report|target_execution_report|target_loader_report)(_(sha256|path))?$" OR
            lower MATCHES "^(target_runner|runner|target_execution_evidence|target_execution|target_loader|skip_tests|skiptests)$" OR
            lower MATCHES "(^|_)(exit_code|junit|run_summary|runtime_summary|execution_summary|loader_summary|execution_passed|loader_passed)$")
            message(FATAL_ERROR "交叉构建入口不得传入运行验收选项：${key}")
        endif()
    endforeach()
endfunction()

function(awj_sdk_hmos_no_execution_claims json)
    string(JSON type TYPE "${json}")
    if(NOT type MATCHES "^(OBJECT|ARRAY)$")
        return()
    endif()
    string(JSON count LENGTH "${json}")
    if(count EQUAL 0)
        return()
    endif()
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        if(type STREQUAL "OBJECT")
            string(JSON key MEMBER "${json}" "${index}")
            string(TOLOWER "${key}" lower)
            if(lower MATCHES "^(test_report|sdk_test_report|consumer_report|target_execution_report|target_loader_report)(_(sha256|path))?$" OR
                lower MATCHES "^(target_runner|runner|target_execution_evidence|sdk_test_log|consumer_log|loader_log)(_(sha256|path))?$" OR
                lower MATCHES "^(sdk_tests|installed_consumers|loader|compiled_source_verified|passed)$" OR
                lower MATCHES "(^|_)(exit_code|junit|run_summary|runtime_summary|execution_summary|loader_summary|execution_passed|loader_passed)$")
                message(FATAL_ERROR "交叉构建证明不得携带运行验收字段：${key}")
            endif()
            if(lower MATCHES "^(target_execution|target_loader|execution)$")
                awj_sdk_json_expect("${json}" STRING not-run "${key}")
            endif()
        else()
            set(key "${index}")
        endif()
        string(JSON child_type TYPE "${json}" "${key}")
        if(child_type MATCHES "^(OBJECT|ARRAY)$")
            string(JSON child GET "${json}" "${key}")
            awj_sdk_hmos_no_execution_claims("${child}")
        endif()
    endforeach()
endfunction()

function(awj_sdk_hmos_verification stage out)
    if(stage STREQUAL "build")
        set(checks cross_build test_programs_linked compiler_identity target_identity native_inputs)
    elseif(stage STREQUAL "consumers")
        set(checks installed_consumers_linked sdk_library_binding)
    elseif(stage STREQUAL "asset")
        set(checks cross_build test_programs_linked installed_consumers_linked compiler_identity
            target_identity native_inputs exports archive_roundtrip validation_notice)
    else()
        message(FATAL_ERROR "未知 HMOS 证明阶段")
    endif()
    set(value "{\"target_execution\":\"not-run\",\"target_loader\":\"not-run\"}")
    foreach(check IN LISTS checks)
        string(JSON value SET "${value}" "${check}" "\"passed\"")
    endforeach()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(awj_sdk_hmos_cross_header json kind mode version head fingerprint library_hash)
    awj_sdk_hmos_no_execution_claims("${json}")
    foreach(hash IN ITEMS fingerprint library_hash)
        awj_sdk_require_hash("${${hash}}" "${hash}")
    endforeach()
    awj_sdk_json_expect("${json}" NUMBER 1 schema)
    foreach(pair IN ITEMS "kind|${kind}" "mode|${mode}" "status|cross-linked" "validation_tier|cross-build"
        "target_execution|not-run" "target_loader|not-run" "profile|hmos-arm64-api26-clang23"
        "platform|hmos-arm64-api26" "target_triple|aarch64-unknown-linux-ohos" "version|${version}"
        "git_head|${head}" "source_fingerprint|${fingerprint}" "library_sha256|${library_hash}")
        string(REPLACE "|" ";" parts "${pair}")
        list(GET parts 0 key)
        list(GET parts 1 expected)
        awj_sdk_json_expect("${json}" STRING "${expected}" "${key}")
    endforeach()
    awj_sdk_json_expect("${json}" NUMBER 1 abi)
endfunction()

function(awj_sdk_check_hmos_program_text text)
    if(NOT text MATCHES "Format: elf64-littleaarch64[\r\n]" OR NOT text MATCHES "Arch: aarch64[\r\n]" OR
        NOT text MATCHES "AddressSize: 64bit" OR NOT text MATCHES "Type: (SharedObject|Executable)")
        message(FATAL_ERROR "HMOS 程序不是目标 AArch64 ELF 最终可执行映像")
    endif()
    if(text MATCHES "Type: SharedObject" AND NOT text MATCHES "FLAGS_1[^\r\n]*PIE")
        message(FATAL_ERROR "HMOS 程序不是最终可执行 PIE 映像，不能用 DSO 替代")
    endif()
    if(text MATCHES "RPATH|RUNPATH")
        message(FATAL_ERROR "HMOS 目标程序不得含宿主运行路径")
    endif()
    string(REGEX MATCH "NeededLibraries \\[([^]]*)\\]" needed "${text}")
    if(needed STREQUAL "")
        message(FATAL_ERROR "HMOS 目标程序缺少真实动态依赖记录")
    endif()
    string(REPLACE "\n" ";" lines "${CMAKE_MATCH_1}")
    set(dependencies)
    foreach(line IN LISTS lines)
        string(STRIP "${line}" dependency)
        if(dependency STREQUAL "")
            continue()
        endif()
        if(NOT dependency MATCHES "^(libawj_sdk|libc|libm|libdl)\\.so$")
            message(FATAL_ERROR "HMOS 程序引入非 Native 运行库依赖：${dependency}")
        endif()
        list(APPEND dependencies "${dependency}")
    endforeach()
    if(NOT "libc.so" IN_LIST dependencies)
        message(FATAL_ERROR "HMOS 程序未绑定原 Native libc.so")
    endif()
    if(ARGC GREATER 1)
        if(ARGV1 STREQUAL "sdk-consumer" AND NOT "libawj_sdk.so" IN_LIST dependencies)
            message(FATAL_ERROR "HMOS SDK 消费程序没有导入本次 SDK")
        elseif(ARGV1 STREQUAL "standalone-helper" AND "libawj_sdk.so" IN_LIST dependencies)
            message(FATAL_ERROR "HMOS 独立辅助程序不应导入 SDK")
        endif()
    endif()
endfunction()

function(awj_sdk_hmos_check_program path role readobj log)
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}" OR IS_SYMLINK "${path}")
        message(FATAL_ERROR "缺少真实 HMOS 最终程序：${path}")
    endif()
    file(READ "${path}" magic LIMIT 4 HEX)
    if(NOT magic STREQUAL "7f454c46")
        message(FATAL_ERROR "HMOS 最终程序不是 ELF 映像")
    endif()
    execute_process(COMMAND "${readobj}" --file-headers --needed-libs --dynamic-table "${path}"
        RESULT_VARIABLE result OUTPUT_VARIABLE text ERROR_VARIABLE error TIMEOUT 60)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "HMOS 最终程序身份读取失败：${error}")
    endif()
    awj_sdk_check_hmos_program_text("${text}" "${role}")
    file(WRITE "${log}" "${text}")
endfunction()

# 仅检查 LLD dependency-file 的首条真实依赖规则，不把后面的 phony 规则当输入。
function(awj_sdk_hmos_link_dependencies text binary build out)
    string(REPLACE "\r\n" "\n" text "${text}")
    string(REPLACE "\\\n" " " text "${text}")
    if(NOT text MATCHES "^([^:\n]+):([^\n]+)")
        message(FATAL_ERROR "HMOS 实际 link-inputs 不是 LLD 依赖规则")
    endif()
    set(target "${CMAKE_MATCH_1}")
    set(inputs "${CMAKE_MATCH_2}")
    file(REAL_PATH "${target}" target BASE_DIRECTORY "${build}")
    file(REAL_PATH "${binary}" expected)
    if(NOT target STREQUAL expected OR inputs MATCHES "[;\\\\\"']")
        message(FATAL_ERROR "HMOS 实际 link-inputs 目标或路径语法不匹配")
    endif()
    string(REGEX MATCHALL "[^ \t\n]+" paths "${inputs}")
    set(resolved)
    foreach(path IN LISTS paths)
        file(REAL_PATH "${path}" actual BASE_DIRECTORY "${build}")
        if(NOT EXISTS "${actual}" OR IS_DIRECTORY "${actual}")
            message(FATAL_ERROR "HMOS 实际链接输入缺失：${path}")
        endif()
        list(APPEND resolved "${actual}")
    endforeach()
    if(NOT resolved)
        message(FATAL_ERROR "HMOS 实际链接输入为空")
    endif()
    set(${out} "${resolved}" PARENT_SCOPE)
endfunction()

function(awj_sdk_hmos_check_link_inputs inputs library native resource cxx role)
    file(REAL_PATH "${library}" library)
    file(REAL_PATH "${native}/llvm/lib/aarch64-linux-ohos/libc++_static.a" libcxx)
    file(REAL_PATH "${native}/llvm/lib/aarch64-linux-ohos/libunwind.a" unwind)
    set(sdk_found FALSE)
    set(libc_found FALSE)
    foreach(path IN LISTS inputs)
        get_filename_component(name "${path}" NAME)
        if(name MATCHES "^libawj_sdk\\.so(\\..*)?$")
            if(NOT role STREQUAL "sdk-consumer" OR NOT path STREQUAL library)
                message(FATAL_ERROR "HMOS 实际链接输入绑定了错误 SDK")
            endif()
            set(sdk_found TRUE)
        elseif(name MATCHES "\\.so(\\..*)?$")
            file(REAL_PATH "${native}/sysroot/usr/lib/aarch64-linux-ohos/${name}" expected)
            if(NOT name MATCHES "^lib(c|m|dl)\\.so$" OR NOT path STREQUAL expected)
                message(FATAL_ERROR "HMOS 实际链接输入含非 Native 动态运行库")
            endif()
            if(name STREQUAL "libc.so")
                set(libc_found TRUE)
            endif()
        elseif(name MATCHES "^lib(c\\+\\+.*|unwind)\\.a$" AND NOT path STREQUAL libcxx AND NOT path STREQUAL unwind)
            message(FATAL_ERROR "HMOS 实际链接输入含替代 C++/unwind 运行库")
        elseif(name MATCHES "libstdc\\+\\+|libgcc|libc\\+\\+experimental")
            message(FATAL_ERROR "HMOS 实际链接输入含宿主/experimental 运行库")
        endif()
    endforeach()
    if((role STREQUAL "sdk-consumer" AND NOT sdk_found) OR NOT libc_found)
        message(FATAL_ERROR "HMOS 实际链接输入缺少本次 SDK 或 Native libc.so")
    endif()
    if(cxx)
        foreach(path IN ITEMS "${libcxx}" "${unwind}")
            if(NOT path IN_LIST inputs)
                message(FATAL_ERROR "HMOS 实际链接输入缺少原 Native 静态运行库")
            endif()
        endforeach()
    endif()
    foreach(name IN ITEMS crtbeginS.o crtendS.o libclang_rt.builtins.a)
        file(REAL_PATH "${resource}/lib/aarch64-linux-ohos/${name}" expected)
        if(NOT expected IN_LIST inputs)
            message(FATAL_ERROR "HMOS 实际链接输入缺少当前 resource 的 CRT/builtins")
        endif()
    endforeach()
    # 其他对象、archive 与链接脚本也必须位于已绑定的源码、构建或依赖树。
    set(roots "${native}" "${resource}" ${ARGN})
    foreach(path IN LISTS inputs)
        if(path STREQUAL library)
            continue()
        endif()
        set(inside FALSE)
        foreach(root IN LISTS roots)
            file(REAL_PATH "${root}" root_real)
            cmake_path(IS_PREFIX root_real "${path}" NORMALIZE found)
            if(found)
                set(inside TRUE)
            endif()
        endforeach()
        if(NOT inside)
            message(FATAL_ERROR "HMOS 实际链接输入越过已绑定的构建/Native/依赖范围：${path}")
        endif()
    endforeach()
endfunction()

# 完整许可、公共头、教程与全部示例必须来自当前源码；仅 HMOS 禁止符号链接。
function(awj_sdk_hmos_check_installed_sources installed repo)
    file(GLOB_RECURSE entries LIST_DIRECTORIES true RELATIVE "${installed}" "${installed}/*")
    foreach(relative IN LISTS entries)
        if(IS_SYMLINK "${installed}/${relative}")
            message(FATAL_ERROR "HMOS SDK 安装不得引入符号链接：${relative}")
        endif()
    endforeach()
    set(sources include/awj/awj.h LICENSE THIRD_PARTY_NOTICES.txt docs/sdk.md)
    set(destinations include/awj/awj.h share/AWJimage/LICENSE share/AWJimage/THIRD_PARTY_NOTICES.txt share/AWJimage/sdk.md)
    foreach(directory IN ITEMS licenses examples)
        file(GLOB_RECURSE expected LIST_DIRECTORIES false RELATIVE "${repo}/${directory}" "${repo}/${directory}/*")
        file(GLOB_RECURSE actual LIST_DIRECTORIES false RELATIVE "${installed}/share/AWJimage/${directory}" "${installed}/share/AWJimage/${directory}/*")
        list(SORT expected)
        list(SORT actual)
        if(NOT expected OR NOT "${expected}" STREQUAL "${actual}")
            message(FATAL_ERROR "HMOS 安装许可/示例集合不符合本次源码：${directory}")
        endif()
        foreach(relative IN LISTS expected)
            list(APPEND sources "${directory}/${relative}")
            list(APPEND destinations "share/AWJimage/${directory}/${relative}")
        endforeach()
    endforeach()
    foreach(source destination IN ZIP_LISTS sources destinations)
        if(NOT EXISTS "${installed}/${destination}" OR IS_DIRECTORY "${installed}/${destination}")
            message(FATAL_ERROR "HMOS 安装缺少许可/公共头/文档/示例：${destination}")
        endif()
        file(SHA256 "${repo}/${source}" expected)
        file(SHA256 "${installed}/${destination}" actual)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "HMOS 安装许可/公共头/文档/示例与源码不符：${destination}")
        endif()
    endforeach()
endfunction()

function(awj_sdk_hmos_tree_identity directory out)
    if(NOT IS_DIRECTORY "${directory}")
        message(FATAL_ERROR "HMOS 输入目录缺失：${directory}")
    endif()
    file(GLOB_RECURSE entries FOLLOW_SYMLINKS LIST_DIRECTORIES false RELATIVE "${directory}" "${directory}/*")
    list(SORT entries)
    list(LENGTH entries count)
    if(count EQUAL 0 OR count GREATER 100000)
        message(FATAL_ERROR "HMOS 输入树为空或成员过多：${directory}")
    endif()
    set(manifest "")
    foreach(relative IN LISTS entries)
        if(relative MATCHES "[;\r\n]")
            message(FATAL_ERROR "HMOS 输入成员名称无效")
        endif()
        file(REAL_PATH "${directory}/${relative}" resolved)
        file(SHA256 "${directory}/${relative}" hash)
        string(APPEND manifest "${relative}|${resolved}|${hash}\n")
    endforeach()
    string(SHA256 hash "${manifest}")
    set(${out} "${hash}" PARENT_SCOPE)
endfunction()

# 输入路径只能来自可信 CLI；记录不提供可执行工具或构建脚本。
function(awj_sdk_hmos_input_identity out)
    foreach(variable IN ITEMS TARGET_NATIVE_SDK_DIRECTORY TARGET_RESOURCE_DIRECTORY TARGET_CMAKE_TOOLCHAIN_FILE LLVM_DIRECTORY)
        if(NOT IS_ABSOLUTE "${${variable}}" OR NOT EXISTS "${${variable}}" OR "${${variable}}" MATCHES "^/mnt/[A-Za-z](/|$)")
            message(FATAL_ERROR "HMOS 缺少可信原生绝对输入：${variable}")
        endif()
    endforeach()
    set(native "${TARGET_NATIVE_SDK_DIRECTORY}")
    awj_sdk_read_file("${native}/oh-uni-package.json" 1048576 metadata)
    awj_sdk_json_expect("${metadata}" STRING 26.0.0.105 version)
    awj_sdk_json_expect("${metadata}" STRING 26 apiVersion)
    set(identity "{}")
    set(paths "${native}/oh-uni-package.json"
        "${native}/llvm/include/libcxx-ohos/include/c++/v1/__config"
        "${native}/llvm/include/libcxx-ohos/include/c++/v1/__config_site"
        "${native}/llvm/lib/aarch64-linux-ohos/libc++_static.a"
        "${native}/llvm/lib/aarch64-linux-ohos/libunwind.a" "${TARGET_CMAKE_TOOLCHAIN_FILE}" "${CMAKE_COMMAND}")
    set(keys native_metadata_sha256 libcxx_config_sha256 libcxx_config_site_sha256 libcxx_static_sha256 libunwind_sha256 toolchain_sha256 cmake_sha256)
    foreach(path key IN ZIP_LISTS paths keys)
        if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
            message(FATAL_ERROR "HMOS 原始输入缺失：${key}")
        endif()
        file(SHA256 "${path}" hash)
        string(JSON identity SET "${identity}" "${key}" "\"${hash}\"")
    endforeach()
    foreach(tool IN ITEMS clang clang++ clang-scan-deps ld.lld llvm-ar llvm-ranlib llvm-readobj llvm-nm)
        awj_sdk_find_llvm_tool(path "${tool}" 23)
        file(SHA256 "${path}" hash)
        string(JSON identity SET "${identity}" "${tool}_sha256" "\"${hash}\"")
        execute_process(COMMAND "${path}" --version RESULT_VARIABLE result OUTPUT_VARIABLE banner
            ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE TIMEOUT 30)
        if(NOT result EQUAL 0 OR NOT banner MATCHES "(version |LLD )23\\.[0-9]+\\.[0-9]+([^0-9.]|$)")
            message(FATAL_ERROR "HMOS 工具不是匹配的 LLVM23：${tool} ${error}")
        endif()
        awj_sdk_json_quote(banner "${banner}")
        string(JSON identity SET "${identity}" "${tool}_banner" "${banner}")
    endforeach()
    unset(ninja)
    find_program(ninja NAMES ninja NO_CACHE REQUIRED)
    file(SHA256 "${ninja}" hash)
    string(JSON identity SET "${identity}" ninja_sha256 "\"${hash}\"")
    string(JSON identity SET "${identity}" cmake_version "\"${CMAKE_VERSION}\"")
    awj_sdk_find_llvm_tool(clang clang++ 23)
    execute_process(COMMAND "${clang}" -print-resource-dir RESULT_VARIABLE result
        OUTPUT_VARIABLE resource OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_VARIABLE error TIMEOUT 30)
    if(NOT result EQUAL 0 OR NOT IS_DIRECTORY "${resource}/include")
        message(FATAL_ERROR "无法核对 Clang23 resource：${error}")
    endif()
    set(names include lib/aarch64-linux-ohos/libclang_rt.builtins.a
        lib/aarch64-linux-ohos/crtbegin.o lib/aarch64-linux-ohos/crtbeginS.o lib/aarch64-linux-ohos/crtbeginT.o
        lib/aarch64-linux-ohos/crtend.o lib/aarch64-linux-ohos/crtendS.o)
    set(runtime "${native}/llvm/lib/clang/15.0.4/lib/aarch64-linux-ohos")
    set(originals "${resource}/include" "${runtime}/libclang_rt.builtins.a"
        "${runtime}/clang_rt.crtbegin.o" "${runtime}/clang_rt.crtbegin.o" "${runtime}/clang_rt.crtbegin.o"
        "${runtime}/clang_rt.crtend.o" "${runtime}/clang_rt.crtend.o")
    foreach(name original IN ZIP_LISTS names originals)
        set(path "${TARGET_RESOURCE_DIRECTORY}/${name}")
        file(REAL_PATH "${path}" actual)
        file(REAL_PATH "${original}" expected)
        if(NOT EXISTS "${path}" OR NOT IS_SYMLINK "${path}" OR NOT actual STREQUAL expected)
            message(FATAL_ERROR "HMOS resource 不是当前 Clang23/Native26 的原始输入：${name}")
        endif()
    endforeach()
    foreach(tree IN ITEMS sysroot llvm/include/libcxx-ohos llvm/lib/aarch64-linux-ohos llvm/lib/clang/15.0.4/lib/aarch64-linux-ohos)
        awj_sdk_hmos_tree_identity("${native}/${tree}" hash)
        string(JSON identity SET "${identity}" "native:${tree}" "\"${hash}\"")
    endforeach()
    awj_sdk_hmos_tree_identity("${TARGET_RESOURCE_DIRECTORY}" hash)
    string(JSON identity SET "${identity}" resource_sha256 "\"${hash}\"")
    string(SHA256 hash "${identity}")
    set(${out} "${identity}" PARENT_SCOPE)
    set(${out}_sha256 "${hash}" PARENT_SCOPE)
endfunction()

function(awj_sdk_hmos_stamp mode version head fingerprint inputs dependencies nonce target out)
    awj_sdk_hmos_program_names(programs)
    if(NOT target STREQUAL "awj_sdk" AND NOT target IN_LIST programs)
        message(FATAL_ERROR "HMOS 私有来源标记包含未知目标：${target}")
    endif()
    set(${out} "AWJ_HMOS_BUILD_V1:mode=${mode}:version=${version}:head=${head}:source=${fingerprint}:inputs=${inputs}:dependencies=${dependencies}:nonce=${nonce}:target=${target}:END" PARENT_SCOPE)
endfunction()

function(awj_sdk_hmos_check_stamp binary mode version head fingerprint inputs dependencies nonce target)
    awj_sdk_hmos_stamp("${mode}" "${version}" "${head}" "${fingerprint}" "${inputs}" "${dependencies}" "${nonce}" "${target}" expected)
    file(STRINGS "${binary}" strings REGEX "AWJ_HMOS_BUILD_V1:" LIMIT_COUNT 2)
    if(NOT "${strings}" STREQUAL "${expected}")
        message(FATAL_ERROR "HMOS 最终映像缺少本轮真实编译的私有来源标记")
    endif()
endfunction()

# 仅真实配置上下文可调用；私有 nonce 每次构建生成一次，验证/封存不得刷新。
function(awj_sdk_hmos_generate_build_manifest)
    awj_sdk_select_profile("${AWJ_SDK_VERSION}" hmos-arm64-api26-clang23 Linux x86_64 profile)
    awj_sdk_require_hmos_cross_scope("${AWJ_SDK_VERSION}" profile)
    if(NOT AWJ_HMOS_RECORD_MODE MATCHES "^(formal|candidate)$" OR NOT BUILD_TESTING OR
        NOT CMAKE_BUILD_TYPE STREQUAL "Release" OR NOT CMAKE_CROSSCOMPILING OR
        NOT CMAKE_SYSTEM_NAME STREQUAL "OHOS" OR NOT CMAKE_SYSTEM_VERSION VERSION_EQUAL 26 OR
        NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$" OR NOT CMAKE_SKIP_RPATH OR
        NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang" OR NOT CMAKE_C_COMPILER_ID STREQUAL "Clang" OR
        NOT CMAKE_CXX_COMPILER_TARGET MATCHES "${AWJ_SDK_HMOS_COMPILER_TARGET_PATTERN}" OR
        NOT CMAKE_C_COMPILER_TARGET MATCHES "${AWJ_SDK_HMOS_COMPILER_TARGET_PATTERN}" OR
        NOT AVIF_ENABLE_RELEASE_IPO OR NOT AVIF_RELEASE_IPO_SUPPORTED OR NOT AWJ_SDK_NATIVE_CODECS OR
        NOT AWJ_USE_PORTABLE_STDLIB OR NOT AWJ_JPEGLI_AVAILABLE OR
        AWJ_SDK_D3D11 OR AWJ_SDK_SHM OR AWJ_SDK_FFMPEG OR AWJ_SDK_TOOLS OR AWJ_HARMONY_NODE_API)
        message(FATAL_ERROR "HMOS 来源采集要求完整原生五编码器及实际 Release/IPO/API26/Clang23 配置")
    endif()
    awj_sdk_parse_compiler_banner("clang version ${CMAKE_CXX_COMPILER_VERSION}" 23 ignored)
    awj_sdk_parse_compiler_banner("clang version ${CMAKE_C_COMPILER_VERSION}" 23 ignored)
    include(CheckIPOSupported)
    check_ipo_supported(RESULT c_ipo OUTPUT c_ipo_error LANGUAGES C)
    if(NOT c_ipo)
        message(FATAL_ERROR "HMOS C 验证目标 IPO 不可用：${c_ipo_error}")
    endif()
    foreach(field IN ITEMS SOURCE_FINGERPRINT INPUT_IDENTITY DEPENDENCY_IDENTITY RECORD_NONCE)
        awj_sdk_require_hash("${AWJ_HMOS_${field}}" "AWJ_HMOS_${field}")
    endforeach()
    if(NOT AWJ_HMOS_GIT_HEAD MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "HMOS 缺少真实 Git HEAD")
    endif()
    foreach(path IN ITEMS "${CMAKE_BINARY_DIR}" "${AWJ_SDK_SOURCE_ROOT}" "${AWJ_HMOS_EVIDENCE_DIRECTORY}"
        "${AWJ_SDK_LINK_MAP}" "${AWJ_OHOS_NATIVE_ROOT}" "${AWJ_OHOS_RESOURCE_DIR}" "${AWJ_OHOS_LLVM_ROOT}")
        if(NOT IS_ABSOLUTE "${path}" OR path MATCHES "[ \t\r\n;\"\\\\]" OR path MATCHES "^/mnt/[A-Za-z](/|$)")
            message(FATAL_ERROR "HMOS 来源路径必须为无歧义原生绝对路径：${path}")
        endif()
    endforeach()
    file(REAL_PATH "${CMAKE_SYSROOT}" sysroot)
    file(REAL_PATH "${AWJ_OHOS_NATIVE_ROOT}/sysroot" expected_sysroot)
    if(NOT sysroot STREQUAL expected_sysroot)
        message(FATAL_ERROR "HMOS 实际 sysroot 与 Native 输入不同")
    endif()
    set(header "${CMAKE_BINARY_DIR}/awj-hmos-build-run.h")
    file(CONFIGURE OUTPUT "${header}" CONTENT "/* 私有构建输入依赖，不改变公共 ABI。 */\n#define AWJ_HMOS_BUILD_RUN \"${AWJ_HMOS_RECORD_NONCE}\"\n" @ONLY)
    set(manifest "{\"schema\":1,\"kind\":\"cmake-hmos-target-manifest\",\"targets\":{}}")
    file(REAL_PATH "${AWJ_SDK_SOURCE_ROOT}" source)
    foreach(pair IN ITEMS "mode|${AWJ_HMOS_RECORD_MODE}" "version|${AWJ_SDK_VERSION}" "git_head|${AWJ_HMOS_GIT_HEAD}"
        "source_fingerprint|${AWJ_HMOS_SOURCE_FINGERPRINT}" "input_identity_sha256|${AWJ_HMOS_INPUT_IDENTITY}"
        "dependency_identity_sha256|${AWJ_HMOS_DEPENDENCY_IDENTITY}" "nonce|${AWJ_HMOS_RECORD_NONCE}"
        "source_directory|${source}" "build_directory|${CMAKE_BINARY_DIR}" "compiler_c|${CMAKE_C_COMPILER}"
        "compiler_cxx|${CMAKE_CXX_COMPILER}" "compiler_version|${CMAKE_CXX_COMPILER_VERSION}"
        "compiler_target|${CMAKE_CXX_COMPILER_TARGET}" "sysroot|${sysroot}" "resource_directory|${AWJ_OHOS_RESOURCE_DIR}"
        "ninja|${CMAKE_MAKE_PROGRAM}")
        string(REPLACE "|" ";" parts "${pair}")
        list(GET parts 0 key)
        list(GET parts 1 value)
        awj_sdk_json_quote(quoted "${value}")
        string(JSON manifest SET "${manifest}" "${key}" "${quoted}")
    endforeach()
    file(MAKE_DIRECTORY "${AWJ_HMOS_EVIDENCE_DIRECTORY}/target-profiles" "${AWJ_HMOS_EVIDENCE_DIRECTORY}/link-maps")
    awj_sdk_hmos_program_names(programs)
    foreach(target IN ITEMS awj_sdk ${programs})
        if(NOT TARGET "${target}")
            message(FATAL_ERROR "HMOS 缺少最终配置目标：${target}")
        endif()
        # 已确认 C/C++ IPO_SUPPORTED 后，仅补齐本项目八个最终目标，不清理第三方缓存。
        set_property(TARGET "${target}" PROPERTY INTERPROCEDURAL_OPTIMIZATION_RELEASE TRUE)
        target_compile_options("${target}" PRIVATE "-include${header}")
        # 标记同时绑定目标名称，拒绝同角色程序互换后冒用另一份链接记录。
        awj_sdk_hmos_stamp("${AWJ_HMOS_RECORD_MODE}" "${AWJ_SDK_VERSION}" "${AWJ_HMOS_GIT_HEAD}"
            "${AWJ_HMOS_SOURCE_FINGERPRINT}" "${AWJ_HMOS_INPUT_IDENTITY}" "${AWJ_HMOS_DEPENDENCY_IDENTITY}"
            "${AWJ_HMOS_RECORD_NONCE}" "${target}" stamp)
        set(stamp_source "${CMAKE_BINARY_DIR}/awj-hmos-build-identity-${target}.c")
        file(CONFIGURE OUTPUT "${stamp_source}" CONTENT
            "/* 私有保留节，无外部符号和初始化函数。 */\n__attribute__((used, retain, section(\".awj.build\"))) static const char awj_hmos_build_identity[] = \"\\0${stamp}\";\n" @ONLY)
        target_sources("${target}" PRIVATE "${stamp_source}")
        if(target STREQUAL "awj_sdk")
            set(role sdk-library)
            set(map "${AWJ_SDK_LINK_MAP}")
        else()
            awj_sdk_hmos_program_role("${target}" role)
            set(map "${AWJ_HMOS_EVIDENCE_DIRECTORY}/link-maps/${target}.map")
            target_link_options("${target}" PRIVATE "LINKER:-Map,${map}")
        endif()
        set(inputs "${AWJ_HMOS_EVIDENCE_DIRECTORY}/link-maps/${target}.d")
        target_link_options("${target}" PRIVATE "LINKER:--dependency-file=${inputs}")
        set(profile_file "${AWJ_HMOS_EVIDENCE_DIRECTORY}/target-profiles/${target}-$<CONFIG>.txt")
        file(GENERATE OUTPUT "${profile_file}" CONTENT
"schema=1
configuration=$<CONFIG>
target=${target}
type=$<TARGET_PROPERTY:${target},TYPE>
link_language=$<TARGET_PROPERTY:${target},LINKER_LANGUAGE>
ipo=$<BOOL:$<TARGET_PROPERTY:${target},INTERPROCEDURAL_OPTIMIZATION_RELEASE>>
compiler_c=${CMAKE_C_COMPILER}
compiler_cxx=${CMAKE_CXX_COMPILER}
compiler_target=${CMAKE_CXX_COMPILER_TARGET}
sysroot=${sysroot}
resource=${AWJ_OHOS_RESOURCE_DIR}
compile_c_flags=${CMAKE_C_FLAGS} ${CMAKE_C_FLAGS_RELEASE}
compile_cxx_flags=${CMAKE_CXX_FLAGS} ${CMAKE_CXX_FLAGS_RELEASE}
compile_options=$<JOIN:$<TARGET_GENEX_EVAL:${target},$<TARGET_PROPERTY:${target},COMPILE_OPTIONS>>, >
compile_definitions=$<JOIN:$<TARGET_GENEX_EVAL:${target},$<TARGET_PROPERTY:${target},COMPILE_DEFINITIONS>>, >
link_flags=${CMAKE_EXE_LINKER_FLAGS} ${CMAKE_SHARED_LINKER_FLAGS} ${CMAKE_EXE_LINKER_FLAGS_RELEASE} ${CMAKE_SHARED_LINKER_FLAGS_RELEASE}
link_options=$<JOIN:$<TARGET_GENEX_EVAL:${target},$<TARGET_PROPERTY:${target},LINK_OPTIONS>>, >
ipo_compile_flags=${CMAKE_CXX_COMPILE_OPTIONS_IPO}
ipo_link_flags=${CMAKE_CXX_LINK_OPTIONS_IPO}
")
        string(JSON manifest SET "${manifest}" targets "${target}"
            "{\"path\":\"$<TARGET_FILE:${target}>\",\"profile\":\"${profile_file}\",\"link_map\":\"${map}\",\"link_inputs\":\"${inputs}\",\"role\":\"${role}\"}")
    endforeach()
    file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/awj-hmos-targets-$<CONFIG>.json" CONTENT "${manifest}\n")
endfunction()

function(awj_sdk_hmos_check_target_profile text target)
    foreach(line IN ITEMS schema=1 configuration=Release "target=${target}" ipo=1)
        awj_sdk_require_log_line("${text}" "${line}")
    endforeach()
    if(target STREQUAL "awj_sdk")
        awj_sdk_require_log_line("${text}" type=SHARED_LIBRARY)
    else()
        awj_sdk_require_log_line("${text}" type=EXECUTABLE)
    endif()
    if(NOT text MATCHES "(^|[ ;])-O3([ ;\r\n]|$)" OR NOT text MATCHES "-flto(=thin|=full)?([ ;\r\n]|$)" OR
        text MATCHES "(^|[ ;=])(-O[012szg]|-Ofast|-fno-lto|-ffast-math|-stdlib=libstdc\\+\\+)([ ;\r\n]|$)")
        message(FATAL_ERROR "HMOS 实际目标存在 Release/IPO 优化降档：${target}")
    endif()
endfunction()

# manifest 的路径只读且受范围约束；工具执行路径始终由可信 CLI 重新选择。
function(awj_sdk_hmos_collect_targets manifest_path work repo build prefix identity readobj log_dir out)
    assert_under("${build}" "${manifest_path}")
    awj_sdk_read_file("${manifest_path}" 1048576 manifest)
    awj_sdk_json_expect("${manifest}" NUMBER 1 schema)
    awj_sdk_json_expect("${manifest}" STRING cmake-hmos-target-manifest kind)
    awj_sdk_json_expect("${manifest}" STRING "${repo}" source_directory)
    awj_sdk_json_expect("${manifest}" STRING "${build}" build_directory)
    awj_sdk_json_expect("${manifest}" STRING "${${identity}_compiler_version}" compiler_version)
    foreach(field IN ITEMS compiler_c compiler_cxx ninja)
        if(field STREQUAL "compiler_c")
            awj_sdk_find_llvm_tool(expected clang 23)
        elseif(field STREQUAL "compiler_cxx")
            set(expected "${${identity}_compiler}")
        else()
            set(expected expected-NOTFOUND)
            find_program(expected NAMES ninja NO_CACHE REQUIRED)
        endif()
        awj_sdk_json_get(actual "${manifest}" STRING "${field}")
        file(REAL_PATH "${actual}" actual)
        file(REAL_PATH "${expected}" expected)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "HMOS 生成配置未使用可信工具：${field}")
        endif()
        unset(expected)
    endforeach()
    awj_sdk_json_get(compiler_target "${manifest}" STRING compiler_target)
    if(NOT compiler_target MATCHES "${AWJ_SDK_HMOS_COMPILER_TARGET_PATTERN}")
        message(FATAL_ERROR "HMOS 生成配置未使用目标 compiler triple")
    endif()
    file(REAL_PATH "${TARGET_NATIVE_SDK_DIRECTORY}/sysroot" expected)
    awj_sdk_json_expect("${manifest}" STRING "${expected}" sysroot)
    awj_sdk_json_expect("${manifest}" STRING "${TARGET_RESOURCE_DIRECTORY}" resource_directory)
    awj_sdk_json_get(targets "${manifest}" OBJECT targets)
    string(JSON count LENGTH "${targets}")
    if(NOT count EQUAL 8)
        message(FATAL_ERROR "HMOS manifest 必须绑定 SDK 和七个最终程序")
    endif()
    awj_sdk_json_get(library "${targets}" STRING awj_sdk path)
    file(MAKE_DIRECTORY "${log_dir}")
    awj_sdk_hmos_program_names(programs)
    set(records "{}")
    foreach(target IN ITEMS awj_sdk ${programs})
        foreach(field IN ITEMS path profile link_map link_inputs)
            awj_sdk_json_get("${field}" "${targets}" STRING "${target}" "${field}")
            assert_under("${work}" "${${field}}")
            if(NOT EXISTS "${${field}}" OR IS_DIRECTORY "${${field}}" OR IS_SYMLINK "${${field}}")
                message(FATAL_ERROR "HMOS 生成目标缺少真实普通文件：${target}/${field}")
            endif()
        endforeach()
        awj_sdk_read_file("${profile}" 1048576 target_profile)
        awj_sdk_hmos_check_target_profile("${target_profile}" "${target}")
        foreach(field IN ITEMS compiler_c compiler_cxx compiler_target sysroot)
            awj_sdk_json_get(expected "${manifest}" STRING "${field}")
            awj_sdk_require_log_line("${target_profile}" "${field}=${expected}")
        endforeach()
        awj_sdk_require_log_line("${target_profile}" "resource=${TARGET_RESOURCE_DIRECTORY}")
        if(target STREQUAL "awj_sdk")
            set(role sdk-library)
            awj_sdk_check_binary("${path}" "${prefix}" "${readobj}" "${log_dir}/${target}.txt")
            awj_sdk_read_file("${link_map}" 134217728 map)
            awj_sdk_check_hmos_link_map("${map}" "${TARGET_NATIVE_SDK_DIRECTORY}/llvm/lib/aarch64-linux-ohos/libc++_static.a"
                "${TARGET_NATIVE_SDK_DIRECTORY}/llvm/lib/aarch64-linux-ohos/libunwind.a")
        else()
            if(DEFINED CROSS_TEST_BINARY_DIRECTORY)
                assert_under("${CROSS_TEST_BINARY_DIRECTORY}" "${path}")
            endif()
            awj_sdk_hmos_program_role("${target}" role)
            awj_sdk_hmos_check_program("${path}" "${role}" "${readobj}" "${log_dir}/${target}.txt")
        endif()
        awj_sdk_json_expect("${targets}" STRING "${role}" "${target}" role)
        if(target_profile MATCHES "\nlink_language=CXX\n")
            set(cxx TRUE)
        elseif(target_profile MATCHES "\nlink_language=C\n")
            set(cxx FALSE)
        else()
            message(FATAL_ERROR "HMOS 最终链接语言无效")
        endif()
        awj_sdk_read_file("${link_inputs}" 16777216 dependencies)
        awj_sdk_hmos_link_dependencies("${dependencies}" "${path}" "${build}" inputs)
        awj_sdk_hmos_check_link_inputs("${inputs}" "${library}" "${TARGET_NATIVE_SDK_DIRECTORY}" "${TARGET_RESOURCE_DIRECTORY}"
            "${cxx}" "${role}" "${build}" "${repo}" "${DEPENDENCY_DIRECTORY}")
        set(record "{\"role\":\"${role}\",\"execution\":\"not-run\"}")
        foreach(field IN ITEMS path profile link_map link_inputs)
            file(SHA256 "${${field}}" hash)
            if(field STREQUAL "path")
                set(key sha256)
            else()
                set(key "${field}_sha256")
            endif()
            string(JSON record SET "${record}" "${key}" "\"${hash}\"")
        endforeach()
        foreach(field IN ITEMS mode version git_head source_fingerprint input_identity_sha256 dependency_identity_sha256 nonce)
            awj_sdk_json_get("${field}" "${manifest}" STRING "${field}")
        endforeach()
        awj_sdk_hmos_check_stamp("${path}" "${mode}" "${version}" "${git_head}" "${source_fingerprint}"
            "${input_identity_sha256}" "${dependency_identity_sha256}" "${nonce}" "${target}")
        if(role STREQUAL "sdk-consumer")
            file(SHA256 "${library}" library_hash)
            string(JSON record SET "${record}" sdk_library_sha256 "\"${library_hash}\"")
        endif()
        string(JSON records SET "${records}" "${target}" "${record}")
    endforeach()
    file(SHA256 "${library}" library_hash)
    file(SHA256 "${manifest_path}" manifest_hash)
    foreach(field IN ITEMS records manifest library library_hash manifest_hash)
        set(${out}_${field} "${${field}}" PARENT_SCOPE)
    endforeach()
endfunction()

function(awj_sdk_validate_hmos_cross_proof proof prefix version head fingerprint library_hash compiler_version compiler_hash records manifest manifest_hash input_identity build_log_hash mode)
    awj_sdk_require_hmos_cross_scope("${version}" "${prefix}")
    awj_sdk_hmos_cross_header("${proof}" hmos-cross-build "${mode}" "${version}" "${head}" "${fingerprint}" "${library_hash}")
    if(mode STREQUAL "formal")
        awj_sdk_json_expect("${proof}" BOOLEAN OFF source_dirty)
    endif()
    awj_sdk_json_expect("${proof}" BOOLEAN ON native_codecs)
    awj_sdk_json_expect("${proof}" STRING Clang compiler_id)
    awj_sdk_parse_compiler_banner("clang version ${compiler_version}" 23 ignored)
    awj_sdk_json_expect("${proof}" STRING "${compiler_version}" compiler_version)
    awj_sdk_json_expect("${proof}" STRING "${compiler_hash}" compiler_sha256)
    awj_sdk_json_expect("${proof}" STRING "${build_log_hash}" build_log_sha256)
    awj_sdk_json_expect("${proof}" STRING "${manifest_hash}" target_manifest_sha256)
    awj_sdk_json_expect("${proof}" STRING project-targets-only build_strategy)
    awj_sdk_json_expect("${proof}" STRING cmake-generated-target-profile flags_source)
    awj_sdk_hmos_metadata("${proof}")
    foreach(feature IN ITEMS d3d11 shm ffmpeg stream gpu)
        awj_sdk_json_expect("${proof}" BOOLEAN OFF features "${feature}")
    endforeach()
    awj_sdk_json_get(encoders "${proof}" ARRAY encoders)
    string(JSON count LENGTH "${encoders}")
    if(NOT count EQUAL 5)
        message(FATAL_ERROR "HMOS 正式交叉构建要求完整五编码器")
    endif()
    set(names)
    foreach(index RANGE 0 4)
        awj_sdk_json_get(name "${encoders}" STRING "${index}")
        list(APPEND names "${name}")
    endforeach()
    list(SORT names)
    if(NOT names STREQUAL "avif;jpegli;jxl;png;webp")
        message(FATAL_ERROR "HMOS 正式交叉构建要求完整五编码器")
    endif()
    awj_sdk_json_get(library_record "${records}" OBJECT awj_sdk)
    awj_sdk_json_expect("${library_record}" STRING "${library_hash}" sha256)
    awj_sdk_json_expect("${proof}" OBJECT "${library_record}" library)
    string(JSON programs REMOVE "${records}" awj_sdk)
    string(JSON count LENGTH "${programs}")
    if(NOT count EQUAL 7)
        message(FATAL_ERROR "HMOS test_programs 必须绑定七个最终程序")
    endif()
    awj_sdk_hmos_program_names(names)
    foreach(name IN LISTS names)
        awj_sdk_hmos_program_role("${name}" role)
        awj_sdk_json_expect("${programs}" STRING "${role}" "${name}" role)
        awj_sdk_json_expect("${programs}" STRING not-run "${name}" execution)
        foreach(field IN ITEMS sha256 profile_sha256 link_map_sha256 link_inputs_sha256)
            awj_sdk_json_get(hash "${programs}" STRING "${name}" "${field}")
            awj_sdk_require_hash("${hash}" "${name}/${field}")
        endforeach()
        if(role STREQUAL "sdk-consumer")
            awj_sdk_json_expect("${programs}" STRING "${library_hash}" "${name}" sdk_library_sha256)
        endif()
    endforeach()
    awj_sdk_json_expect("${proof}" OBJECT "${programs}" test_programs)
    foreach(field IN ITEMS mode version git_head source_fingerprint input_identity_sha256 dependency_identity_sha256 nonce)
        awj_sdk_json_get(expected "${manifest}" STRING "${field}")
        awj_sdk_json_expect("${proof}" STRING "${expected}" "${field}")
    endforeach()
    string(SHA256 input_hash "${input_identity}")
    awj_sdk_json_expect("${proof}" STRING "${input_hash}" input_identity_sha256)
    awj_sdk_json_expect("${proof}" OBJECT "${input_identity}" inputs_before)
    awj_sdk_json_expect("${proof}" OBJECT "${input_identity}" inputs_after)
    awj_sdk_hmos_verification(build checks)
    awj_sdk_json_expect("${proof}" OBJECT "${checks}" verification)
endfunction()

function(awj_sdk_hmos_consumer_report proof build_hash consumers out)
    set(report "{}")
    foreach(field IN ITEMS schema mode status validation_tier target_execution target_loader version git_head
        source_fingerprint profile platform target_triple abi library_sha256)
        string(JSON type TYPE "${proof}" "${field}")
        string(JSON value GET "${proof}" "${field}")
        if(type STREQUAL "STRING")
            awj_sdk_json_quote(value "${value}")
        endif()
        string(JSON report SET "${report}" "${field}" "${value}")
    endforeach()
    string(JSON report SET "${report}" kind "\"hmos-cross-link-consumers\"")
    string(JSON report SET "${report}" build_evidence_sha256 "\"${build_hash}\"")
    string(JSON report SET "${report}" consumers "${consumers}")
    awj_sdk_hmos_verification(consumers checks)
    string(JSON report SET "${report}" verification "${checks}")
    set(${out} "${report}" PARENT_SCOPE)
endfunction()

function(awj_sdk_hmos_validate_consumer_report report version head fingerprint library_hash proof_hash consumers)
    awj_sdk_hmos_cross_header("${report}" hmos-cross-link-consumers formal "${version}" "${head}" "${fingerprint}" "${library_hash}")
    awj_sdk_json_expect("${report}" STRING "${proof_hash}" build_evidence_sha256)
    awj_sdk_json_get(actual "${report}" OBJECT consumers)
    string(JSON count LENGTH "${actual}")
    if(NOT count EQUAL 3)
        message(FATAL_ERROR "HMOS 消费者证明必须恰好包含三个消费者")
    endif()
    set(names installed_c_consumer installed_cxx_consumer installed_cxx17_consumer)
    set(standards c99 c++11 c++17)
    foreach(name standard IN ZIP_LISTS names standards)
        awj_sdk_json_get(expected "${consumers}" STRING "${name}" sha256)
        awj_sdk_require_hash("${expected}" "${name}")
        awj_sdk_json_expect("${actual}" STRING "${expected}" "${name}" sha256)
        awj_sdk_json_expect("${actual}" STRING "${standard}" "${name}" standard)
        awj_sdk_json_expect("${actual}" STRING "${library_hash}" "${name}" sdk_library_sha256)
    endforeach()
    awj_sdk_json_expect("${report}" OBJECT "${consumers}" consumers)
    awj_sdk_hmos_verification(consumers checks)
    awj_sdk_json_expect("${report}" OBJECT "${checks}" verification)
endfunction()
