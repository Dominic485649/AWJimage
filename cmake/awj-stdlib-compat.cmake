include_guard(GLOBAL)
get_filename_component(AWJ_COMPAT_SOURCE_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_awj_portable_default OFF)
if(CMAKE_SYSTEM_NAME STREQUAL "OHOS")
    set(_awj_portable_default ON)
endif()
option(AWJ_USE_PORTABLE_STDLIB "使用固定目标标准库缺失设施的私有适配" ${_awj_portable_default})
add_library(awj_private_fmt STATIC EXCLUDE_FROM_ALL
    "${AWJ_COMPAT_SOURCE_ROOT}/src/compat/vendor/fmt/src/format.cc")
set_target_properties(awj_private_fmt PROPERTIES POSITION_INDEPENDENT_CODE ON
    CXX_VISIBILITY_PRESET hidden VISIBILITY_INLINES_HIDDEN ON CXX_SCAN_FOR_MODULES OFF)
target_include_directories(awj_private_fmt PUBLIC
    "$<BUILD_INTERFACE:${AWJ_COMPAT_SOURCE_ROOT}/src/compat/vendor/fmt/include>")
add_library(awj_stdlib INTERFACE)
target_include_directories(awj_stdlib INTERFACE
    "$<BUILD_INTERFACE:${AWJ_COMPAT_SOURCE_ROOT}/src/compat>")
target_compile_definitions(awj_stdlib INTERFACE
    AWJ_USE_PORTABLE_STDLIB=$<BOOL:${AWJ_USE_PORTABLE_STDLIB}>)
if(AWJ_USE_PORTABLE_STDLIB)
    target_link_libraries(awj_stdlib INTERFACE awj_private_fmt)
endif()
file(READ "${AWJ_COMPAT_SOURCE_ROOT}/cmake/stdlib-compat-dependencies.json" _awj_compat_lock)
string(JSON _awj_compat_count LENGTH "${_awj_compat_lock}" files)
math(EXPR _awj_compat_last "${_awj_compat_count} - 1")
foreach(index RANGE ${_awj_compat_last})
    string(JSON path GET "${_awj_compat_lock}" files ${index} path)
    string(JSON expected GET "${_awj_compat_lock}" files ${index} sha256)
    file(READ "${AWJ_COMPAT_SOURCE_ROOT}/${path}" content)
    string(REPLACE "\r\n" "\n" content "${content}")
    string(SHA256 actual "${content}")
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "私有兼容源码与固定依赖锁不一致：${path}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${AWJ_COMPAT_SOURCE_ROOT}/${path}")
endforeach()
