function(awj_check_sdk_capabilities)
    set(CMAKE_TRY_COMPILE_TARGET_TYPE EXECUTABLE)
    set(CMAKE_REQUIRED_INCLUDES
        "${AWJ_SDK_SOURCE_ROOT}/src/compat"
        "${AWJ_SDK_SOURCE_ROOT}/src/compat/vendor/fmt/include")
    if(AWJ_USE_PORTABLE_STDLIB)
        set(CMAKE_REQUIRED_DEFINITIONS -DAWJ_USE_PORTABLE_STDLIB=1 -DFMT_HEADER_ONLY=1)
    else()
        set(CMAKE_REQUIRED_DEFINITIONS -DAWJ_USE_PORTABLE_STDLIB=0)
    endif()
    check_cxx_source_compiles("#include <span>\n#include <bit>\n#include <string_view>\n#include \"expected_compat.h\"\n#if defined(__OHOS__)\n#define AWJ_TEXT_(v) #v\n#define AWJ_TEXT(v) AWJ_TEXT_(v)\nstatic_assert(_LIBCPP_VERSION == 15004 && _LIBCPP_ABI_VERSION == 1);\nstatic_assert(std::string_view(AWJ_TEXT(_LIBCPP_ABI_NAMESPACE)) == \"__n1\");\n#endif\nint main(){awj::compat::stop_source s; awj::compat::expected<int,int> v(1); return !v || s.stop_requested();}" AWJ_SDK_CXX23_WORKS)
    if(NOT AWJ_SDK_CXX23_WORKS)
        message(FATAL_ERROR "目标 SDK 基础设施或指定 libc++ ABI 最终链接失败")
    endif()
    if(AWJ_SDK_NATIVE_CODECS)
        check_cxx_source_compiles("#include <chrono>\n#include \"format_compat.h\"\nint main(){const auto t=std::chrono::sys_seconds{std::chrono::seconds{-1}}; auto s=awj::compat::format(L\"{:%Y%m%d-%H%M%S}\", t); awj::compat::print(\"{}\", s.size()); return s.empty();}" AWJ_SDK_NATIVE_CXX23_LIBRARY_WORKS)
        if(NOT AWJ_SDK_NATIVE_CXX23_LIBRARY_WORKS)
            message(FATAL_ERROR "完整 SDK 的实际宽时间格式化与打印接口最终链接失败")
        endif()
    endif()
endfunction()
