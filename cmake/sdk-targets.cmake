include(GNUInstallDirs)
include(CMakePackageConfigHelpers)
include(CheckCXXSourceCompiles)
if(NOT AWJ_SDK_SOURCE_ROOT)
    set(AWJ_SDK_SOURCE_ROOT "${CMAKE_CURRENT_SOURCE_DIR}")
endif()
option(AWJ_SDK_D3D11 "构建 D3D11 原生帧导入" ${WIN32})
set(AWJ_SDK_SHM_DEFAULT OFF)
if(WIN32 OR CMAKE_SYSTEM_NAME STREQUAL "Linux")
    set(AWJ_SDK_SHM_DEFAULT ON)
endif()
option(AWJ_SDK_SHM "构建本机零输入复制的共享内存帧通道" ${AWJ_SDK_SHM_DEFAULT})
option(AWJ_SDK_FFMPEG "构建可选 AVFrame C ABI 桥接" OFF)
if(CMAKE_CXX_COMPILER_ID MATCHES "Clang" AND CMAKE_CXX_COMPILER_VERSION VERSION_LESS 21)
    message(FATAL_ERROR "AWJ SDK 要求 Clang 21 或以上")
endif()
set(CMAKE_CXX_STANDARD 23)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
check_cxx_source_compiles("#include <expected>\n#include <span>\n#include <stop_token>\n#include <bit>\nint main(){std::stop_source s; std::expected<int,int> v(1); return !v || s.stop_requested();}" AWJ_SDK_CXX23_WORKS)
if(NOT AWJ_SDK_CXX23_WORKS)
    message(FATAL_ERROR "目标工具链/标准库不满足 SDK 的 C++23 构建要求")
endif()
if(AWJ_SDK_D3D11 AND NOT WIN32)
    message(FATAL_ERROR "D3D11 组件仅适用于 Windows")
endif()
if(AWJ_SDK_SHM AND NOT WIN32 AND NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "共享内存组件目前只适用于 Windows/Linux")
endif()
set(AWJ_SDK_SOURCES
    "${AWJ_SDK_SOURCE_ROOT}/src/sdk/awj_sdk.cpp"
    "${AWJ_SDK_SOURCE_ROOT}/src/sdk/frame_stream.cpp")
if(AWJ_SDK_NATIVE_CODECS)
    list(APPEND AWJ_SDK_SOURCES "${AWJ_SDK_SOURCE_ROOT}/src/sdk/native_encode.cpp")
endif()
if(AWJ_SDK_D3D11)
    list(APPEND AWJ_SDK_SOURCES "${AWJ_SDK_SOURCE_ROOT}/src/interop/d3d11_frame.cpp")
endif()
if(AWJ_SDK_SHM)
    if(WIN32)
        list(APPEND AWJ_SDK_SOURCES "${AWJ_SDK_SOURCE_ROOT}/src/interop/frame_transport_win32.cpp")
    else()
        list(APPEND AWJ_SDK_SOURCES "${AWJ_SDK_SOURCE_ROOT}/src/interop/frame_transport_posix.cpp")
    endif()
endif()
if(AWJ_SDK_FFMPEG)
    find_path(AWJ_SDK_AVUTIL_INCLUDE_DIR libavutil/frame.h REQUIRED)
    if(NOT EXISTS "${AWJ_SDK_AVUTIL_INCLUDE_DIR}/libavutil/avconfig.h")
        set(AWJ_SDK_FFMPEG_GENERATED_DIR "${CMAKE_CURRENT_BINARY_DIR}/generated/ffmpeg")
        set(AWJ_FFMPEG_BIG_ENDIAN 0)
        if(CMAKE_CXX_BYTE_ORDER STREQUAL "BIG_ENDIAN")
            set(AWJ_FFMPEG_BIG_ENDIAN 1)
        endif()
        configure_file("${AWJ_SDK_SOURCE_ROOT}/cmake/ffmpeg-avconfig.h.in"
            "${AWJ_SDK_FFMPEG_GENERATED_DIR}/libavutil/avconfig.h" @ONLY)
    endif()
    list(APPEND AWJ_SDK_SOURCES "${AWJ_SDK_SOURCE_ROOT}/src/interop/ffmpeg_frame.cpp")
endif()
add_library(awj_sdk SHARED ${AWJ_SDK_SOURCES})
add_library(AWJimage::SDK ALIAS awj_sdk)
set_target_properties(awj_sdk PROPERTIES EXPORT_NAME SDK CXX_VISIBILITY_PRESET hidden
    VISIBILITY_INLINES_HIDDEN ON VERSION ${AWJ_SDK_VERSION} SOVERSION 1)
target_include_directories(awj_sdk PUBLIC
    "$<BUILD_INTERFACE:${AWJ_SDK_SOURCE_ROOT}/include>"
    "$<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>")
target_include_directories(awj_sdk PRIVATE "${AWJ_SDK_SOURCE_ROOT}/src/sdk")
target_compile_features(awj_sdk PRIVATE cxx_std_23)
target_compile_definitions(awj_sdk PRIVATE AWJ_SDK_BUILD AWJ_SDK_VERSION="${AWJ_SDK_VERSION}"
    AWJ_SDK_NATIVE_CODECS=$<BOOL:${AWJ_SDK_NATIVE_CODECS}>
    AWJ_SDK_D3D11=$<BOOL:${AWJ_SDK_D3D11}>
    AWJ_SDK_SHM=$<BOOL:${AWJ_SDK_SHM}>
    AWJ_SDK_FFMPEG=$<BOOL:${AWJ_SDK_FFMPEG}>)
if(MSVC)
    target_compile_options(awj_sdk PRIVATE /W4 /utf-8 /EHsc)
else()
    target_compile_options(awj_sdk PRIVATE -Wall -Wextra -Wpedantic)
    target_link_options(awj_sdk PRIVATE "LINKER:--version-script=${AWJ_SDK_SOURCE_ROOT}/src/sdk/exports.map")
    set_property(TARGET awj_sdk APPEND PROPERTY LINK_DEPENDS "${AWJ_SDK_SOURCE_ROOT}/src/sdk/exports.map")
endif()
if(AWJ_SDK_NATIVE_CODECS)
    target_link_libraries(awj_sdk PRIVATE awj_native_backend)
endif()
if(AWJ_SDK_D3D11)
    target_link_libraries(awj_sdk PRIVATE d3d11 dxgi)
endif()
if(AWJ_SDK_SHM)
    if(WIN32)
        target_link_libraries(awj_sdk PRIVATE advapi32)
    else()
        find_package(Threads REQUIRED)
        target_link_libraries(awj_sdk PRIVATE Threads::Threads)
    endif()
endif()
if(AWJ_SDK_FFMPEG)
    target_include_directories(awj_sdk PRIVATE "${AWJ_SDK_AVUTIL_INCLUDE_DIR}")
    if(AWJ_SDK_FFMPEG_GENERATED_DIR)
        target_include_directories(awj_sdk PRIVATE "${AWJ_SDK_FFMPEG_GENERATED_DIR}")
    endif()
endif()
install(TARGETS awj_sdk EXPORT AWJimageTargets
    RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR} COMPONENT AWJimageSDK
    LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT AWJimageSDK
    ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT AWJimageSDK)
install(FILES "${AWJ_SDK_SOURCE_ROOT}/include/awj/awj.h" DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/awj COMPONENT AWJimageSDK)
foreach(component IN ITEMS D3D11 SHM FFMPEG)
    if(AWJ_SDK_${component})
        string(TOLOWER "${component}" header)
        install(FILES "${AWJ_SDK_SOURCE_ROOT}/include/awj/awj_${header}.h" DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/awj COMPONENT AWJimageSDK)
    endif()
endforeach()
configure_package_config_file("${AWJ_SDK_SOURCE_ROOT}/cmake/AWJimageConfig.cmake.in"
    "${CMAKE_CURRENT_BINARY_DIR}/AWJimageConfig.cmake" INSTALL_DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/AWJimage)
write_basic_package_version_file("${CMAKE_CURRENT_BINARY_DIR}/AWJimageConfigVersion.cmake"
    VERSION ${AWJ_SDK_VERSION} COMPATIBILITY SameMajorVersion)
install(EXPORT AWJimageTargets NAMESPACE AWJimage:: DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/AWJimage COMPONENT AWJimageSDK)
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/AWJimageConfig.cmake"
    "${CMAKE_CURRENT_BINARY_DIR}/AWJimageConfigVersion.cmake" DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/AWJimage COMPONENT AWJimageSDK)
install(FILES "${AWJ_SDK_SOURCE_ROOT}/LICENSE" "${AWJ_SDK_SOURCE_ROOT}/THIRD_PARTY_NOTICES.txt"
    DESTINATION ${CMAKE_INSTALL_DATADIR}/AWJimage COMPONENT AWJimageSDK)
install(DIRECTORY "${AWJ_SDK_SOURCE_ROOT}/licenses/" DESTINATION ${CMAKE_INSTALL_DATADIR}/AWJimage/licenses COMPONENT AWJimageSDK)
install(DIRECTORY "${AWJ_SDK_SOURCE_ROOT}/examples/" DESTINATION ${CMAKE_INSTALL_DATADIR}/AWJimage/examples COMPONENT AWJimageSDK)
install(FILES "${AWJ_SDK_SOURCE_ROOT}/docs/sdk.md" DESTINATION ${CMAKE_INSTALL_DATADIR}/AWJimage COMPONENT AWJimageSDK)
option(AWJ_SDK_TOOLS "构建只通过 C API 使用 SDK 的内存流工具" ${AWJ_SDK_NATIVE_CODECS})
if(AWJ_SDK_TOOLS)
    add_executable(awj-stream "${AWJ_SDK_SOURCE_ROOT}/examples/streaming/awj-stream.cpp")
    target_link_libraries(awj-stream PRIVATE awj_sdk)
    target_compile_features(awj-stream PRIVATE cxx_std_23)
    install(TARGETS awj-stream RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR} COMPONENT AWJimageSDK)
endif()
if(BUILD_TESTING)
    enable_language(C)
    add_executable(awj_sdk_tests "${AWJ_SDK_SOURCE_ROOT}/tests/sdk_tests.cpp")
    target_link_libraries(awj_sdk_tests PRIVATE awj_sdk)
    target_compile_features(awj_sdk_tests PRIVATE cxx_std_23)
    add_test(NAME sdk_core COMMAND awj_sdk_tests)
    set_tests_properties(sdk_core PROPERTIES TIMEOUT 45)
    add_executable(awj_sdk_c_consumer "${AWJ_SDK_SOURCE_ROOT}/tests/sdk_c_consumer.c")
    target_link_libraries(awj_sdk_c_consumer PRIVATE awj_sdk)
    add_test(NAME sdk_c_abi COMMAND awj_sdk_c_consumer)
    set(AWJ_SDK_CHECK_TARGETS awj_sdk awj_sdk_tests awj_sdk_c_consumer)
    if(TARGET awj-stream)
        list(APPEND AWJ_SDK_CHECK_TARGETS awj-stream)
    endif()
    if(AWJ_SDK_SHM)
        if(WIN32)
            set(AWJ_SDK_SHM_TEST_SOURCE tests/sdk_shm_tests.cpp)
        else()
            set(AWJ_SDK_SHM_TEST_SOURCE tests/sdk_shm_posix_tests.cpp)
        endif()
        add_executable(awj_sdk_shm_tests "${AWJ_SDK_SOURCE_ROOT}/${AWJ_SDK_SHM_TEST_SOURCE}")
        target_link_libraries(awj_sdk_shm_tests PRIVATE awj_sdk)
        target_compile_features(awj_sdk_shm_tests PRIVATE cxx_std_23)
        add_test(NAME sdk_shared_memory COMMAND awj_sdk_shm_tests)
        set_tests_properties(sdk_shared_memory PROPERTIES TIMEOUT 20)
        list(APPEND AWJ_SDK_CHECK_TARGETS awj_sdk_shm_tests)
    endif()
    if(AWJ_SDK_D3D11)
        add_executable(awj_sdk_d3d11_tests "${AWJ_SDK_SOURCE_ROOT}/tests/sdk_d3d11_tests.cpp")
        target_link_libraries(awj_sdk_d3d11_tests PRIVATE awj_sdk d3d11)
        target_compile_features(awj_sdk_d3d11_tests PRIVATE cxx_std_23)
        add_test(NAME sdk_d3d11 COMMAND awj_sdk_d3d11_tests)
        add_test(NAME sdk_d3d11_shared COMMAND awj_sdk_d3d11_tests --shared)
        set_tests_properties(sdk_d3d11 sdk_d3d11_shared PROPERTIES TIMEOUT 30 SKIP_RETURN_CODE 77)
        list(APPEND AWJ_SDK_CHECK_TARGETS awj_sdk_d3d11_tests)
    endif()
    if(AWJ_SDK_NATIVE_CODECS)
        add_executable(awj_sdk_encode_tests "${AWJ_SDK_SOURCE_ROOT}/tests/sdk_encode_tests.cpp")
        avif_enable_common_options(awj_sdk_encode_tests)
        target_link_libraries(awj_sdk_encode_tests PRIVATE awj_sdk awj_native_backend)
        add_test(NAME sdk_native_encode COMMAND awj_sdk_encode_tests)
        set_tests_properties(sdk_native_encode PROPERTIES TIMEOUT 180)
        list(APPEND AWJ_SDK_CHECK_TARGETS awj_sdk_encode_tests)
        add_executable(awj_sdk_pixel_tests "${AWJ_SDK_SOURCE_ROOT}/tests/pixel_conversion_tests.cpp")
        avif_enable_common_options(awj_sdk_pixel_tests)
        target_link_libraries(awj_sdk_pixel_tests PRIVATE awj_native_codecs)
        target_compile_definitions(awj_sdk_pixel_tests PRIVATE AWJ_HEIF_TEST_DATA="${libheif_SOURCE_DIR}/tests/data")
        add_test(NAME sdk_pixel_conversion COMMAND awj_sdk_pixel_tests)
        set_tests_properties(sdk_pixel_conversion PROPERTIES TIMEOUT 180)
        list(APPEND AWJ_SDK_CHECK_TARGETS awj_sdk_pixel_tests)
        add_executable(awj_sdk_yuv_readonly_tests "${AWJ_SDK_SOURCE_ROOT}/tests/sdk_yuv_readonly_tests.cpp")
        target_link_libraries(awj_sdk_yuv_readonly_tests PRIVATE awj_sdk)
        target_compile_features(awj_sdk_yuv_readonly_tests PRIVATE cxx_std_23)
        add_test(NAME sdk_borrowed_yuv COMMAND awj_sdk_yuv_readonly_tests)
        set_tests_properties(sdk_borrowed_yuv PROPERTIES TIMEOUT 90)
        list(APPEND AWJ_SDK_CHECK_TARGETS awj_sdk_yuv_readonly_tests)
        if(WIN32)
            add_executable(awj_wgc_cli_validation "${AWJ_SDK_SOURCE_ROOT}/src/cli/main.cpp")
            avif_enable_common_options(awj_wgc_cli_validation)
            target_link_libraries(awj_wgc_cli_validation PRIVATE awj_native_backend)
            target_compile_definitions(awj_wgc_cli_validation PRIVATE AWJ_MEMORY_CLI_ONLY=1)
            list(APPEND AWJ_SDK_CHECK_TARGETS awj_wgc_cli_validation)
        endif()
    endif()
    if(AWJ_SDK_FFMPEG)
        set(AWJ_SDK_FFMPEG_TEST_AVUTIL "" CACHE FILEPATH "仅供测试的来源 libavutil 动态库，不安装或分发")
        add_executable(awj_sdk_ffmpeg_tests "${AWJ_SDK_SOURCE_ROOT}/tests/sdk_ffmpeg_tests.cpp")
        target_link_libraries(awj_sdk_ffmpeg_tests PRIVATE awj_sdk ${CMAKE_DL_LIBS})
        target_compile_features(awj_sdk_ffmpeg_tests PRIVATE cxx_std_23)
        target_include_directories(awj_sdk_ffmpeg_tests PRIVATE "${AWJ_SDK_AVUTIL_INCLUDE_DIR}" "${AWJ_SDK_FFMPEG_GENERATED_DIR}")
        add_test(NAME sdk_ffmpeg COMMAND awj_sdk_ffmpeg_tests ${AWJ_SDK_FFMPEG_TEST_AVUTIL})
        set_tests_properties(sdk_ffmpeg PROPERTIES TIMEOUT 30 SKIP_RETURN_CODE 77)
        list(APPEND AWJ_SDK_CHECK_TARGETS awj_sdk_ffmpeg_tests)
    endif()
    add_custom_target(awj_sdk_validation DEPENDS ${AWJ_SDK_CHECK_TARGETS})
endif()
