# 基于 libavif 1.4.2 的上游预缩放分层支持，固定提交 768b3dfe。
# 必须在现有四个 AWJ 补丁之后执行；完整文件指纹覆盖 API 与编码器实现。
if(NOT DEFINED SOURCE_DIR OR SOURCE_DIR STREQUAL "")
    message(FATAL_ERROR "预缩放分层补丁需要 SOURCE_DIR")
endif()
set(_all_before TRUE)
set(_all_after TRUE)
file(READ "${SOURCE_DIR}/include/avif/avif.h" _content)
string(REPLACE "\r\n" "\n" _content "${_content}")
string(SHA256 _hash "${_content}")
if(NOT _hash STREQUAL "dcbd033a2c2362c385f54ac0245b039ce6233df2f98f8018198a115e31fd6a59")
    set(_all_before FALSE)
endif()
if(NOT _hash STREQUAL "61572853645b70a17d9b591795e0a570c5bbab3cd9d572a3f29266c469c91d35")
    set(_all_after FALSE)
endif()
file(READ "${SOURCE_DIR}/src/codec_aom.c" _content)
string(REPLACE "\r\n" "\n" _content "${_content}")
string(SHA256 _hash "${_content}")
if(NOT _hash STREQUAL "36a5d1a7d3893f98e43d9d4e8f68e7528d83ba4ac2c805c8a21ab20d1f36b061")
    set(_all_before FALSE)
endif()
if(NOT _hash STREQUAL "8ac57b7e6a65434989bb3fe7f076dc041e14d2c5f7e0975466ca53b6a2e76bef")
    set(_all_after FALSE)
endif()
file(READ "${SOURCE_DIR}/src/write.c" _content)
string(REPLACE "\r\n" "\n" _content "${_content}")
string(SHA256 _hash "${_content}")
if(NOT _hash STREQUAL "d78027330a64f1627c15306061bce259d29f6a2e20b01bab6a9c505dbdb04cb3")
    set(_all_before FALSE)
endif()
if(NOT _hash STREQUAL "1b8d2fb5ba5a40fad5974fe464e1b96bcd2fbecf0ec26126246ccd9892ffc920")
    set(_all_after FALSE)
endif()
if(_all_after)
    return()
endif()
if(NOT _all_before)
    message(FATAL_ERROR "libavif 预缩放层源码未知、混合或损坏，需要人工重审")
endif()
find_package(Git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" apply --check
    "${CMAKE_CURRENT_LIST_DIR}/libavif-prescaled-768b3dfe.patch"
    COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" apply
    "${CMAKE_CURRENT_LIST_DIR}/libavif-prescaled-768b3dfe.patch"
    COMMAND_ERROR_IS_FATAL ANY)
file(READ "${SOURCE_DIR}/include/avif/avif.h" _content)
string(REPLACE "\r\n" "\n" _content "${_content}")
string(SHA256 _hash "${_content}")
if(NOT _hash STREQUAL "61572853645b70a17d9b591795e0a570c5bbab3cd9d572a3f29266c469c91d35")
    message(FATAL_ERROR "libavif 上游回补后的 include/avif/avif.h 与核验指纹不符")
endif()
file(READ "${SOURCE_DIR}/src/codec_aom.c" _content)
string(REPLACE "\r\n" "\n" _content "${_content}")
string(SHA256 _hash "${_content}")
if(NOT _hash STREQUAL "8ac57b7e6a65434989bb3fe7f076dc041e14d2c5f7e0975466ca53b6a2e76bef")
    message(FATAL_ERROR "libavif 上游回补后的 src/codec_aom.c 与核验指纹不符")
endif()
file(READ "${SOURCE_DIR}/src/write.c" _content)
string(REPLACE "\r\n" "\n" _content "${_content}")
string(SHA256 _hash "${_content}")
if(NOT _hash STREQUAL "1b8d2fb5ba5a40fad5974fe464e1b96bcd2fbecf0ec26126246ccd9892ffc920")
    message(FATAL_ERROR "libavif 上游回补后的 src/write.c 与核验指纹不符")
endif()
