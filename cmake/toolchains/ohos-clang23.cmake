include_guard(GLOBAL)
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "此 profile 要求 WSL/Linux 原生 Clang23")
endif()
set(AWJ_OHOS_NATIVE_ROOT "$ENV{AWJ_OHOS_NATIVE_ROOT}" CACHE PATH "已校验的 Native26 目标 SDK")
set(AWJ_OHOS_RESOURCE_DIR "$ENV{AWJ_OHOS_RESOURCE_DIR}" CACHE PATH "Clang23 头与 SDK 原始 CRT/builtins 组合目录")
set(AWJ_OHOS_LLVM_ROOT "$ENV{AWJ_OHOS_LLVM_ROOT}" CACHE PATH "WSL LLVM23 安装前缀")
if(NOT AWJ_OHOS_LLVM_ROOT)
    set(AWJ_OHOS_LLVM_ROOT "/usr/lib/llvm-23" CACHE PATH "WSL LLVM23 安装前缀" FORCE)
endif()
foreach(path IN ITEMS
        "${AWJ_OHOS_NATIVE_ROOT}/oh-uni-package.json"
        "${AWJ_OHOS_NATIVE_ROOT}/sysroot/usr/lib/aarch64-linux-ohos/libc.so"
        "${AWJ_OHOS_NATIVE_ROOT}/llvm/include/libcxx-ohos/include/c++/v1/__config_site"
        "${AWJ_OHOS_NATIVE_ROOT}/llvm/lib/aarch64-linux-ohos/libc++_static.a"
        "${AWJ_OHOS_NATIVE_ROOT}/llvm/lib/aarch64-linux-ohos/libunwind.a"
        "${AWJ_OHOS_RESOURCE_DIR}/lib/aarch64-linux-ohos/crtbeginS.o"
        "${AWJ_OHOS_RESOURCE_DIR}/lib/aarch64-linux-ohos/crtendS.o"
        "${AWJ_OHOS_LLVM_ROOT}/bin/clang-scan-deps")
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "缺少已核验的 OHOS/Clang23 输入：${path}")
    endif()
endforeach()
file(READ "${AWJ_OHOS_NATIVE_ROOT}/oh-uni-package.json" sdk_metadata)
string(JSON sdk_version GET "${sdk_metadata}" version)
string(JSON sdk_api GET "${sdk_metadata}" apiVersion)
if(NOT sdk_version STREQUAL "26.0.0.105" OR NOT sdk_api STREQUAL "26")
    message(FATAL_ERROR "此 profile 只接纳 Native26.0.0.105 / API26")
endif()
file(READ "${AWJ_OHOS_NATIVE_ROOT}/llvm/include/libcxx-ohos/include/c++/v1/__config_site" libcxx_site)
if(NOT libcxx_site MATCHES "#define[ \t]+_LIBCPP_ABI_NAMESPACE[ \t]+__n1([ \r\n]|$)")
    message(FATAL_ERROR "OHOS 头必须使用 __n1 ABI namespace")
endif()
set(CMAKE_SYSTEM_NAME OHOS)
set(CMAKE_SYSTEM_VERSION 26)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_OHOS_ARCH_ABI arm64-v8a)
set(OHOS_ARCH arm64-v8a)
set(OHOS_STL c++_static)
set(OHOS_PLATFORM_LEVEL 26)
set(CMAKE_C_COMPILER "${AWJ_OHOS_LLVM_ROOT}/bin/clang" CACHE FILEPATH "WSL Clang23 C")
set(CMAKE_CXX_COMPILER "${AWJ_OHOS_LLVM_ROOT}/bin/clang++" CACHE FILEPATH "WSL Clang23 C++")
set(CMAKE_ASM_COMPILER "${AWJ_OHOS_LLVM_ROOT}/bin/clang" CACHE FILEPATH "WSL Clang23 ASM")
foreach(language IN ITEMS C CXX ASM)
    set(CMAKE_${language}_COMPILER_TARGET aarch64-linux-ohos)
endforeach()
set(CMAKE_CXX_COMPILER_CLANG_SCAN_DEPS "${AWJ_OHOS_LLVM_ROOT}/bin/clang-scan-deps" CACHE FILEPATH "匹配的 LLVM23 扫描器")
set(CMAKE_AR "${AWJ_OHOS_LLVM_ROOT}/bin/llvm-ar" CACHE FILEPATH "LLVM23 ar")
set(CMAKE_RANLIB "${AWJ_OHOS_LLVM_ROOT}/bin/llvm-ranlib" CACHE FILEPATH "LLVM23 ranlib")
set(CMAKE_NM "${AWJ_OHOS_LLVM_ROOT}/bin/llvm-nm" CACHE FILEPATH "LLVM23 nm")
set(CMAKE_STRIP "${AWJ_OHOS_LLVM_ROOT}/bin/llvm-strip" CACHE FILEPATH "LLVM23 strip")
set(CMAKE_SYSROOT "${AWJ_OHOS_NATIVE_ROOT}/sysroot")
# Clang OHOS 的探测结果未提供 multiarch 名称；查库须与驱动实际目标目录一致。
set(CMAKE_LIBRARY_ARCHITECTURE aarch64-linux-ohos)
list(APPEND CMAKE_SYSTEM_LIBRARY_PATH "${CMAKE_SYSROOT}/usr/lib/aarch64-linux-ohos")
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CMAKE_FIND_ROOT_PATH "${AWJ_OHOS_NATIVE_ROOT}" "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(_awj_ohos_runtime "${AWJ_OHOS_NATIVE_ROOT}/llvm/lib/aarch64-linux-ohos")
set(_awj_ohos_flags "-fno-emulated-tls -D__MUSL__ -resource-dir=\"${AWJ_OHOS_RESOURCE_DIR}\" -B\"${AWJ_OHOS_RESOURCE_DIR}/lib/aarch64-linux-ohos\"")
string(APPEND CMAKE_C_FLAGS_INIT " ${_awj_ohos_flags} -D_GNU_SOURCE=1")
string(APPEND CMAKE_ASM_FLAGS_INIT " ${_awj_ohos_flags}")
string(APPEND CMAKE_CXX_FLAGS_INIT " ${_awj_ohos_flags} -stdlib=libc++ -nostdinc++ -isystem \"${AWJ_OHOS_NATIVE_ROOT}/llvm/include/libcxx-ohos/include/c++/v1\"")
set(_awj_ohos_link "-fuse-ld=\"${AWJ_OHOS_LLVM_ROOT}/bin/ld.lld\" --rtlib=compiler-rt -unwindlib=none -nostdlib++ -L\"${_awj_ohos_runtime}\" -Wl,--no-undefined,-z,now,-z,relro")
foreach(kind IN ITEMS EXE SHARED MODULE)
    string(APPEND CMAKE_${kind}_LINKER_FLAGS_INIT " ${_awj_ohos_link}")
endforeach()
set(CMAKE_C_STANDARD_LIBRARIES_INIT "-lm")
set(CMAKE_CXX_STANDARD_LIBRARIES_INIT "\"${_awj_ohos_runtime}/libc++_static.a\" \"${_awj_ohos_runtime}/libunwind.a\" -lm")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
    AWJ_OHOS_NATIVE_ROOT AWJ_OHOS_RESOURCE_DIR AWJ_OHOS_LLVM_ROOT)
