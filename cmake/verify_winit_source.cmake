# 完整官方 crate 清单与已识别补丁分开校验，缓存中其余源码也不能静默变化。
if(NOT DEFINED SOURCE_DIR OR NOT DEFINED EXPECTED_ARCHIVE_SHA256)
    message(FATAL_ERROR "winit source verification requires SOURCE_DIR and EXPECTED_ARCHIVE_SHA256")
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/winit-source-manifest.json" manifest)
string(JSON archive_sha GET "${manifest}" archive_sha256)
if(NOT archive_sha STREQUAL EXPECTED_ARCHIVE_SHA256)
    message(FATAL_ERROR "winit manifest archive identity differs from the dependency lock")
endif()
string(JSON count LENGTH "${manifest}" files)
math(EXPR last "${count} - 1")
set(expected_files "")
foreach(index RANGE ${last})
    string(JSON name MEMBER "${manifest}" files ${index})
    list(APPEND expected_files "${name}")
    if(IS_SYMLINK "${SOURCE_DIR}/${name}" OR NOT EXISTS "${SOURCE_DIR}/${name}")
        message(FATAL_ERROR "winit source file missing or symlinked: ${name}")
    endif()
    if(name STREQUAL "src/platform_impl/windows/dark_mode.rs" OR
       name STREQUAL "src/platform_impl/windows/event_loop.rs")
        continue()
    endif()
    string(JSON expected GET "${manifest}" files "${name}")
    file(SHA256 "${SOURCE_DIR}/${name}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "winit official source hash mismatch: ${name}")
    endif()
endforeach()
file(GLOB_RECURSE actual_files LIST_DIRECTORIES FALSE RELATIVE "${SOURCE_DIR}" "${SOURCE_DIR}/*")
list(SORT expected_files)
list(SORT actual_files)
if(NOT actual_files STREQUAL expected_files)
    message(FATAL_ERROR "winit source contains unexpected or missing files")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${SOURCE_DIR}"
    -DAWJ_WINIT_VERIFY_ONLY=ON -P "${CMAKE_CURRENT_LIST_DIR}/patch_winit_dpi.cmake"
    COMMAND_ERROR_IS_FATAL ANY)
message(STATUS "winit complete official source manifest and local patch state verified")
