if(NOT AWJ_TARGET_SYSTEM STREQUAL "OHOS")
    return()
endif()
if(NOT DEFINED SOURCE_DIR OR SOURCE_DIR STREQUAL "")
    message(FATAL_ERROR "SOURCE_DIR is required")
endif()
set(path "${SOURCE_DIR}/CMakeLists.txt")
file(READ "${path}" content)
string(REPLACE "\r\n" "\n" content "${content}")
set(original [=[elseif(${CMAKE_SYSTEM_NAME} MATCHES "FreeBSD")]=])
set(patched [=[elseif(${CMAKE_SYSTEM_NAME} MATCHES "FreeBSD")
elseif(CMAKE_SYSTEM_NAME STREQUAL "OHOS")]=])
string(FIND "${content}" "${patched}" found)
if(found GREATER_EQUAL 0)
    return()
endif()
string(FIND "${content}" "${original}" found)
if(found LESS 0)
    message(FATAL_ERROR "libultrahdr OHOS CPU platform adapter needs upstream review")
endif()
string(REPLACE "${original}" "${patched}" content "${content}")
file(WRITE "${path}" "${content}")
