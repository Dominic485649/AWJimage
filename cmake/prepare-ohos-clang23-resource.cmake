cmake_minimum_required(VERSION 3.30)
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "资源适配只在 WSL/Linux 原生环境执行")
endif()
get_filename_component(repo "${CMAKE_CURRENT_LIST_DIR}/.." REALPATH)
foreach(name IN ITEMS WORK_ROOT NATIVE_SDK_DIRECTORY LLVM_DIRECTORY RESOURCE_DIRECTORY)
    if(NOT DEFINED ${name} OR NOT IS_ABSOLUTE "${${name}}")
        message(FATAL_ERROR "必须显式提供绝对路径：${name}")
    endif()
    file(REAL_PATH "${${name}}" ${name})
    if("${${name}}" MATCHES "^/mnt/[A-Za-z](/|$)")
        message(FATAL_ERROR "构建输入须先复制并核验到原生文件系统：${name}")
    endif()
endforeach()
if(NOT WORK_ROOT STREQUAL repo AND NOT "${WORK_ROOT}/src" STREQUAL repo)
    message(FATAL_ERROR "WORK_ROOT 必须属于当前 AWJimage 源码")
endif()
foreach(protected IN ITEMS NATIVE_SDK_DIRECTORY LLVM_DIRECTORY)
    cmake_path(IS_PREFIX ${protected} "${RESOURCE_DIRECTORY}" NORMALIZE modifies_input)
    if(modifies_input)
        message(FATAL_ERROR "资源目录不得写入原始 SDK 或 LLVM 安装")
    endif()
endforeach()
cmake_path(IS_PREFIX WORK_ROOT "${RESOURCE_DIRECTORY}" NORMALIZE inside)
if(NOT inside OR RESOURCE_DIRECTORY STREQUAL WORK_ROOT OR
    RESOURCE_DIRECTORY STREQUAL repo)
    message(FATAL_ERROR "资源目录必须位于项目专属工作根下")
endif()
file(READ "${NATIVE_SDK_DIRECTORY}/oh-uni-package.json" metadata)
string(JSON sdk_version GET "${metadata}" version)
string(JSON sdk_api GET "${metadata}" apiVersion)
if(NOT sdk_version STREQUAL "26.0.0.105" OR NOT sdk_api STREQUAL "26")
    message(FATAL_ERROR "此资源适配限定 Native26.0.0.105 / API26")
endif()
set(libcxx "${NATIVE_SDK_DIRECTORY}/llvm/include/libcxx-ohos/include/c++/v1")
file(READ "${libcxx}/__config" config)
file(READ "${libcxx}/__config_site" site)
if(NOT config MATCHES "#[ \t]*define[ \t]+_LIBCPP_VERSION[ \t]+15004([^0-9]|$)" OR
    NOT site MATCHES "#[ \t]*define[ \t]+_LIBCPP_ABI_VERSION[ \t]+1([^0-9]|$)" OR
    NOT site MATCHES "#[ \t]*define[ \t]+_LIBCPP_ABI_NAMESPACE[ \t]+__n1([^A-Za-z0-9_]|$)")
    message(FATAL_ERROR "必须使用原始 OHOS libc++15004 / ABI1 / __n1 头")
endif()
set(clang "${LLVM_DIRECTORY}/bin/clang++")
execute_process(COMMAND "${clang}" --version RESULT_VARIABLE result
    OUTPUT_VARIABLE banner ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT result EQUAL 0 OR NOT banner MATCHES "clang version 23\\.[0-9]+\\.[0-9]+([^0-9.]|$)")
    message(FATAL_ERROR "要求真实 WSL Clang23：${error}")
endif()
execute_process(COMMAND "${clang}" -print-resource-dir RESULT_VARIABLE result
    OUTPUT_VARIABLE clang_resource OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT result EQUAL 0 OR NOT IS_DIRECTORY "${clang_resource}/include")
    message(FATAL_ERROR "无法定位所选 Clang23 自带头文件")
endif()
set(runtime "${NATIVE_SDK_DIRECTORY}/llvm/lib/clang/15.0.4/lib/aarch64-linux-ohos")
set(names include lib/aarch64-linux-ohos/libclang_rt.builtins.a
    lib/aarch64-linux-ohos/crtbegin.o lib/aarch64-linux-ohos/crtbeginS.o
    lib/aarch64-linux-ohos/crtbeginT.o lib/aarch64-linux-ohos/crtend.o
    lib/aarch64-linux-ohos/crtendS.o)
set(inputs "${clang_resource}/include" "${runtime}/libclang_rt.builtins.a"
    "${runtime}/clang_rt.crtbegin.o" "${runtime}/clang_rt.crtbegin.o"
    "${runtime}/clang_rt.crtbegin.o" "${runtime}/clang_rt.crtend.o"
    "${runtime}/clang_rt.crtend.o")
# 只创建私有目录中的符号链接；不改已安装 SDK，也不生成替代运行库。
foreach(input IN LISTS inputs)
    if(NOT EXISTS "${input}")
        message(FATAL_ERROR "缺少原始资源输入：${input}")
    endif()
endforeach()
foreach(name input IN ZIP_LISTS names inputs)
    set(link "${RESOURCE_DIRECTORY}/${name}")
    if(EXISTS "${link}" OR IS_SYMLINK "${link}")
        file(REAL_PATH "${link}" actual)
        file(REAL_PATH "${input}" expected)
        if(NOT IS_SYMLINK "${link}" OR NOT actual STREQUAL expected)
            message(FATAL_ERROR "现有资源不是对应输入的链接，保留现场并拒绝覆盖：${link}")
        endif()
    endif()
endforeach()
file(MAKE_DIRECTORY "${RESOURCE_DIRECTORY}/lib/aarch64-linux-ohos")
foreach(name input IN ZIP_LISTS names inputs)
    set(link "${RESOURCE_DIRECTORY}/${name}")
    if(NOT IS_SYMLINK "${link}")
        file(CREATE_LINK "${input}" "${link}" SYMBOLIC RESULT error)
        if(NOT error STREQUAL "0")
            message(FATAL_ERROR "无法创建资源链接：${error}")
        endif()
    endif()
endforeach()
message(STATUS "已核对 Clang23 头与 Native26 原始 CRT/builtins：${RESOURCE_DIRECTORY}")
