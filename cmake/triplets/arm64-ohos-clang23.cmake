set(VCPKG_TARGET_ARCHITECTURE arm64)
set(VCPKG_CRT_LINKAGE static)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_CMAKE_SYSTEM_NAME OHOS)
set(VCPKG_BUILD_TYPE release)
set(VCPKG_CHAINLOAD_TOOLCHAIN_FILE "${CMAKE_CURRENT_LIST_DIR}/../toolchains/ohos-clang23.cmake")
set(VCPKG_MAKE_BUILD_TRIPLET "--host=aarch64-unknown-linux-ohos")
set(VCPKG_CMAKE_CONFIGURE_OPTIONS -DCMAKE_PLATFORM_NO_VERSIONED_SONAME=ON)
set(VCPKG_ENV_PASSTHROUGH
    AWJ_OHOS_NATIVE_ROOT AWJ_OHOS_RESOURCE_DIR AWJ_OHOS_LLVM_ROOT AWJ_OHOS_INPUT_ID)
