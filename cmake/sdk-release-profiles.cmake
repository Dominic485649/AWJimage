# Shared by the formal packager and fixture-only contract tests. No compiler,
# toolchain, runner, or executable path is ever obtained from evidence JSON.
include_guard(GLOBAL)
# Huawei's driver spelling and Clang's canonical spelling denote the same OHOS
# target. Evidence/output triples remain strictly canonical, independently.
set(AWJ_SDK_HMOS_COMPILER_TARGET_PATTERN "^aarch64-(unknown-)?linux-ohos$")

function(assert_under base path)
    file(REAL_PATH "${base}" base_real)
    file(REAL_PATH "${path}" path_real)
    cmake_path(IS_PREFIX base_real "${path_real}" NORMALIZE inside)
    if(NOT inside OR path_real STREQUAL base_real)
        message(FATAL_ERROR "路径越过项目工作范围：${path}")
    endif()
endfunction()

function(awj_sdk_read_file path limit out)
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
        message(FATAL_ERROR "SDK 证据文件不存在：${path}")
    endif()
    file(SIZE "${path}" size)
    if(size EQUAL 0 OR size GREATER limit)
        message(FATAL_ERROR "SDK 证据文件为空或过大：${path}")
    endif()
    file(READ "${path}" text)
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

function(awj_sdk_json_get out json type)
    string(JSON actual_type ERROR_VARIABLE error TYPE "${json}" ${ARGN})
    if(NOT error STREQUAL "NOTFOUND" OR NOT actual_type STREQUAL type)
        message(FATAL_ERROR "SDK 证据字段类型无效：${ARGN}，要求 ${type}")
    endif()
    string(JSON value GET "${json}" ${ARGN})
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(awj_sdk_json_expect json type expected)
    awj_sdk_json_get(value "${json}" "${type}" ${ARGN})
    if(NOT value STREQUAL expected)
        message(FATAL_ERROR "SDK 证据字段不匹配：${ARGN}")
    endif()
endfunction()

function(awj_sdk_require_hash value label)
    string(LENGTH "${value}" length)
    if(NOT length EQUAL 64 OR NOT value MATCHES "^[0-9a-f]+$")
        message(FATAL_ERROR "SDK SHA256 无效：${label}")
    endif()
endfunction()

function(awj_sdk_check_file_hash json path)
    awj_sdk_json_get(expected "${json}" STRING ${ARGN})
    awj_sdk_require_hash("${expected}" "${ARGN}")
    file(SHA256 "${path}" actual)
    if(NOT expected STREQUAL actual)
        message(FATAL_ERROR "SDK 文件摘要不匹配：${ARGN}")
    endif()
endfunction()

function(awj_sdk_json_quote out value)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${out} "\"${value}\"" PARENT_SCOPE)
endfunction()

# Only the exact 1.3.0 release may use an implicit host-default Clang 21.
# In particular, the internal legacy Linux name is NOT an accepted CLI profile.
function(awj_sdk_select_profile version requested host processor out)
    if(NOT version MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
        message(FATAL_ERROR "SDK VERSION 必须为三段版本")
    endif()
    set(legacy FALSE)
    if(requested STREQUAL "")
        if(NOT version STREQUAL "1.3.0")
            message(FATAL_ERROR "1.3.1+ SDK 正式打包必须显式指定 TARGET_PROFILE")
        endif()
        set(legacy TRUE)
        if(host STREQUAL "Windows")
            set(profile windows-x64-clang21)
        elseif(host STREQUAL "Linux")
            set(profile linux-x64-clang21)
        else()
            message(FATAL_ERROR "SDK profile 不支持此 host")
        endif()
    else()
        set(profile "${requested}")
        if(version STREQUAL "1.3.0" AND profile STREQUAL "windows-x64-clang21")
            set(legacy TRUE)
        elseif(NOT profile MATCHES "^(windows-x64-msvc|linux-x64-clang23|hmos-arm64-api26-clang23)$")
            message(FATAL_ERROR "未知 TARGET_PROFILE：${profile}")
        endif()
    endif()
    set(hmos FALSE)
    set(family Clang)
    set(llvm_major 23)
    if(profile STREQUAL "windows-x64-msvc")
        set(expected_host Windows)
        set(platform windows-x64)
        set(family MSVC)
        set(major 19)
        set(triple x86_64-pc-windows-msvc)
        set(archive AWJ_SDK_Win_x64.zip)
        set(library bin/awj_sdk.dll)
        set(stream bin/awj-stream.exe)
    elseif(profile STREQUAL "windows-x64-clang21")
        set(expected_host Windows)
        set(platform windows-x64)
        set(major 21)
        set(triple x86_64-pc-windows-msvc)
        set(archive AWJ_SDK_Win_x64.zip)
        set(library bin/awj_sdk.dll)
        set(stream bin/awj-stream.exe)
    elseif(profile MATCHES "^linux-x64-clang(21|23)$")
        set(expected_host Linux)
        set(platform linux-x64)
        set(major "${CMAKE_MATCH_1}")
        set(triple x86_64-pc-linux-gnu)
        set(archive AWJ_SDK_Linux_x64.tar.gz)
        set(library "lib/libawj_sdk.so.${version}")
        set(stream bin/awj-stream)
    else()
        set(expected_host Linux)
        set(hmos TRUE)
        set(platform hmos-arm64-api26)
        set(major 23)
        set(triple aarch64-unknown-linux-ohos)
        set(archive AWJ_SDK_HMOS_arm64_api26.tar.gz)
        set(library lib/libawj_sdk.so)
        set(stream "")
    endif()
    string(TOLOWER "${processor}" processor)
    if(NOT host STREQUAL expected_host)
        message(FATAL_ERROR "SDK profile 与 host 不匹配：${profile} 要求 ${expected_host} host")
    endif()
    # Desktop verification executes native x64 programs; never infer emulation.
    if(NOT hmos AND NOT processor MATCHES "^(amd64|x86_64|x64)$")
        message(FATAL_ERROR "桌面 SDK profile 要求原生 x64 host")
    endif()
    if(family STREQUAL "Clang")
        set(llvm_major "${major}")
    endif()
    foreach(field IN ITEMS profile platform family major llvm_major triple archive library stream legacy hmos)
        set(${out}_${field} "${${field}}" PARENT_SCOPE)
    endforeach()
endfunction()

function(awj_sdk_parse_compiler_banner banner major out)
    if(NOT banner MATCHES "clang version ([0-9]+\\.[0-9]+\\.[0-9]+)([^0-9.]|$)")
        message(FATAL_ERROR "可信编译器未返回完整 Clang 三段版本")
    endif()
    set(version "${CMAKE_MATCH_1}")
    if(NOT version MATCHES "^${major}\\.[0-9]+\\.[0-9]+$")
        message(FATAL_ERROR "真实 Clang 版本不符合 SDK profile：${version}，要求 ${major}")
    endif()
    set(${out} "${version}" PARENT_SCOPE)
endfunction()

function(awj_sdk_find_llvm_tool out name major)
    unset(tool)
    if(DEFINED LLVM_DIRECTORY AND NOT LLVM_DIRECTORY STREQUAL "")
        if(NOT IS_ABSOLUTE "${LLVM_DIRECTORY}" OR NOT IS_DIRECTORY "${LLVM_DIRECTORY}")
            message(FATAL_ERROR "LLVM_DIRECTORY 必须为可信 CLI 指定的绝对目录")
        endif()
        find_program(tool NAMES "${name}" "${name}-${major}"
            PATHS "${LLVM_DIRECTORY}" "${LLVM_DIRECTORY}/bin" NO_DEFAULT_PATH NO_CACHE REQUIRED)
    else()
        find_program(tool NAMES "${name}-${major}" "${name}" NO_CACHE REQUIRED)
    endif()
    # Do not resolve the driver symlink before executing it: clang++'s argv[0]
    # selects C++ linking mode even when it shares clang's underlying binary.
    set(${out} "${tool}" PARENT_SCOPE)
endfunction()

function(awj_sdk_parse_msvc_banner banner out)
    string(REGEX MATCH "^[^\r\n]*" first_line "${banner}")
    if(NOT first_line MATCHES "^Microsoft \\(R\\).* ([0-9]+\\.[0-9]+\\.[0-9]+) .*x64")
        message(FATAL_ERROR "可信编译器未返回完整 MSVC x64 版本，不能用 clang-cl 或 ABI 标签替代")
    endif()
    set(version "${CMAKE_MATCH_1}")
    if(NOT version MATCHES "^19\\.")
        message(FATAL_ERROR "MSVC 编译器版本不符合 Windows SDK profile")
    endif()
    set(${out} "${version}" PARENT_SCOPE)
endfunction()

function(awj_sdk_compiler_identity prefix out)
    unset(compiler)
    unset(linker)
    set(linker_hash "")
    set(linker_version "")
    if(${prefix}_family STREQUAL "MSVC")
        if(NOT IS_ABSOLUTE "${MSVC_DIRECTORY}" OR NOT IS_DIRECTORY "${MSVC_DIRECTORY}")
            message(FATAL_ERROR "MSVC_DIRECTORY 必须为可信 CLI 指定的绝对 MSVC 工具目录")
        endif()
        find_program(compiler NAMES cl PATHS "${MSVC_DIRECTORY}" NO_DEFAULT_PATH NO_CACHE REQUIRED)
        find_program(linker NAMES link PATHS "${MSVC_DIRECTORY}" NO_DEFAULT_PATH NO_CACHE REQUIRED)
        execute_process(COMMAND "${compiler}" /? RESULT_VARIABLE result
            OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "可信 MSVC 身份探测失败")
        endif()
        string(CONCAT text "${stdout}" "\n" "${stderr}")
        string(REGEX MATCH "(^|[\r\n])(Microsoft \\(R\\)[^\r\n]*)" banner_line "${text}")
        set(banner "${CMAKE_MATCH_2}")
        awj_sdk_parse_msvc_banner("${banner}" compiler_version)
        execute_process(COMMAND "${linker}" /? RESULT_VARIABLE result
            OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
        # Microsoft link /? 使用帮助退出码 1100，不是一次真实链接。
        if(NOT result EQUAL 0 AND NOT result EQUAL 1100)
            message(FATAL_ERROR "可信 MSVC 链接器身份探测失败")
        endif()
        string(CONCAT text "${stdout}" "\n" "${stderr}")
        string(REGEX MATCH "(^|[\r\n])(Microsoft \\(R\\)[^\r\n]*)" banner_line "${text}")
        set(linker_banner "${CMAKE_MATCH_2}")
        if(NOT linker_banner MATCHES "^Microsoft \\(R\\).* ([0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+)")
            message(FATAL_ERROR "可信 MSVC 链接器版本缺失")
        endif()
        set(linker_version "${CMAKE_MATCH_1}")
        file(SHA256 "${linker}" linker_hash)
    else()
        set(linker "")
        if(${prefix}_platform STREQUAL "windows-x64")
            set(driver clang-cl)
        else()
            set(driver clang++)
        endif()
        awj_sdk_find_llvm_tool(compiler "${driver}" "${${prefix}_major}")
        execute_process(COMMAND "${compiler}" --version RESULT_VARIABLE result
            OUTPUT_VARIABLE banner ERROR_VARIABLE error OUTPUT_STRIP_TRAILING_WHITESPACE TIMEOUT 30)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "可信 Clang 身份探测失败：${error}")
        endif()
        # Preserve the entire banner, including Ubuntu snapshot revision/suffix.
        awj_sdk_parse_compiler_banner("${banner}" "${${prefix}_major}" compiler_version)
    endif()
    file(SHA256 "${compiler}" compiler_hash)
    foreach(field IN ITEMS compiler banner compiler_version compiler_hash linker linker_hash linker_version)
        set(${out}_${field} "${${field}}" PARENT_SCOPE)
    endforeach()
endfunction()

function(awj_sdk_required_tests prefix out)
    set(names sdk_core sdk_c_abi)
    if(NOT ${prefix}_legacy)
        list(APPEND names sdk_native_encode sdk_pixel_conversion sdk_borrowed_yuv sdk_stdlib_contract sdk_codec_worker_failure)
        if(NOT ${prefix}_hmos)
            list(APPEND names sdk_portable_stdlib_contract sdk_shared_memory sdk_ffmpeg)
            if(${prefix}_platform STREQUAL "windows-x64")
                list(APPEND names sdk_d3d11 sdk_d3d11_shared)
            else()
                list(APPEND names sdk_stream_cli)
            endif()
        endif()
    endif()
    set(${out} "${names}" PARENT_SCOPE)
endfunction()

function(awj_sdk_validate_msvc_release_proof proof compiler_version compiler_hash)
    awj_sdk_json_expect("${proof}" STRING MSVC compiler_id)
    awj_sdk_json_expect("${proof}" STRING MSVC toolchain compiler_id)
    awj_sdk_json_expect("${proof}" STRING "${compiler_version}" toolchain compiler_version)
    awj_sdk_json_expect("${proof}" STRING "${compiler_hash}" toolchain compiler_sha256)
    if(NOT compiler_version MATCHES "^19\\.[0-9]+\\.[0-9]+$")
        message(FATAL_ERROR "Windows SDK 要求真实 MSVC 编译器版本")
    endif()
    awj_sdk_json_get(linker_version "${proof}" STRING toolchain linker_version)
    awj_sdk_json_get(linker_hash "${proof}" STRING toolchain linker_sha256)
    if(NOT linker_version MATCHES "^14\\.[0-9]+\\.[0-9]+\\.[0-9]+$")
        message(FATAL_ERROR "MSVC linker_version 无效")
    endif()
    awj_sdk_require_hash("${linker_hash}" linker_sha256)
    awj_sdk_json_expect("${proof}" STRING cmake-generated-target-profile toolchain flags_source)
    awj_sdk_json_get(targets "${proof}" ARRAY toolchain targets)
    string(JSON count LENGTH "${targets}")
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "MSVC SDK 必须绑定实际 awj_sdk 最终链接目标")
    endif()
    awj_sdk_json_expect("${targets}" STRING awj_sdk 0 name)
    awj_sdk_json_expect("${targets}" STRING Release 0 configuration)
    awj_sdk_json_expect("${targets}" STRING MultiThreaded 0 runtime)
    awj_sdk_json_expect("${targets}" STRING x64 0 minimum_cpu)
    awj_sdk_json_expect("${targets}" BOOLEAN ON 0 ipo)
    awj_sdk_json_get(profile_hash "${targets}" STRING 0 profile_sha256)
    awj_sdk_require_hash("${profile_hash}" profile_sha256)
    foreach(kind IN ITEMS compile link)
        awj_sdk_json_get(flags "${targets}" ARRAY 0 "${kind}_flags")
        string(JSON count LENGTH "${flags}")
        set(actual)
        if(count GREATER 0)
            math(EXPR last "${count} - 1")
            foreach(index RANGE 0 ${last})
                awj_sdk_json_get(flag "${flags}" STRING "${index}")
                if(flag MATCHES "^/(Od|O1|Os|Ob[01]|(GL|Oi|Ot|Gy|Gw|GF)-|MDd?|fp:fast|LTCG:OFF|INCREMENTAL(:YES)?|OPT:(NOREF|NOICF))$")
                    message(FATAL_ERROR "MSVC Release 存在优化降档或运行库/浮点覆盖参数")
                endif()
                list(APPEND actual "${flag}")
            endforeach()
        endif()
        if(kind STREQUAL "compile")
            set(required /O2 /Ob2 /Oi /Ot /Gy /Gw /GF /GL /MT)
        else()
            set(required /LTCG /OPT:REF /OPT:ICF /INCREMENTAL:NO)
        endif()
        foreach(flag IN LISTS required)
            if(NOT flag IN_LIST actual)
                message(FATAL_ERROR "MSVC Release 优化降档或缺少参数：${flag}")
            endif()
        endforeach()
    endforeach()
endfunction()

function(awj_sdk_validate_build_proof proof prefix version head fingerprint library_hash test_hash compiler_version compiler_hash)
    awj_sdk_json_expect("${proof}" NUMBER 1 schema)
    foreach(field IN ITEMS mode platform version git_head source_fingerprint compiler_version library_sha256 test_report_sha256)
        if(field STREQUAL "mode")
            set(expected formal)
        elseif(field STREQUAL "platform")
            set(expected "${${prefix}_platform}")
        elseif(field STREQUAL "git_head")
            set(expected "${head}")
        elseif(field STREQUAL "source_fingerprint")
            set(expected "${fingerprint}")
        elseif(field STREQUAL "library_sha256")
            set(expected "${library_hash}")
        elseif(field STREQUAL "test_report_sha256")
            set(expected "${test_hash}")
        else()
            set(expected "${${field}}")
        endif()
        awj_sdk_json_expect("${proof}" STRING "${expected}" "${field}")
    endforeach()
    if(${prefix}_family STREQUAL "MSVC")
        awj_sdk_validate_msvc_release_proof("${proof}" "${compiler_version}" "${compiler_hash}")
    else()
        awj_sdk_parse_compiler_banner("clang version ${compiler_version}" "${${prefix}_major}" ignored)
    endif()
    awj_sdk_json_expect("${proof}" BOOLEAN OFF source_dirty)
    awj_sdk_json_expect("${proof}" BOOLEAN ON native_codecs)
    awj_sdk_json_expect("${proof}" BOOLEAN ON compiled_source_verified)
    if(NOT ${prefix}_legacy)
        awj_sdk_json_expect("${proof}" STRING "${${prefix}_profile}" profile)
        awj_sdk_json_expect("${proof}" STRING "${${prefix}_triple}" target_triple)
        awj_sdk_json_expect("${proof}" NUMBER 1 abi)
        awj_sdk_require_hash("${compiler_hash}" compiler_sha256)
        awj_sdk_json_expect("${proof}" STRING "${compiler_hash}" compiler_sha256)
        awj_sdk_json_get(encoders "${proof}" ARRAY encoders)
        string(JSON count LENGTH "${encoders}")
        set(actual)
        if(NOT count EQUAL 5)
            message(FATAL_ERROR "SDK 必须包含完整五编码器")
        endif()
        foreach(index RANGE 0 4)
            awj_sdk_json_get(encoder "${encoders}" STRING "${index}")
            list(APPEND actual "${encoder}")
        endforeach()
        list(SORT actual)
        if(NOT "${actual}" STREQUAL "avif;jpegli;jxl;png;webp")
            message(FATAL_ERROR "SDK 必须包含完整五编码器")
        endif()
        foreach(feature IN ITEMS d3d11 shm ffmpeg stream)
            if(${prefix}_hmos OR (feature STREQUAL "d3d11" AND NOT ${prefix}_platform STREQUAL "windows-x64"))
                set(expected OFF)
            else()
                set(expected ON)
            endif()
            awj_sdk_json_expect("${proof}" BOOLEAN "${expected}" features "${feature}")
        endforeach()
        if(${prefix}_hmos)
            awj_sdk_json_expect("${proof}" BOOLEAN OFF features gpu)
            awj_sdk_hmos_metadata("${proof}")
        endif()
    endif()
endfunction()

function(awj_sdk_hmos_metadata json)
    awj_sdk_json_expect("${json}" STRING "26.0.0.105" native_sdk_version)
    awj_sdk_json_expect("${json}" NUMBER 26 api)
    awj_sdk_json_expect("${json}" NUMBER 15004 libcxx_version)
    awj_sdk_json_expect("${json}" NUMBER 1 libcxx_abi_version)
    awj_sdk_json_expect("${json}" STRING __n1 libcxx_abi_namespace)
    awj_sdk_json_expect("${json}" STRING native-static runtime_linkage)
endfunction()

function(awj_sdk_xml_attribute out tag field optional)
    string(REGEX MATCHALL "[ \t\r\n]${field}=\"[^\"]*\"" matches "${tag}")
    list(LENGTH matches count)
    if(count EQUAL 0 AND optional)
        set(${out} "" PARENT_SCOPE)
        return()
    endif()
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "SDK JUnit 属性缺失或重复：${field}")
    endif()
    list(GET matches 0 attr)
    string(REGEX REPLACE "^[^=]+=\"([^\"]*)\"$" "\\1" value "${attr}")
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

# CTest's single-testsuite JUnit dialect. Check the actual named testcase set,
# not merely root counters; reject nested suites, duplicate names and skip/error
# elements even when a report claims all counters are zero.
function(awj_sdk_validate_junit path required_names)
    awj_sdk_read_file("${path}" 16777216 xml)
    if(xml MATCHES "<!DOCTYPE|<!ENTITY|<failure[ \t\r\n/>]|<error[ \t\r\n/>]|<skipped[ \t\r\n/>]|<disabled[ \t\r\n/>]")
        message(FATAL_ERROR "SDK JUnit 包含失败、禁用、跳过或不安全 XML")
    endif()
    string(STRIP "${xml}" xml)
    if(xml MATCHES "^<\\?xml[^>]*\\?>")
        string(REGEX REPLACE "^<\\?xml[^>]*\\?>[ \t\r\n]*" "" xml "${xml}")
    endif()
    string(REGEX MATCH "^<testsuite[ \t\r\n][^>]*>" suite "${xml}")
    if(suite STREQUAL "" OR NOT xml MATCHES "</testsuite>[ \t\r\n]*$")
        message(FATAL_ERROR "SDK JUnit 必须是完整单 testsuite 报告")
    endif()
    foreach(field IN ITEMS tests failures disabled skipped errors)
        if(field STREQUAL "errors")
            set(optional TRUE)
        else()
            set(optional FALSE)
        endif()
        awj_sdk_xml_attribute(value "${suite}" "${field}" "${optional}")
        if(optional AND value STREQUAL "")
            continue()
        endif()
        if(NOT value MATCHES "^[0-9]+$")
            message(FATAL_ERROR "SDK JUnit 计数无效：${field}")
        endif()
        if(field STREQUAL "tests")
            set(expected_count "${value}")
        elseif(NOT value EQUAL 0)
            message(FATAL_ERROR "SDK JUnit 存在失败、禁用或跳过：${field}")
        endif()
    endforeach()
    string(LENGTH "${suite}" length)
    string(SUBSTRING "${xml}" ${length} -1 body)
    string(REGEX REPLACE "</testsuite>[ \t\r\n]*$" "" body "${body}")
    set(names)
    while(TRUE)
        string(STRIP "${body}" body)
        if(body STREQUAL "")
            break()
        endif()
        string(REGEX MATCH "^<testcase[ \t\r\n][^>]*>" testcase "${body}")
        if(testcase STREQUAL "")
            message(FATAL_ERROR "SDK JUnit 包含无效或嵌套的 testcase")
        endif()
        awj_sdk_xml_attribute(name "${testcase}" name FALSE)
        awj_sdk_xml_attribute(status "${testcase}" status TRUE)
        if(NOT name MATCHES "^[A-Za-z0-9_.-]+$" OR name IN_LIST names OR
            (NOT status STREQUAL "" AND NOT status STREQUAL "run"))
            message(FATAL_ERROR "SDK JUnit testcase 名称重复或状态不是 run：${name}")
        endif()
        foreach(field IN ITEMS disabled skipped failures errors)
            awj_sdk_xml_attribute(value "${testcase}" "${field}" TRUE)
            if(NOT value STREQUAL "" AND NOT value STREQUAL "0" AND NOT value STREQUAL "false")
                message(FATAL_ERROR "SDK JUnit testcase 存在失败、禁用或跳过：${name} ${field}")
            endif()
        endforeach()
        list(APPEND names "${name}")
        string(LENGTH "${testcase}" length)
        string(SUBSTRING "${body}" ${length} -1 body)
        if(NOT testcase MATCHES "/>$")
            string(FIND "${body}" "</testcase>" end)
            if(end LESS 0)
                message(FATAL_ERROR "SDK JUnit testcase 未闭合")
            endif()
            string(SUBSTRING "${body}" 0 ${end} content)
            if(content MATCHES "<testcase|<testsuite|</testsuite>")
                message(FATAL_ERROR "SDK JUnit testcase 非法嵌套")
            endif()
            math(EXPR end "${end} + 11")
            string(SUBSTRING "${body}" ${end} -1 body)
        endif()
    endwhile()
    list(LENGTH names count)
    if(NOT count EQUAL expected_count OR count LESS 2)
        message(FATAL_ERROR "SDK JUnit 实际 testcase 与计数不一致")
    endif()
    foreach(name IN LISTS required_names)
        if(NOT name IN_LIST names)
            message(FATAL_ERROR "SDK JUnit 缺少必需测试：${name}")
        endif()
    endforeach()
endfunction()

function(check_tree directory)
    file(GLOB_RECURSE entries LIST_DIRECTORIES true RELATIVE "${directory}" "${directory}/*")
    list(LENGTH entries count)
    if(count GREATER 4096)
        message(FATAL_ERROR "SDK 安装树包含过多成员")
    endif()
    foreach(relative IN LISTS entries)
        if(relative MATCHES "[;\r\n\\\\]" OR NOT EXISTS "${directory}/${relative}")
            message(FATAL_ERROR "SDK 安装成员路径无效：${relative}")
        endif()
        assert_under("${directory}" "${directory}/${relative}")
        string(TOLOWER "${relative}" lower)
        if(lower MATCHES "(^|/)(release-signing\\.local\\.json|[^/]*(secret|seed|private[-_]?key)[^/]*)$"
            OR lower MATCHES "\\.(pem|pfx|key|seed|pcm|pch|pdb)$"
            OR lower MATCHES "(^|/)[^/]*\\.a$"
            OR lower MATCHES "(^|/)(lib)?(avutil|avcodec|avformat|avdevice|avfilter|swscale|swresample|postproc)[^/]*\\.(dll|so)(\\.[^/]*)?$")
            message(FATAL_ERROR "SDK 出现非分发成员：${relative}")
        endif()
        if(IS_SYMLINK "${directory}/${relative}" AND
            (IS_DIRECTORY "${directory}/${relative}" OR NOT EXISTS "${directory}/${relative}"))
            message(FATAL_ERROR "SDK 符号链接无效：${relative}")
        endif()
    endforeach()
endfunction()

function(awj_sdk_check_install directory prefix)
    check_tree("${directory}")
    set(required "${${prefix}_library}" include/awj/awj.h lib/cmake/AWJimage/AWJimageConfig.cmake
        share/AWJimage/LICENSE share/AWJimage/THIRD_PARTY_NOTICES.txt
        share/AWJimage/sdk.md share/AWJimage/examples/basic/CMakeLists.txt)
    set(headers awj.h)
    if(NOT ${prefix}_hmos)
        list(APPEND required "${${prefix}_stream}" include/awj/awj_shm.h include/awj/awj_ffmpeg.h)
        list(APPEND headers awj_shm.h awj_ffmpeg.h)
        if(${prefix}_platform STREQUAL "windows-x64")
            list(APPEND required include/awj/awj_d3d11.h)
            list(APPEND headers awj_d3d11.h)
        endif()
    else()
        file(GLOB libraries RELATIVE "${directory}" "${directory}/lib/libawj_sdk.so*")
        if(NOT "${libraries}" STREQUAL "lib/libawj_sdk.so" OR IS_SYMLINK "${directory}/lib/libawj_sdk.so")
            message(FATAL_ERROR "HMOS SDK 必须使用真正的无版本 lib/libawj_sdk.so 文件")
        endif()
        if(EXISTS "${directory}/bin/awj-stream" OR EXISTS "${directory}/bin/awj-stream.exe")
            message(FATAL_ERROR "HMOS SDK 不得分发 stream 工具")
        endif()
    endif()
    foreach(path IN LISTS required)
        if(NOT EXISTS "${directory}/${path}" OR IS_DIRECTORY "${directory}/${path}")
            message(FATAL_ERROR "完整 SDK 安装缺少 ${path}")
        endif()
    endforeach()
    file(GLOB_RECURSE actual_headers LIST_DIRECTORIES false RELATIVE "${directory}/include/awj" "${directory}/include/awj/*")
    list(SORT headers)
    list(SORT actual_headers)
    if(NOT "${headers}" STREQUAL "${actual_headers}")
        message(FATAL_ERROR "SDK 安装头集合不符合 profile：${actual_headers}")
    endif()
endfunction()

# Parse only trusted llvm-readobj output. Dependency allowlists also enforce
# desktop static C++ runtime isolation and the HMOS original native-static ABI.
function(awj_sdk_check_binary_text prefix text)
    set(consumer FALSE)
    if(ARGC GREATER 2 AND ARGV2 STREQUAL "consumer")
        set(consumer TRUE)
    endif()
    if(${prefix}_platform STREQUAL "windows-x64")
        set(format COFF-x86-64)
        set(arch x86_64)
        string(REGEX MATCHALL "[\r\n][ \t]*Name: [^\r\n]+" imports "${text}")
        set(dependencies)
        foreach(import IN LISTS imports)
            string(REGEX REPLACE "^[\r\n \t]*Name: " "" dependency "${import}")
            string(STRIP "${dependency}" dependency)
            string(TOLOWER "${dependency}" dependency)
            list(APPEND dependencies "${dependency}")
        endforeach()
    else()
        if(${prefix}_hmos)
            set(format elf64-littleaarch64)
            set(arch aarch64)
        else()
            set(format elf64-x86-64)
            set(arch x86_64)
        endif()
        string(REGEX MATCH "NeededLibraries \\[([^]]*)\\]" needed "${text}")
        if(needed STREQUAL "")
            message(FATAL_ERROR "SDK 缺少真实 ELF 依赖检查结果")
        endif()
        set(needed "${CMAKE_MATCH_1}")
        string(REPLACE "\n" ";" lines "${needed}")
        set(dependencies)
        foreach(line IN LISTS lines)
            string(STRIP "${line}" dependency)
            if(NOT dependency STREQUAL "")
                list(APPEND dependencies "${dependency}")
            endif()
        endforeach()
        if(text MATCHES "(RPATH|RUNPATH)[^\r\n]*(/usr/|/home/|/mnt/|[A-Za-z]:[/\\\\])")
            message(FATAL_ERROR "SDK ELF 依赖包含宿主绝对运行路径")
        endif()
        if(${prefix}_hmos AND text MATCHES "(RPATH|RUNPATH)")
            message(FATAL_ERROR "HMOS SDK 不得携带宿主 RPATH/RUNPATH")
        endif()
    endif()
    string(FIND "${text}" "Format: ${format}\n" found_format)
    string(FIND "${text}" "Arch: ${arch}\n" found_arch)
    if(found_format LESS 0 OR found_arch LESS 0 OR NOT text MATCHES "AddressSize: 64bit")
        message(FATAL_ERROR "SDK 最终库架构与目标 profile 不匹配")
    endif()
    if(NOT dependencies)
        message(FATAL_ERROR "SDK 缺少真实动态加载依赖")
    endif()
    if(NOT consumer)
        if(${prefix}_platform STREQUAL "windows-x64")
            if(NOT text MATCHES "IMAGE_FILE_DLL")
                message(FATAL_ERROR "Windows SDK 最终库必须是真实 DLL")
            endif()
        else()
            if(NOT text MATCHES "Type: SharedObject")
                message(FATAL_ERROR "SDK 最终库必须是真实 ELF shared object")
            endif()
            if(${prefix}_hmos)
                set(soname "libawj_sdk\\.so")
            else()
                set(soname "libawj_sdk\\.so\\.1")
            endif()
            if(NOT text MATCHES "SONAME[^\r\n]*\\[${soname}\\]")
                message(FATAL_ERROR "SDK 最终库 SONAME 与公共 ABI/profile 不匹配")
            endif()
        endif()
    endif()
    foreach(dependency IN LISTS dependencies)
        if(${prefix}_platform STREQUAL "windows-x64")
            if(NOT dependency MATCHES "^((api-ms-win-|ext-ms-win-)[a-z0-9_.-]+|kernel32|ntdll|user32|gdi32|advapi32|bcrypt|crypt32|ole32|oleaut32|shell32|shlwapi|ws2_32|d3d11|dxgi|dcomp|d2d1|dwrite|windowsapp|propsys|setupapi|winmm|version|rpcrt4|sechost|dbghelp|ucrtbase|msvcrt|vcruntime140(_1)?|msvcp140(_[a-z0-9]+)?|concrt140)\\.dll$")
                message(FATAL_ERROR "SDK 存在非系统/非静态依赖：${dependency}")
            endif()
        elseif(${prefix}_hmos)
            if(consumer AND dependency STREQUAL "libawj_sdk.so")
                continue()
            endif()
            if(NOT dependency MATCHES "^lib(c|m|dl)\\.so$")
                message(FATAL_ERROR "HMOS SDK 引入非 Native 静态闭包依赖：${dependency}")
            endif()
        elseif(NOT dependency MATCHES "^(lib(c|m|pthread|dl|rt)\\.so\\.[0-9]+|libatomic\\.so\\.1|ld-linux-x86-64\\.so\\.2)$")
            message(FATAL_ERROR "Linux SDK 引入非系统/动态 C++ 运行库依赖：${dependency}")
        endif()
    endforeach()
    if(consumer AND NOT "libawj_sdk.so" IN_LIST dependencies)
        message(FATAL_ERROR "HMOS 安装消费者没有加载本次 SDK")
    endif()
    if(${prefix}_hmos AND NOT "libc.so" IN_LIST dependencies)
        message(FATAL_ERROR "HMOS SDK 未绑定 Native libc.so")
    elseif(${prefix}_platform STREQUAL "linux-x64" AND NOT "libc.so.6" IN_LIST dependencies)
        message(FATAL_ERROR "Linux SDK 未绑定 GNU/Linux libc.so.6")
    endif()
endfunction()

function(awj_sdk_check_binary path prefix readobj log)
    file(READ "${path}" magic LIMIT 4 HEX)
    if(${prefix}_platform STREQUAL "windows-x64")
        if(NOT magic MATCHES "^4d5a")
            message(FATAL_ERROR "Windows SDK 文件不是 PE 映像")
        endif()
        set(arguments --file-headers --coff-imports)
    else()
        if(NOT magic STREQUAL "7f454c46")
            message(FATAL_ERROR "SDK 文件不是 ELF 映像（不能以 archive/脚本替代）")
        endif()
        set(arguments --file-headers --needed-libs --dynamic-table)
    endif()
    execute_process(COMMAND "${readobj}" ${arguments} "${path}" RESULT_VARIABLE result
        OUTPUT_VARIABLE text ERROR_VARIABLE error TIMEOUT 60)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "读取 SDK 最终库身份失败：${error}")
    endif()
    string(REPLACE "\r\n" "\n" text "${text}")
    awj_sdk_check_binary_text("${prefix}" "${text}" ${ARGN})
    file(WRITE "${log}" "${text}")
endfunction()

function(awj_sdk_check_hmos_link_map text libcxx unwind)
    foreach(path IN ITEMS "${libcxx}" "${unwind}")
        string(FIND "${text}" "${path}(" found)
        if(found LESS 0)
            message(FATAL_ERROR "HMOS link map 缺少原始静态闭包成员：${path}")
        endif()
    endforeach()
    string(REGEX MATCHALL "[^ \t\r\n()]+lib(c\\+\\+[^/ \t\r\n()]*|unwind)\\.a" archives "${text}")
    foreach(archive IN LISTS archives)
        if(NOT archive STREQUAL libcxx AND NOT archive STREQUAL unwind)
            message(FATAL_ERROR "HMOS link map 使用了替代/experimental/宿主运行库：${archive}")
        endif()
    endforeach()
    if(text MATCHES "libstdc\\+\\+|libc\\+\\+experimental|libgcc_s|libc\\+\\+_shared|libunwind\\.so")
        message(FATAL_ERROR "HMOS link map 引入了非 Native 静态运行库")
    endif()
endfunction()

# These paths are CLI inputs, never read from BUILD_EVIDENCE. The map itself is
# data, is source/library-bound by the build record, and is never included/run.
function(awj_sdk_hmos_native_inputs proof work readobj out)
    foreach(input IN ITEMS TARGET_CMAKE_TOOLCHAIN_FILE TARGET_NATIVE_SDK_DIRECTORY TARGET_LINK_MAP)
        if(NOT DEFINED ${input} OR NOT IS_ABSOLUTE "${${input}}" OR NOT EXISTS "${${input}}")
            message(FATAL_ERROR "HMOS 正式打包缺少可信绝对 CLI 路径：${input}")
        endif()
    endforeach()
    if(IS_DIRECTORY "${TARGET_CMAKE_TOOLCHAIN_FILE}" OR IS_DIRECTORY "${TARGET_LINK_MAP}")
        message(FATAL_ERROR "HMOS toolchain/link map 必须是文件")
    endif()
    assert_under("${work}" "${TARGET_LINK_MAP}")
    awj_sdk_check_file_hash("${proof}" "${TARGET_CMAKE_TOOLCHAIN_FILE}" toolchain_sha256)
    awj_sdk_check_file_hash("${proof}" "${TARGET_LINK_MAP}" link_map_sha256)
    file(REAL_PATH "${TARGET_NATIVE_SDK_DIRECTORY}" native)
    awj_sdk_read_file("${native}/oh-uni-package.json" 1048576 sdk)
    awj_sdk_json_expect("${sdk}" STRING "26.0.0.105" version)
    awj_sdk_json_expect("${sdk}" STRING "26" apiVersion)
    set(config "${native}/llvm/include/libcxx-ohos/include/c++/v1/__config")
    set(site "${native}/llvm/include/libcxx-ohos/include/c++/v1/__config_site")
    assert_under("${native}" "${config}")
    assert_under("${native}" "${site}")
    awj_sdk_read_file("${config}" 1048576 config_text)
    awj_sdk_read_file("${site}" 1048576 site_text)
    if(NOT config_text MATCHES "#[ \t]*define[ \t]+_LIBCPP_VERSION[ \t]+15004([^0-9]|$)"
        OR NOT site_text MATCHES "#[ \t]*define[ \t]+_LIBCPP_ABI_VERSION[ \t]+1([^0-9]|$)"
        OR NOT site_text MATCHES "#[ \t]*define[ \t]+_LIBCPP_ABI_NAMESPACE[ \t]+__n1([^A-Za-z0-9_]|$)")
        message(FATAL_ERROR "HMOS 原始 Native libc++ 头版本/ABI namespace 不匹配")
    endif()
    awj_sdk_check_file_hash("${proof}" "${config}" libcxx_config_sha256)
    awj_sdk_check_file_hash("${proof}" "${site}" libcxx_config_site_sha256)
    set(libcxx "${native}/llvm/lib/aarch64-linux-ohos/libc++_static.a")
    set(unwind "${native}/llvm/lib/aarch64-linux-ohos/libunwind.a")
    foreach(archive IN ITEMS libcxx unwind)
        assert_under("${native}" "${${archive}}")
        if(NOT EXISTS "${${archive}}" OR IS_DIRECTORY "${${archive}}")
            message(FATAL_ERROR "HMOS 缺少原始 Native 静态运行库：${archive}")
        endif()
        file(READ "${${archive}}" archive_magic LIMIT 8 HEX)
        if(NOT archive_magic STREQUAL "213c617263683e0a")
            message(FATAL_ERROR "HMOS 必须使用原始完整静态 archive，不能替换成 thin archive/对象/脚本")
        endif()
        execute_process(COMMAND "${readobj}" --file-headers "${${archive}}" RESULT_VARIABLE result
            OUTPUT_VARIABLE headers ERROR_VARIABLE error TIMEOUT 60)
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "HMOS 原始静态运行库读取失败：${error}")
        endif()
        string(REGEX MATCHALL "Arch: [^\r\n]+" architectures "${headers}")
        if(NOT architectures)
            message(FATAL_ERROR "HMOS 原始静态运行库没有真实目标对象")
        endif()
        foreach(architecture IN LISTS architectures)
            if(NOT architecture STREQUAL "Arch: aarch64")
                message(FATAL_ERROR "HMOS 原始静态运行库包含错误架构")
            endif()
        endforeach()
    endforeach()
    awj_sdk_check_file_hash("${proof}" "${libcxx}" libcxx_static_sha256)
    awj_sdk_check_file_hash("${proof}" "${unwind}" libunwind_sha256)
    awj_sdk_read_file("${TARGET_LINK_MAP}" 67108864 map)
    awj_sdk_check_hmos_link_map("${map}" "${libcxx}" "${unwind}")
    set(${out}_native "${native}" PARENT_SCOPE)
endfunction()

function(awj_sdk_bound_attachment json field directory work out_path out_text)
    awj_sdk_json_get(relative "${json}" STRING "${field}" path)
    if(NOT relative MATCHES "^[A-Za-z0-9][A-Za-z0-9_.-]*$")
        message(FATAL_ERROR "目标执行附件路径必须为同目录普通文件名：${field}")
    endif()
    set(path "${directory}/${relative}")
    assert_under("${work}" "${path}")
    assert_under("${directory}" "${path}")
    if(IS_SYMLINK "${path}")
        message(FATAL_ERROR "目标执行附件不得为符号链接：${field}")
    endif()
    awj_sdk_read_file("${path}" 16777216 text)
    awj_sdk_check_file_hash("${json}" "${path}" "${field}" sha256)
    set(${out_path} "${path}" PARENT_SCOPE)
    set(${out_text} "${text}" PARENT_SCOPE)
endfunction()

function(awj_sdk_require_log_line text line)
    string(REPLACE "\r\n" "\n" normalized "${text}")
    string(REPLACE "\n" ";" lines "${normalized}")
    if(NOT line IN_LIST lines)
        message(FATAL_ERROR "目标原始日志缺少绑定事件：${line}")
    endif()
endfunction()

# Expected consumer records are computed from freshly built, extracted files by
# the caller, not copied out of this report. Attachments are data-only, bounded,
# SHA-bound files beside the explicitly supplied report, within WORK_ROOT.
function(awj_sdk_verify_target_execution path work prefix version head fingerprint library_hash test_hash consumers out)
    if(path STREQUAL "" OR NOT EXISTS "${path}")
        message(FATAL_ERROR "HMOS 缺少真实目标执行证据；不能把 host/cross-link 当作目标通过")
    endif()
    assert_under("${work}" "${path}")
    awj_sdk_read_file("${path}" 1048576 evidence)
    get_filename_component(directory "${path}" DIRECTORY)
    awj_sdk_json_expect("${evidence}" NUMBER 1 schema)
    awj_sdk_json_expect("${evidence}" STRING target-execution kind)
    awj_sdk_json_expect("${evidence}" STRING formal mode)
    awj_sdk_json_expect("${evidence}" STRING passed status)
    awj_sdk_json_expect("${evidence}" STRING "${${prefix}_profile}" profile)
    awj_sdk_json_expect("${evidence}" STRING "${${prefix}_triple}" target_triple)
    awj_sdk_json_expect("${evidence}" NUMBER 1 abi)
    awj_sdk_hmos_metadata("${evidence}")
    awj_sdk_json_expect("${evidence}" STRING "${version}" version)
    awj_sdk_json_expect("${evidence}" STRING "${head}" git_head)
    awj_sdk_json_expect("${evidence}" STRING "${fingerprint}" source_fingerprint)
    awj_sdk_json_expect("${evidence}" STRING "${library_hash}" library_sha256)
    awj_sdk_json_expect("${evidence}" STRING "${test_hash}" test_report_sha256)
    awj_sdk_json_expect("${evidence}" STRING OHOS target system_name)
    awj_sdk_json_expect("${evidence}" NUMBER 26 target api)
    awj_sdk_json_expect("${evidence}" STRING arm64-v8a target abi)
    awj_sdk_json_expect("${evidence}" STRING aarch64 target process_arch)
    awj_sdk_json_get(system_build "${evidence}" STRING target system_build)
    string(LENGTH "${system_build}" build_length)
    if(build_length LESS 4 OR build_length GREATER 256 OR system_build MATCHES "[;\r\n]")
        message(FATAL_ERROR "HMOS 目标证据缺少真实系统 build 标识")
    endif()
    awj_sdk_json_expect("${evidence}" STRING "${library_hash}" loader loaded_library_sha256)
    awj_sdk_json_expect("${evidence}" NUMBER 0 loader unresolved_symbols)
    awj_sdk_json_expect("${evidence}" BOOLEAN OFF loader host_runtime_loaded)
    awj_sdk_json_expect("${evidence}" BOOLEAN ON loader dlopen)
    awj_sdk_json_expect("${evidence}" BOOLEAN ON loader dlsym_awj_version)
    awj_sdk_json_expect("${evidence}" BOOLEAN ON loader dlsym_awj_abi_version)
    awj_sdk_json_expect("${evidence}" STRING "${version}" loader version)
    awj_sdk_json_expect("${evidence}" NUMBER 1 loader abi)
    awj_sdk_json_get(reported_consumers "${evidence}" OBJECT consumers)
    string(JSON consumer_count LENGTH "${reported_consumers}")
    if(NOT consumer_count EQUAL 3)
        message(FATAL_ERROR "HMOS 目标证据必须包含三个实际安装消费者")
    endif()
    foreach(name IN ITEMS installed_c_consumer installed_cxx_consumer installed_cxx17_consumer)
        awj_sdk_json_get(hash "${consumers}" STRING "${name}" sha256)
        awj_sdk_json_get(standard "${consumers}" STRING "${name}" standard)
        awj_sdk_require_hash("${hash}" "${name}")
        awj_sdk_json_expect("${evidence}" STRING "${hash}" consumers "${name}" sha256)
        awj_sdk_json_expect("${evidence}" STRING "${standard}" consumers "${name}" standard)
        awj_sdk_json_expect("${evidence}" NUMBER 0 consumers "${name}" exit_code)
    endforeach()
    foreach(field IN ITEMS sdk_test_log consumer_report consumer_log loader_log)
        awj_sdk_bound_attachment("${evidence}" "${field}" "${directory}" "${work}" "${field}_path" "${field}_text")
    endforeach()
    set(consumer_names installed_c_consumer installed_cxx_consumer installed_cxx17_consumer)
    awj_sdk_validate_junit("${consumer_report_path}" "${consumer_names}")
    file(SHA256 "${consumer_report_path}" consumer_hash)
    awj_sdk_json_expect("${evidence}" STRING "${consumer_hash}" consumer_report_sha256)
    foreach(line IN ITEMS "system_name=OHOS" "system_build=${system_build}" "api=26" "abi=arm64-v8a"
        "library_sha256=${library_hash}" "source_fingerprint=${fingerprint}" "test_report_sha256=${test_hash}")
        awj_sdk_require_log_line("${sdk_test_log_text}" "${line}")
        awj_sdk_require_log_line("${consumer_log_text}" "${line}")
        awj_sdk_require_log_line("${loader_log_text}" "${line}")
    endforeach()
    awj_sdk_required_tests("${prefix}" sdk_tests)
    foreach(name IN LISTS sdk_tests)
        awj_sdk_require_log_line("${sdk_test_log_text}" "test:${name}=exit:0")
    endforeach()
    foreach(name IN LISTS consumer_names)
        awj_sdk_json_get(hash "${consumers}" STRING "${name}" sha256)
        awj_sdk_require_log_line("${consumer_log_text}" "consumer:${name}:sha256=${hash}:exit=0")
    endforeach()
    awj_sdk_require_log_line("${consumer_log_text}" "consumer_report_sha256=${consumer_hash}")
    foreach(line IN ITEMS dlopen=success dlsym_awj_version=success dlsym_awj_abi_version=success
        "awj_version=${version}" awj_abi_version=1 unresolved_symbols=0
        host_runtime_loaded=false libcxx_version=15004 libcxx_abi_version=1 libcxx_abi_namespace=__n1)
        awj_sdk_require_log_line("${loader_log_text}" "${line}")
    endforeach()
    file(SHA256 "${path}" report_hash)
    set(${out}_report_hash "${report_hash}" PARENT_SCOPE)
    set(${out}_consumer_hash "${consumer_hash}" PARENT_SCOPE)
endfunction()
