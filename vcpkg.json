{
  "name": "awjimage",
  "version": "1.3.7",
  "dependencies": [
    "aom",
    "dav1d",
    {
      "name": "curl",
      "default-features": false,
      "features": [
        "ssl"
      ],
      "platform": "!windows"
    },
    "giflib",
    "libjpeg-turbo",
    "libarchive",
    "libjxl",
    "lcms",
    "libplacebo",
    "libsodium",
    "libpng",
    {
      "name": "libraw",
      "features": [
        "dng-lossy"
      ]
    },
    "libwebp",
    {
      "name": "libyuv",
      "platform": "windows"
    },
    "scnlib",
    "nlohmann-json",
    {
      "name": "tiff",
      "features": [
        "jpeg"
      ]
    }
  ]
}
