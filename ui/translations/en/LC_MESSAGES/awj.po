msgstr "Context menu speed"

msgid "0-10，留空默认"
msgstr "0-10, empty for default"

msgid "AVIF/WebP/JXL 可用；其他格式会忽略。"
msgstr "Available for AVIF/WebP/JXL; other formats ignore it."

msgid "右键色度采样"
msgstr "Context menu chroma subsampling"

msgid "AVIF/JPGLI 可用；其他格式会忽略。"
msgstr "Available for AVIF/JPGLI; other formats ignore it."

msgid "右键透明通道"
