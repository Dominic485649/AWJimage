msgstr "Context menu AVIF encoder"

msgid "右键质量"
msgstr "Context menu quality"

msgid "右键转换固定使用编码质量；PNG 始终无损。"
msgstr "Context menu conversion always uses the encode quality; PNG is always lossless."

msgid "右键位深"
msgstr "Context menu bit depth"

msgid "留空保持原片"
msgstr "Leave empty to keep source"

msgid "不适用的格式会在保存/转换时忽略或按格式规则校验。"
msgstr "Formats this does not apply to ignore it on save/convert, or validate it against the format rules."

