msgid "仅 AVIF 可用；JPGLI 不支持强制保留透明通道。"
msgstr "Available for AVIF only; JPGLI cannot force-keep the alpha channel."

msgid "右键 JPGLI 渐进级别"
msgstr "Context menu JPGLI progressive level"

msgid "关闭为顺序 JPEG；普通和更细使用渐进编码。"
msgstr "Off writes sequential JPEG; normal and finer use progressive encoding."

msgid "哈夫曼表"
msgstr "Huffman tables"

msgid "渐进 JPEG 会自动启用哈夫曼表优化。"
msgstr "Progressive JPEG enables Huffman table optimization automatically."

msgid "JPGLI 实验选项。"
msgstr "Experimental JPGLI option."

msgid "右键图片尺寸限制"
msgstr "Context menu image size limit"

msgid "手动限制会取宽、高、长边、短边中最严格的缩小比例。"
msgstr "A manual limit uses the strictest downscale ratio among width, height, long edge and short edge."

