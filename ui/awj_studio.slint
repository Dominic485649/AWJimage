                if root.selected-page == 4 && root.show-update-changelog: ScrollView {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    viewport-width: parent.width;
                    viewport-height: max(parent.height, changelog-content.preferred-height + 48px);
                    Rectangle {
                        border-radius: 8px;
                        background: root.panel-bg;
                        border-color: root.panel-border;
                        border-width: 1px;
                        height: max(parent.height, changelog-content.preferred-height + 48px);
                        changelog-content := VerticalLayout {
                            padding: 24px;
                            spacing: 14px;
                            HorizontalLayout {
                                height: 34px;
                                spacing: 14px;
                                Text { text: @tr("更新日志"); color: root.text-strong; font-size: 22px; font-weight: 800; horizontal-stretch: 1; vertical-alignment: center; }
                                CheckBox {
                                    text: @tr("退出后隐藏更新日志");
                                    checked <=> root.hide-update-changelog-after-exit;
                                    toggled => { root.hide-update-changelog-after-exit-requested(self.checked); }
                                }
                                CheckBox {
                                    text: @tr("更新后显示更新日志");
                                    checked <=> root.show-update-changelog-after-update;
                                    toggled => { root.show-update-changelog-after-update-requested(self.checked); }
                                }
                            }
                            for entry in root.update-history: Rectangle {
                                border-radius: 8px;
                                background: root.panel-bg-soft;
                                border-color: root.panel-border;
                                border-width: 1px;
                                height: self.preferred-height;
                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text { text: "v" + entry.version; color: root.text-strong; font-size: 16px; font-weight: 800; }
                                        if !entry.channel.is-empty: Text { text: entry.channel; color: entry.channel == "prerelease" ? root.warning : root.success; font-size: 12px; font-weight: 800; vertical-alignment: center; }
                                        Text { text: entry.published-at; color: root.text-muted; font-size: 12px; horizontal-stretch: 1; horizontal-alignment: right; vertical-alignment: center; }
                                    }
                                    Text {
                                        text: root.language-index == 1 ? entry.changelog-en : entry.changelog-zh-cn;
                                        color: root.text-body;
                                        font-size: 13px;
                                        wrap: word-wrap;
                                        min-width: 0px;
                                        width: 100%;
                                        horizontal-stretch: 1;
                                        height: self.preferred-height;
                                    }
                                }
                            }
                        }
                    }
                }

