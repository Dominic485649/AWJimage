            TouchArea { width: parent.width; height: parent.height; }
            FocusScope {
                init => { self.focus(); }
                key-pressed(event) => { return accept; }
                key-released(event) => { return accept; }
            }
            Text {
                text: @tr("正在应用右键菜单设置；修改机器菜单时需要管理员权限。");
                color: root.text-strong;
                font-size: 16px;
                x: 24px; width: max(0px, parent.width - 48px);
                y: (parent.height - self.height) / 2;
                height: self.preferred-height;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }

        if root.preset-editor-open: PresetEditor {
    preset-editor-existing: root.preset-editor-existing;
