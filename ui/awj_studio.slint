export { ShellConvertWindow } from "shell_convert_window.slint";
import { Button, CheckBox, LineEdit, Palette, ScrollView, ListView, TextEdit } from "std-widgets.slint";
import { TaskRow, LargeImageRow, UpdateHistoryRow, ComboOption, SoftComboBox, SoftButton, NavItem, QueueMenuItem, ParamHint } from "studio_components.slint";
import { StudioTheme } from "studio_theme.slint";
// 保持原 awj_studio.slint 的 C++ 公共类型名不变；组件实现已拆到独立文件。
export { TaskRow, LargeImageRow, UpdateHistoryRow, ComboOption }

export component AwjStudio inherits Window {
    title: "AWJ Studio";
    icon: @image-url("logo.png");
    default-font-family: root.ui-font-family;
    preferred-width: 1220px;
    preferred-height: 800px;
    min-width: 820px;
    min-height: 560px;

    in-out property <string> input-path: "";
    in-out property <int> input-mode-index: 0;
    in-out property <string> output-dir: "";
    in-out property <int> format-index: 0;
    // 参数页选择的是正在编辑的对象；队列的预设选择独立保留在 queue-* 属性。
    in-out property <int> parameter-preset-index: 0;
    in property <[ComboOption]> parameter-preset-options: [{ text: @tr("内置默认"), enabled: true }];
    in property <string> parameter-preset-description: "";
    in-out property <bool> preset-editor-open: false;
    in-out property <string> preset-editor-name: "";
    in-out property <string> preset-editor-description: "";
    in-out property <string> preset-editor-error: "";
    in-out property <int> avif-encoder-index: 0;
    in-out property <int> avif-color-representation-index: 0;
    in property <[ComboOption]> avif-encoder-options: [{ text: @tr("自动"), enabled: true }, { text: "svt-av1-hdr", enabled: true }, { text: "aom", enabled: true }, { text: "zenrav1e", enabled: false }];
    in-out property <bool> experimental-encoders: true;
    in-out property <string> avif-quality-default: "";
    in-out property <string> webp-quality-default: "";
    in-out property <string> jxl-quality-default: "";
    in-out property <string> jpegli-quality-default: "";
    in-out property <string> png-quality-default: "";
    in-out property <string> webp-bit-depth-default: "";
    in-out property <string> quality-text: "80";
    in-out property <string> visual-quality-text: "";
    in-out property <bool> visual-quality-gpu: true;
    in-out property <string> visual-quality-gpu-help-text: @tr("默认启用 Direct3D 11 加速 visual_quality 的 luma、GMSD 与 MS-SSIM 指标；codec 编码/解码仍使用 native CPU 库，失败或小图会自动回退 CPU。");
    in-out property <bool> visual-quality-fallback: true;
    in-out property <bool> allow-wic-fallback: true;
    in-out property <bool> wic-ui-visible: true;
    in-out property <bool> quality-follows-format: true;
    in-out property <string> bit-depth-text: "";
    in-out property <bool> bit-depth-follows-format: true;
    in-out property <int> chroma-index: 0;
    in-out property <int> jpegli-progressive-index: 2;
    in-out property <bool> jpegli-optimize-huffman: true;
    in-out property <bool> jpegli-xyb: false;
    in-out property <int> alpha-policy-index: 1;
    in-out property <string> threads-text: "";
    in-out property <string> memory-limit-text: "";
    in-out property <bool> unlock-max-input-file-bytes: false;
    in-out property <int> size-limit-index: 0;
    in-out property <string> max-width-text: "";
    in-out property <string> max-height-text: "";
    in-out property <string> max-long-edge-text: "";
    in-out property <string> max-short-edge-text: "";
    in-out property <string> speed-text: "";
    in-out property <string> template-text: "";
    in-out property <bool> template-params-selected: false;
    in-out property <bool> template-date-selected: false;
    in-out property <bool> template-time-selected: false;
    in-out property <bool> template-rand-selected: false;
    in-out property <bool> template-hash8-selected: false;
    in-out property <bool> template-sha2568-selected: false;
    in-out property <int> collision-index: 0;
    in-out property <int> theme-index: 0;
    // 0 = 中文（msgid 原文），1 = English（bundled 翻译）。
    in-out property <int> language-index: 0;
    in property <string> current-version: "";
    in property <[UpdateHistoryRow]> update-history;
    in-out property <int> update-channel-index: 0;
    in-out property <bool> show-update-changelog-enabled: true;
    in-out property <bool> show-update-changelog: true;
    in-out property <bool> hide-update-changelog-after-exit: true;
    in-out property <bool> show-update-changelog-after-update: true;
    in-out property <bool> update-checking: false;
    in-out property <bool> update-available: false;
    in-out property <string> update-version: "";
    in-out property <string> update-published-at: "";
    in-out property <string> update-changelog-zh-cn: "";
    in-out property <string> update-changelog-en: "";
    in-out property <string> update-summary-zh-cn: "";
    in-out property <string> update-summary-en: "";
    in-out property <string> update-status: @tr("尚未检查");
    in-out property <string> update-last-successful-check: @tr("从未");
    in-out property <string> ui-font-family: "";
    in property <[ComboOption]> ui-font-options: [{ text: @tr("系统默认字体"), enabled: true }];
    in-out property <int> ui-font-index: 0;
    in-out property <bool> system-dark-mode: false;
    in-out property <bool> strip-metadata: false;
    // 队列级运行设置：点击“开始转换”时由 C++ 统一快照，不写入 AWJ.jsonc。
    in-out property <int> queue-format-index: 0;
    in-out property <int> queue-preset-index: 0;
    in property <[ComboOption]> queue-preset-options: [{ text: @tr("内置默认"), enabled: true }];
    in property <string> queue-preset-description: "";
    in-out property <bool> preserve-creation-time: false;
    in-out property <bool> preserve-modification-time: false;
    in-out property <bool> preserve-access-time: false;
    in property <bool> timestamp-ui-visible: true;
    in-out property <bool> write-summary: false;
    in-out property <bool> write-log: false;
    in-out property <string> context-menu-status: "";
    in-out property <string> context-menu-warning: "";
    in-out property <int> menu-format-index: 0;
    in-out property <string> menu-quality-text: "";
    in-out property <string> menu-bit-depth-text: "";
    in-out property <string> menu-speed-text: "";
    in-out property <int> menu-avif-encoder-index: 0;
    in-out property <int> menu-avif-color-representation-index: 0;
    in-out property <int> menu-chroma-index: 0;
    in-out property <bool> menu-install-avif-png-command: false;
    in-out property <int> menu-alpha-policy-index: 1;
    in-out property <int> menu-jpegli-progressive-index: 2;
    in-out property <bool> menu-jpegli-optimize-huffman: true;
    in-out property <bool> menu-jpegli-xyb: false;
    in-out property <bool> menu-strip-metadata: false;
    in-out property <bool> menu-allow-wic-fallback: true;
    in-out property <bool> menu-close-on-finish: true;
    in-out property <int> menu-size-limit-index: 0;
    in-out property <string> menu-max-width-text: "";
    in-out property <string> menu-max-height-text: "";
    in-out property <string> menu-max-long-edge-text: "";
    in-out property <string> menu-max-short-edge-text: "";
    in-out property <bool> running: false;
    // Windows Explorer 外部拖放由 C++ 原生 IDropTarget 驱动；这里只接收可视状态，
    // 不再从 Slint DropEvent/DataTransfer 解析文件系统路径。
    in-out property <bool> external-drag-active: false;
    in-out property <bool> external-drag-valid: false;
    in-out property <int> external-drag-item-count: 0;
    in-out property <bool> force-terminate-supported: true;
    in-out property <float> progress: 0.0;
    in-out property <string> status-text: @tr("就绪");
    in property <[TaskRow]> task-rows;
    in-out property <int> queue-pending-count: 0;
    in-out property <int> queue-running-count: 0;
    in-out property <int> queue-success-count: 0;
    in-out property <int> queue-failed-count: 0;
    in-out property <bool> queue-failed-only: false;
    in-out property <int> selected-queue-index: -1;
    in property <[LargeImageRow]> large-image-rows;
    in-out property <int> selected-large-image-index: -1;
    in-out property <int> queue-menu-index: -1;
    in-out property <length> queue-menu-x: 0px;
    in-out property <length> queue-menu-y: 0px;
    in-out property <length> queue-menu-origin-x: 0px;
    in-out property <length> queue-menu-origin-y: 0px;
    property <length> queue-menu-width: 216px;
    property <length> queue-menu-height: 338px;
    property <length> parameter-control-width: 210px;
    property <length> parameter-control-height: 38px;
    property <length> control-button-width: 86px;
    property <length> control-button-height: 38px;
    // 命名 token 中英语 "Params" 最宽；68px 包含 SoftButton 左右各 8px 的文本内边距，
    // 六个 token 共用该宽度，保证中英文在单行/双行布局中都不会因标签长度产生宽度差异。
    property <length> template-token-button-width: 68px;
    property <length> page-gap: 10px;
    property <length> nav-width: 196px;
    property <length> queue-filename-width: 170px;
    property <length> queue-size-width: 72px;
    property <length> queue-status-width: 104px;
    in-out property <int> pending-theme-index: -1;
    in-out property <int> combo-close-generation: 0;
    in-out property <bool> combo-popup-open: false;
    in-out property <bool> queue-menu-visible: false;
    in-out property <bool> queue-menu-opening: false;

    in-out property <int> selected-page: 1;
    property <int> chroma-index-before-forced: 0;
    property <bool> chroma-forced-by-avif-encoder: false;
    property <bool> dark-mode: root.theme-index == 2 || (root.theme-index == 0 && root.system-dark-mode);
    property <bool> pending-theme-dark-mode: root.pending-theme-index == 2 || (root.pending-theme-index == 0 && root.system-dark-mode);
    property <color> pending-theme-page-bg: StudioTheme.page-bg(root.pending-theme-dark-mode);
    property <color> page-bg: StudioTheme.page-bg(root.dark-mode);
    property <color> mica-tint: StudioTheme.mica-tint(root.dark-mode);
    property <color> nav-bg: StudioTheme.nav-bg(root.dark-mode);
    property <color> chrome-bg: StudioTheme.chrome-bg(root.dark-mode);
    property <color> panel-bg: StudioTheme.panel-bg(root.dark-mode);
    property <color> panel-bg-soft: StudioTheme.panel-bg-soft(root.dark-mode);
    property <color> panel-border: StudioTheme.panel-border(root.dark-mode);
    property <color> field-bg: StudioTheme.field-bg(root.dark-mode);
    property <color> field-border: StudioTheme.field-border(root.dark-mode);
    property <color> text-strong: StudioTheme.text-strong(root.dark-mode);
    property <color> text-body: StudioTheme.text-body(root.dark-mode);
    property <color> text-muted: StudioTheme.text-muted(root.dark-mode);
    property <color> text-soft: StudioTheme.text-soft(root.dark-mode);
    property <color> accent: StudioTheme.accent;
    property <color> accent-strong: StudioTheme.accent-strong(root.dark-mode);
    property <color> accent-soft: StudioTheme.accent-soft(root.dark-mode);
    property <color> success: StudioTheme.success;
    property <color> success-soft: StudioTheme.success-soft(root.dark-mode);
    property <color> warning: StudioTheme.warning;
    property <color> hint-blue: StudioTheme.hint-blue(root.dark-mode);
    property <color> hint-orange: StudioTheme.hint-orange(root.dark-mode);
    property <color> hint-green: StudioTheme.hint-green(root.dark-mode);
    property <color> hint-cyan: StudioTheme.hint-cyan(root.dark-mode);
    property <color> hint-red: StudioTheme.hint-red(root.dark-mode);
    property <color> hint-violet: StudioTheme.hint-violet(root.dark-mode);
    property <color> progress-track: StudioTheme.progress-track(root.dark-mode);
    property <brush> progress-fill: root.running ? StudioTheme.accent : StudioTheme.success;
    property <bool> queue-menu-valid: root.queue-menu-index >= 0 && root.queue-menu-index < root.task-rows.length;
    property <bool> queue-menu-editable: root.queue-menu-valid && !root.task-rows[root.queue-menu-index].locked;
    property <bool> queue-menu-removable: root.queue-menu-valid && !root.running;
    property <bool> selected-queue-valid: root.selected-queue-index >= 0 && root.selected-queue-index < root.task-rows.length;

    property <color> combo-bg: StudioTheme.combo-bg(root.dark-mode);
    property <color> combo-bg-hover: StudioTheme.combo-bg-hover(root.dark-mode);
    property <color> combo-bg-disabled: StudioTheme.combo-bg-disabled(root.dark-mode);
    property <color> combo-selected-bg: StudioTheme.combo-selected-bg(root.dark-mode);
    property <color> combo-border: StudioTheme.combo-border(root.dark-mode);
    property <color> combo-border-hover: StudioTheme.combo-border-hover(root.dark-mode);

    public function open-queue-menu(index: int, x: length, y: length) {
        if index >= 0 && index < root.task-rows.length {
            root.queue-menu-index = index;
            root.queue-menu-x = max(0px, min(root.width - root.queue-menu-width - 10px, x));
            root.queue-menu-y = max(0px, min(root.height - root.queue-menu-height - 10px, y));
            root.queue-menu-origin-x = max(0px, x - root.queue-menu-x);
            root.queue-menu-origin-y = max(0px, y - root.queue-menu-y);
            root.queue-menu-opening = false;
            root.queue-menu-visible = false;
            queue-menu-popup.show();
            root.queue-menu-opening = true;
        }
    }

    callback browse-input();
    callback input-path-accepted(string);
    callback input-path-dropped(DropEvent);
    callback browse-output();
    callback output-path-accepted(string);
    callback output-path-dropped(DropEvent);
    callback open-output();
    callback start-conversion();
    callback cancel-conversion();
    callback clear-tasks();
    callback retry-failed();
    callback queue-row-pointer-event(int, int, int, float);
    pure callback queue-drag-data(int) -> data-transfer;
    callback queue-drag-can-drop(DropEvent, int) -> DragAction;
    callback queue-drag-dropped(DropEvent, int) -> DragAction;
    callback queue-menu-action(int, string);
    callback combo-popup-requested();
    callback combo-popup-finished();
    callback theme-selection-requested(int, length, length);
    callback language-selection-requested(int);
    callback update-channel-selection-requested(int);
    callback show-update-changelog-requested(bool);
    callback hide-update-changelog-after-exit-requested(bool);
    callback show-update-changelog-after-update-requested(bool);
    callback version-clicked();
    callback browse-large-image-file();
    callback browse-large-image-folder();
    callback large-image-action-requested(int, string);
    callback format-defaults-requested(int);
    callback parameter-preset-selected(int);
    callback queue-preset-selected(int);
    callback open-preset-editor();
    callback save-parameter-preset(string, string);
    callback cancel-preset-editor();
    callback install-context-menu-requested();
    callback remove-context-menu-requested();
    callback save-menu-params-requested();
    callback menu-format-selected(int);
    callback context-menu-warning-clicked();
    callback toggle-template-token(string);
    callback title-bar-theme-requested(bool);

    init => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
        root.title-bar-theme-requested(root.dark-mode);
    }

    changed dark-mode => {
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
        root.title-bar-theme-requested(root.dark-mode);
    }

    changed format-index => {
        root.format-defaults-requested(root.format-index);
        if (!(root.format-index == 0 && root.avif-encoder-index == 1) && root.chroma-forced-by-avif-encoder) {
            root.chroma-index = root.chroma-index-before-forced;
            root.chroma-forced-by-avif-encoder = false;
        }
        if (root.format-index == 0 && root.avif-encoder-index == 1 && !root.chroma-forced-by-avif-encoder) {
            root.chroma-index-before-forced = root.chroma-index;
            root.chroma-index = 3;
            root.chroma-forced-by-avif-encoder = true;
        }
    }

    changed experimental-encoders => {
        root.format-defaults-requested(root.format-index);
    }

    changed jpegli-progressive-index => {
        if (root.jpegli-progressive-index > 0) {
            root.jpegli-optimize-huffman = true;
        }
    }

    changed menu-format-index => {
        root.menu-format-selected(root.menu-format-index);
    }

    changed ui-font-index => {
        root.ui-font-family = root.ui-font-index > 0 && root.ui-font-index < root.ui-font-options.length
            ? root.ui-font-options[root.ui-font-index].text
            : "";
    }

    changed show-update-changelog => {
        if (!root.show-update-changelog && root.selected-page == 4) {
            root.selected-page = 2;
        }
    }

    changed avif-encoder-index => {
        if (root.format-index == 0 && root.avif-encoder-index == 1) {
            if (!root.chroma-forced-by-avif-encoder) {
                root.chroma-index-before-forced = root.chroma-index;
                root.chroma-forced-by-avif-encoder = true;
            }
            root.chroma-index = 3;
        } else if (root.chroma-forced-by-avif-encoder) {
            root.chroma-index = root.chroma-index-before-forced;
            root.chroma-forced-by-avif-encoder = false;
        }
    }

    changed quality-text => {
        root.quality-follows-format =
            (root.format-index == 0 && root.quality-text == root.avif-quality-default)
            || (root.format-index == 1 && root.quality-text == root.webp-quality-default)
            || (root.format-index == 2 && root.quality-text == root.jxl-quality-default)
            || (root.format-index == 3 && root.quality-text == root.jpegli-quality-default)
            || (root.format-index == 4 && root.quality-text == root.png-quality-default);
    }

    changed bit-depth-text => {
        root.bit-depth-follows-format = (root.format-index == 1 || root.format-index == 3) ? root.bit-depth-text == root.webp-bit-depth-default : root.bit-depth-text.is-empty;
    }

    combo-popup-requested => {
        root.combo-close-generation = root.combo-close-generation + 1;
        root.combo-popup-open = true;
    }

    combo-popup-finished => {
        root.combo-popup-open = false;
    }

    theme-selection-requested(index, click-x, click-y) => {
        if (index != root.theme-index) {
            root.theme-index = index;
            root.pending-theme-index = -1;
        }
    }

    background: root.page-bg;

    Rectangle {
        background: root.page-bg;
        clip: true;
        animate background { duration: 180ms; easing: ease-out; }

        Rectangle {
            x: 0px;
            y: 0px;
            width: root.nav-width;
            height: parent.height;
            background: root.nav-bg;
            animate background { duration: 180ms; easing: ease-out; }
        }

        Rectangle {
            x: root.nav-width;
            y: 0px;
            width: 1px;
            height: parent.height;
            background: root.panel-border;
            animate background { duration: 180ms; easing: ease-out; }
        }

        Rectangle {
            x: root.nav-width + root.page-gap;
            y: root.page-gap;
            width: parent.width - root.nav-width - root.page-gap * 2;
            height: parent.height - root.page-gap * 2;
            border-radius: 8px;
            background: root.mica-tint;
            opacity: 0.56;
            animate background { duration: 180ms; easing: ease-out; }
        }

        HorizontalLayout {
            padding-top: root.page-gap;
            padding-bottom: root.page-gap;
            padding-right: root.page-gap;
            spacing: root.page-gap;

            Rectangle {
                width: root.nav-width;
                background: transparent;

                VerticalLayout {
                    padding: root.page-gap;
                    spacing: 10px;
                    accessible-role: navigation;
                    accessible-label: @tr("主导航");

                    Rectangle {
                        height: 78px;
                        background: transparent;
                        VerticalLayout {
                            spacing: 4px;
                            cross-axis-alignment: center;
                            Text { text: "AWJ Studio"; color: root.text-strong; font-size: 24px; font-weight: 900; letter-spacing: 0px; }
                            Rectangle {
                                // 标题本身保持居中；版本组合单独向左移 16px。
                                width: 88px;
                                height: 3px;
                                background: transparent;
                                Rectangle {
                                    width: 56px;
                                    height: parent.height;
                                    border-radius: 1.5px;
                                    background: #0f7c8c;
                                }
                            }
                            version-control := Rectangle {
                                width: 88px;
                                height: 25px;
                                background: transparent;
                                version-hit := Rectangle {
                                width: 56px;
                                height: parent.height;
                                border-radius: 5px;
                                background: version-touch.has-hover ? root.accent-soft : transparent;
                                accessible-role: button;
                                accessible-label: @tr("当前版本 ") + root.current-version;
                                accessible-action-default => { root.version-clicked(); }
                                Text {
                                    x: 7px;
                                    width: parent.width - 14px;
                                    text: "v" + root.current-version;
                                    color: root.accent-strong;
                                    font-size: 12px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                if root.update-available: Rectangle {
                                    x: parent.width - 9px;
                                    y: 2px;
                                    width: 7px;
                                    height: 7px;
                                    border-radius: 3.5px;
                                    background: #e5484d;
                                }
                                version-touch := TouchArea {
                                    clicked => { root.version-clicked(); }
                                    if root.update-available && root.show-update-changelog: Tooltip {
                                        text: @markdown("\{@tr("发现新版本 ")}\{root.update-version}\n\{@tr("点击版本号安装；完整说明见更新日志。")}");
                                    }
                                }
                                }
                            }
                        }
                    }

                    Rectangle { height: 8px; background: transparent; }

                    queue-nav := NavItem {
                        label: @tr("编码队列");
                        tab-index: 0;
                        selected: root.selected-page == 1;
                        normal-background: transparent;
                        hover-background: root.dark-mode ? #202b3a : #eef6ff;
                        selected-background: root.dark-mode ? #188697 : #0f7c8c;
                        normal-text: root.text-body;
                        selected-text: #ffffff;
                        clicked => { root.selected-page = 1; }
                        navigate(action) => {
                            if (action == "down") { params-nav.focus(); }
                            if (action == "home" || action == "up") { queue-nav.focus(); }
                            if (action == "end") { settings-nav.focus(); }
                        }
                    }
                    params-nav := NavItem {
                        label: @tr("参数设置");
                        tab-index: 1;
                        selected: root.selected-page == 0;
                        normal-background: transparent;
                        hover-background: root.dark-mode ? #202b3a : #eef6ff;
                        selected-background: root.dark-mode ? #188697 : #0f7c8c;
                        normal-text: root.text-body;
                        selected-text: #ffffff;
                        clicked => { root.selected-page = 0; }
                        navigate(action) => {
                            if (action == "up") { queue-nav.focus(); }
                            if (action == "down") { menu-nav.focus(); }
                            if (action == "home") { queue-nav.focus(); }
                            if (action == "end") { settings-nav.focus(); }
                        }
                    }
                    menu-nav := NavItem {
                        label: @tr("菜单参数");
                        tab-index: 2;
                        selected: root.selected-page == 3;
                        normal-background: transparent;
                        hover-background: root.dark-mode ? #202b3a : #eef6ff;
                        selected-background: root.dark-mode ? #188697 : #0f7c8c;
                        normal-text: root.text-body;
                        selected-text: #ffffff;
                        clicked => { root.selected-page = 3; }
                        navigate(action) => {
                            if (action == "up") { params-nav.focus(); }
                            if (action == "down") { if (root.show-update-changelog) { changelog-nav.focus(); } else { settings-nav.focus(); } }
                            if (action == "end") { settings-nav.focus(); }
                            if (action == "home") { queue-nav.focus(); }
                        }
                    }
                    changelog-nav := NavItem {
                        label: @tr("更新日志");
                        enabled: root.show-update-changelog;
                        tab-index: 3;
                        selected: root.selected-page == 4;
                        normal-background: transparent;
                        hover-background: root.dark-mode ? #202b3a : #eef6ff;
                        selected-background: root.dark-mode ? #188697 : #0f7c8c;
                        normal-text: root.text-body;
                        selected-text: #ffffff;
                        clicked => { root.selected-page = 4; }
                        navigate(action) => {
                            if (action == "up") { menu-nav.focus(); }
                            if (action == "down" || action == "end") { settings-nav.focus(); }
                            if (action == "home") { queue-nav.focus(); }
                        }
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }

                    settings-nav := NavItem {
                        label: @tr("设置");
                        tab-index: 4;
                        selected: root.selected-page == 2;
                        normal-background: transparent;
                        hover-background: root.dark-mode ? #202b3a : #eef6ff;
                        selected-background: root.dark-mode ? #188697 : #0f7c8c;
                        normal-text: root.text-body;
                        selected-text: #ffffff;
                        clicked => { root.selected-page = 2; }
                        navigate(action) => {
                            if (action == "up") { if (root.show-update-changelog) { changelog-nav.focus(); } else { menu-nav.focus(); } }
                            if (action == "home") { queue-nav.focus(); }
                            if (action == "down" || action == "end") { settings-nav.focus(); }
                        }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: transparent;

                if root.selected-page == 0: Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    background: transparent;

                    Rectangle {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        border-radius: 8px;
                        background: root.panel-bg;
                        border-color: root.panel-border;
                        border-width: 1px;
                        animate background, border-color { duration: 180ms; easing: ease-out; }

                        ScrollView {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            viewport-width: parent.width;
                            VerticalLayout {
                                padding: 22px;
                                spacing: 10px;
                                    VerticalLayout {
                                        spacing: 10px;

                                        HorizontalLayout {
                                            height: 36px;
                                            spacing: 10px;
                                            Text { text: @tr("常用参数"); color: root.text-strong; font-size: 15px; font-weight: 800; vertical-alignment: center; horizontal-stretch: 1; }
                                            parameter-preset := SoftComboBox {
                                                accessible-name: @tr("参数预设");
                                                viewport-height: root.height;
                                                close-generation: root.combo-close-generation;
                                                popup-requested => { root.combo-popup-requested(); }
                                                popup-finished => { root.combo-popup-finished(); }
                                                model: root.parameter-preset-options;
                                                current-index <=> root.parameter-preset-index;
                                                enabled: !root.running;
                                                width: 190px;
                                                height: 36px;
                                                normal-background: root.combo-bg;
                                                hover-background: root.combo-bg-hover;
                                                disabled-background: root.combo-bg-disabled;
                                                selected-background: root.combo-selected-bg;
                                                normal-border: root.combo-border;
                                                hover-border: root.combo-border-hover;
                                                normal-text: root.text-body;
                                                disabled-text: root.text-soft;
                                                muted-text: root.text-muted;
                                                selected-text: root.text-body;
                                                hover-help-text: root.parameter-preset-description;
                                                hover-help-always: true;
                                                selection-accepted(index, click-x, click-y) => {
                                                    root.parameter-preset-selected(index);
                                                }
                                            }
                                            SoftButton {
                                                dark-mode: root.dark-mode;
                                                text: @tr("保存预设");
                                                variant: "outline";
                                                width: 96px;
                                                height: 36px;
                                                enabled: !root.running;
                                                clicked => { root.open-preset-editor(); }
                                            }
                                        }
                                        HorizontalLayout {
                                            min-height: 72px;
                                            spacing: 10px;
                                            cross-axis-alignment: center;
                                            Text { text: @tr("编辑格式"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            SoftComboBox { accessible-name: @tr("编辑格式"); viewport-height: root.height; close-generation: root.combo-close-generation; popup-requested => { root.combo-popup-requested(); } popup-finished => { root.combo-popup-finished(); } model: [{ text: "AVIF", enabled: true }, { text: "WebP", enabled: true }, { text: "JXL", enabled: true }, { text: "JPGLI", enabled: true }, { text: "PNG", enabled: true }]; current-index <=> root.format-index; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; normal-background: root.combo-bg; hover-background: root.combo-bg-hover; disabled-background: root.combo-bg-disabled; selected-background: root.combo-selected-bg; normal-border: root.combo-border; hover-border: root.combo-border-hover; normal-text: root.text-body; disabled-text: root.text-soft; muted-text: root.text-muted; selected-text: root.text-body; }
                                            ParamHint {
                                                horizontal-stretch: 1;
                                                lead: @tr("首选 AVIF");
                                                lead-color: root.hint-orange;
                                                accent: @tr("极高压缩率 · 支持 HDR · 最高 12-bit");
                                                accent-color: root.hint-blue;
                                                detail: @tr("AWJ 针对 AVIF 做了大量实测与调参，代价是编码较慢；若某台设备打不开，优先更新查看端，而不是降级格式。WebP 编码快、兼容最好，适合作为第二格式，但只有 8-bit。JXL 更现代，能无损转封装 JPEG 并支持 HDR，压缩率略逊 AVIF。JPGLI 是新的 JPEG 编码器，在保持 JPEG 兼容的前提下明显提升压缩率。PNG 为无损输出，也可在参数设置中独立编辑。");
                                                detail-color: root.text-muted;
                                            }
                                        }

                                        if root.format-index == 0: HorizontalLayout {
                                            min-height: 72px;
                                            spacing: 10px;
                                            cross-axis-alignment: center;
                                            Text { text: @tr("编码器"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            SoftComboBox { accessible-name: @tr("AVIF 编码器"); viewport-height: root.height; close-generation: root.combo-close-generation; popup-requested => { root.combo-popup-requested(); } popup-finished => { root.combo-popup-finished(); } model: root.avif-encoder-options; current-index <=> root.avif-encoder-index; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; normal-background: root.combo-bg; hover-background: root.combo-bg-hover; disabled-background: root.combo-bg-disabled; selected-background: root.combo-selected-bg; normal-border: root.combo-border; hover-border: root.combo-border-hover; normal-text: root.text-body; disabled-text: root.text-soft; muted-text: root.text-muted; selected-text: root.text-body; }
                                            ParamHint {
                                                horizontal-stretch: 1;
                                                lead: @tr("保持“自动”就是最优解");
                                                lead-color: root.hint-orange;
                                                accent: @tr("优先 aom，超限自动切 zenrav1e");
                                                accent-color: root.hint-blue;
                                                detail: @tr("aom 支持高位深与 420/422/444，是默认主力。svt-av1-hdr 各项指标均不及 libaom，仅作备选。zenrav1e 能吃下超大图，但不适合当常规默认。");
                                                detail-color: root.text-muted;
                                            }
                                        }

                                        HorizontalLayout {
                                            min-height: 78px;
                                            spacing: 10px;
                                            cross-axis-alignment: center;
                                            Text { text: @tr("质量"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            LineEdit { accessible-label: @tr("质量"); text <=> root.quality-text; placeholder-text: root.visual-quality-text.is-empty ? "1-100/q90/0.9" : @tr("由视觉质量自动控制"); enabled: !root.running && root.visual-quality-text.is-empty && root.format-index != 4; width: root.parameter-control-width; opacity: root.format-index == 4 || !root.visual-quality-text.is-empty ? 0.56 : 1.0; height: root.parameter-control-height; }
                                            ParamHint {
                                                horizontal-stretch: 1;
                                                lead: @tr("1-100，越大越好；填 100 及以上为无损");
                                                lead-color: root.hint-violet;
                                                detail: @tr("AWJ 会把该刻度映射到有损编码器的 crf / quality；默认值取开发者判定的视觉无损点：AVIF 70、WebP 95、JXL 85、JPGLI 90。PNG 固定为无损，质量值为 100。JPEG 转 JXL 默认走无损转封装。");
                                                detail-color: root.text-muted;
                                            }
                                        }

                                        HorizontalLayout {
                                            min-height: 64px;
                                            spacing: 10px;
                                            cross-axis-alignment: center;
                                            Text { text: @tr("视觉质量"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            LineEdit { accessible-label: @tr("视觉质量"); text <=> root.visual-quality-text; placeholder-text: @tr("空由质量决定，1-100"); input-type: number; enabled: !root.running && root.format-index != 4; opacity: root.format-index == 4 ? 0.56 : 1.0; width: root.parameter-control-width; height: root.parameter-control-height; }
                                            ParamHint {
                                                horizontal-stretch: 1;
                                                lead: @tr("建议留空");
                                                lead-color: root.hint-red;
                                                detail: @tr("留空时由普通质量参数直接控制。若确实需要启用视觉质量搜索，建议从 50 左右开始；填写后会对同一张图反复编码，并用 GMSD / MS-SSIM 搜索目标画质，耗时会显著增加。");
                                                detail-color: root.text-body;
                                            }
                                        }

                                        if root.format-index == 0 || root.format-index == 1 || root.format-index == 2: HorizontalLayout {
                                            min-height: 56px;
                                            spacing: 10px;
                                            cross-axis-alignment: center;
                                            Text { text: @tr("速度"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            LineEdit { accessible-label: @tr("速度"); text <=> root.speed-text; placeholder-text: @tr("默认/可选0-10"); enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; }
                                            ParamHint {
                                                horizontal-stretch: 1;
                                                lead: @tr("0-10，越大越快");
                                                lead-color: root.hint-green;
                                                detail: @tr("默认值是速度与画质的平衡点，自动映射到各编码器的 preset / effort / cpu-used。同一质量下数值越小压缩效率越高。不支持调速的格式会自动隐藏这一行。");
                                                detail-color: root.text-muted;
                                            }
                                        }

                                        Text { text: @tr("资源限制"); height: 30px; color: root.text-strong; font-size: 15px; font-weight: 800; vertical-alignment: center; }

                                        HorizontalLayout {
                                            min-height: 64px;
                                            spacing: 10px;
                                            cross-axis-alignment: center;
                                            Text { text: @tr("线程"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            LineEdit { accessible-label: @tr("线程"); text <=> root.threads-text; placeholder-text: @tr("自动/线程数"); enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; }
                                            ParamHint {
                                                horizontal-stretch: 1;
                                                lead: @tr("留空 = 自动");
                                                lead-color: root.hint-cyan;
                                                accent: @tr("核心多时预留 4 个");
                                                accent-color: root.hint-blue;
                                                detail: @tr("填数字即为总线程上限。自动策略给桌面和 UI 留余量：逻辑核心 ≥12 预留 4 个，5-11 预留 2 个，2-4 预留 1 个，单核仍用 1 个。");
                                                detail-color: root.text-muted;
                                            }
                                        }

                                        HorizontalLayout {
                                            min-height: 64px;
                                            spacing: 10px;
                                            cross-axis-alignment: center;
                                            Text { text: @tr("内存"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            LineEdit { accessible-label: @tr("内存限制"); text <=> root.memory-limit-text; placeholder-text: @tr("例如 4（单位 GiB）"); input-type: number; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; }
                                            ParamHint {
                                                horizontal-stretch: 1;
                                                lead: @tr("留空 = 自动");
                                                lead-color: root.hint-cyan;
                                                accent: @tr("min(总内存 80%, 可用 50%)");
                                                accent-color: root.hint-blue;
                                                detail: @tr("填数字即为内存占用上限，单位 GiB。设置页可以解除内存限制，解除后覆盖这一项。");
                                                detail-color: root.text-muted;
                                            }
                                        }

                                        HorizontalLayout {
                                            min-height: 56px;
                                            spacing: 10px;
                                            cross-axis-alignment: center;
                                            Text { text: @tr("尺寸限制"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            SoftComboBox { accessible-name: @tr("图片尺寸限制"); viewport-height: root.height; close-generation: root.combo-close-generation; popup-requested => { root.combo-popup-requested(); } popup-finished => { root.combo-popup-finished(); } model: [{ text: @tr("自动"), enabled: true }, { text: @tr("无限制"), enabled: true }, { text: @tr("手动"), enabled: true }]; current-index <=> root.size-limit-index; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; normal-background: root.combo-bg; hover-background: root.combo-bg-hover; disabled-background: root.combo-bg-disabled; selected-background: root.combo-selected-bg; normal-border: root.combo-border; hover-border: root.combo-border-hover; normal-text: root.text-body; disabled-text: root.text-soft; muted-text: root.text-muted; selected-text: root.text-body; }
                                            ParamHint {
                                                horizontal-stretch: 1;
                                                lead: @tr("自动 = 保证还能正确解码");
                                                lead-color: root.hint-cyan;
                                                detail: @tr("按格式与解码能力限制边长，也可以切换成无限制。手动时取宽、高、长边、短边里最严格的一项。");
                                                detail-color: root.text-muted;
                                            }
                                        }

                                        if root.size-limit-index == 2: HorizontalLayout {
                                            height: 48px;
                                            spacing: 10px;
                                            cross-axis-alignment: center;
                                            Text { text: @tr("手动尺寸"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            LineEdit { accessible-label: @tr("最大宽度"); text <=> root.max-width-text; placeholder-text: @tr("最大宽"); input-type: number; enabled: !root.running; width: 100px; height: root.parameter-control-height; }
                                            LineEdit { accessible-label: @tr("最大高度"); text <=> root.max-height-text; placeholder-text: @tr("最大高"); input-type: number; enabled: !root.running; width: 100px; height: root.parameter-control-height; }
                                            LineEdit { accessible-label: @tr("最大长边"); text <=> root.max-long-edge-text; placeholder-text: @tr("最大长边"); input-type: number; enabled: !root.running; width: 100px; height: root.parameter-control-height; }
                                            LineEdit { accessible-label: @tr("最大短边"); text <=> root.max-short-edge-text; placeholder-text: @tr("最大短边"); input-type: number; enabled: !root.running; width: 100px; height: root.parameter-control-height; }
                                        }

                                        Text { text: @tr("格式高级选项"); height: 30px; color: root.text-strong; font-size: 15px; font-weight: 800; vertical-alignment: center; }

                                        if root.format-index == 0: HorizontalLayout {
                                            min-height: 56px;
                                            spacing: 10px;
                                            cross-axis-alignment: center;
                                            Text { text: @tr("位深"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            LineEdit { accessible-label: @tr("位深"); text <=> root.bit-depth-text; placeholder-text: @tr("保持原片"); enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; }
                                            ParamHint {
                                                horizontal-stretch: 1;
                                                lead: @tr("自动至少 10-bit");
                                                lead-color: root.hint-orange;
                                                detail: @tr("源 ≤10-bit 提升到 10-bit，源 ≥12-bit 收到 12-bit；显式填写则以填写值为准。AVIF 支持 8 / 10 / 12-bit。");
                                                detail-color: root.text-muted;
                                            }
                                        }

                                        if root.format-index == 0: HorizontalLayout {
                                            min-height: 64px;
                                            spacing: 10px;
                                            cross-axis-alignment: center;
                                            Text { text: @tr("颜色表示"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            SoftComboBox { accessible-name: @tr("AVIF 颜色表示"); viewport-height: root.height; close-generation: root.combo-close-generation; popup-requested => { root.combo-popup-requested(); } popup-finished => { root.combo-popup-finished(); } model: [{ text: "YUV", enabled: true }, { text: @tr("跟随源"), enabled: true }, { text: "RGB(A) / GBR(A) Identity", enabled: true }]; current-index <=> root.avif-color-representation-index; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; normal-background: root.combo-bg; hover-background: root.combo-bg-hover; disabled-background: root.combo-bg-disabled; selected-background: root.combo-selected-bg; normal-border: root.combo-border; hover-border: root.combo-border-hover; normal-text: root.text-body; disabled-text: root.text-soft; muted-text: root.text-muted; selected-text: root.text-body; }
                                            ParamHint {
                                                horizontal-stretch: 1;
                                                lead: @tr("默认 YUV");
                                                lead-color: root.hint-blue;
                                                detail: @tr("YUV 始终使用非 Identity 矩阵；跟随源仅在 RGB/RGBA 或 Identity 源时使用 RGB/GBR Identity；RGB(A)/GBR(A) 强制 4:4:4 并自动选择 AOM。");
                                                detail-color: root.text-muted;
                                            }
                                        }

                                        if (root.format-index == 0 && root.avif-encoder-index != 1) || root.format-index == 3: HorizontalLayout {
                                            min-height: 64px;
                                            spacing: 10px;
                                            cross-axis-alignment: center;
                                            Text { text: @tr("色度采样"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            SoftComboBox { accessible-name: @tr("色度采样"); viewport-height: root.height; close-generation: root.combo-close-generation; popup-requested => { root.combo-popup-requested(); } popup-finished => { root.combo-popup-finished(); } model: [{ text: @tr("自动"), enabled: true }, { text: "444", enabled: true }, { text: "422", enabled: true }, { text: "420", enabled: true }]; current-index <=> root.chroma-index; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; normal-background: root.combo-bg; hover-background: root.combo-bg-hover; disabled-background: root.combo-bg-disabled; selected-background: root.combo-selected-bg; normal-border: root.combo-border; hover-border: root.combo-border-hover; normal-text: root.text-body; disabled-text: root.text-soft; muted-text: root.text-muted; selected-text: root.text-body; }
                                            ParamHint {
                                                horizontal-stretch: 1;
                                                lead: @tr("自动 = 跟随源");
                                                lead-color: root.hint-blue;
                                                detail: root.format-index == 3
                                                    ? @tr("JPGLI 支持 444 / 422 / 420，自动时用 Jpegli 默认采样。")
                                                    : @tr("一律以 YUV 编码：源是 420 / 422 / 444 就原样保留，RGB 与 RGBA 视作 444，灰度按 420 处理。");
                                                detail-color: root.text-muted;
                                            }
                                        }

                                        if root.format-index == 3: HorizontalLayout {
                                            height: 48px;
                                            spacing: 10px;
                                            cross-axis-alignment: center;
                                            Text { text: @tr("渐进"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            SoftComboBox { accessible-name: @tr("JPGLI 渐进级别"); viewport-height: root.height; close-generation: root.combo-close-generation; popup-requested => { root.combo-popup-requested(); } popup-finished => { root.combo-popup-finished(); } model: [{ text: @tr("关闭"), enabled: true }, { text: @tr("普通"), enabled: true }, { text: @tr("更细"), enabled: true }]; current-index <=> root.jpegli-progressive-index; enabled: !root.running; width: root.parameter-control-width; height: root.parameter-control-height; normal-background: root.combo-bg; hover-background: root.combo-bg-hover; disabled-background: root.combo-bg-disabled; selected-background: root.combo-selected-bg; normal-border: root.combo-border; hover-border: root.combo-border-hover; normal-text: root.text-body; disabled-text: root.text-soft; muted-text: root.text-muted; selected-text: root.text-body; }
                                        }

                                        if root.format-index == 3 && root.jpegli-progressive-index == 0: HorizontalLayout {
                                            height: 48px;
                                            spacing: 10px;
                                            cross-axis-alignment: center;
                                            Text { text: @tr("哈夫曼"); width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            CheckBox { text: @tr("优化哈夫曼表"); checked <=> root.jpegli-optimize-huffman; enabled: !root.running; width: root.parameter-control-width; }
                                        }

                                        if root.format-index == 3: HorizontalLayout {
                                            height: 48px;
                                            spacing: 10px;
                                            cross-axis-alignment: center;
                                            Text { text: "XYB"; width: 88px; color: root.text-body; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                            CheckBox { text: @tr("启用 XYB"); checked <=> root.jpegli-xyb; enabled: !root.running; width: root.parameter-control-width; }
                                        }

                                        if root.format-index == 0: HorizontalLayout {
                                            min-height: 56px;
                                            spacing: 10px;
                                            cross-axis-alignment: center;
