export global StudioTheme {
    pure public function page-bg(dark: bool) -> color { return dark ? #202020 : #f3f7fd; }
    pure public function mica-tint(dark: bool) -> color { return dark ? #202020 : #edf4ff; }
    pure public function nav-bg(dark: bool) -> color { return dark ? #242424 : #f8fbff; }
    pure public function chrome-bg(dark: bool) -> color { return dark ? #282828 : #ffffff; }
    pure public function panel-bg(dark: bool) -> color { return dark ? #282828 : #ffffff; }
    pure public function panel-bg-soft(dark: bool) -> color { return dark ? #303030 : #f8fbff; }
    pure public function panel-border(dark: bool) -> color { return dark ? #414141 : #dde7f3; }
    pure public function field-bg(dark: bool) -> color { return dark ? #303030 : #fbfdff; }
    pure public function field-border(dark: bool) -> color { return dark ? #4a4a4a : #e2eaf4; }
    pure public function text-strong(dark: bool) -> color { return dark ? #f5f5f5 : #111827; }
    pure public function text-body(dark: bool) -> color { return dark ? #e2e2e2 : #334155; }
    pure public function text-muted(dark: bool) -> color { return dark ? #adadad : #64748b; }
    pure public function text-soft(dark: bool) -> color { return dark ? #858585 : #94a3b8; }
    pure public function accent-strong(dark: bool) -> color { return dark ? #5aa2ff : #0b5ed7; }
    pure public function accent-soft(dark: bool) -> color { return dark ? #14325b : #e7f1ff; }
    pure public function success-soft(dark: bool) -> color { return dark ? #143522 : #eaf8ef; }
    pure public function hint-blue(dark: bool) -> color { return dark ? #7dd3fc : #0369a1; }
    pure public function hint-orange(dark: bool) -> color { return dark ? #fbbf24 : #b45309; }
    pure public function hint-green(dark: bool) -> color { return dark ? #86efac : #15803d; }
    pure public function hint-cyan(dark: bool) -> color { return dark ? #67e8f9 : #0f766e; }
    pure public function hint-red(dark: bool) -> color { return dark ? #fda4af : #dc2626; }
    pure public function hint-violet(dark: bool) -> color { return dark ? #c4b5fd : #7c3aed; }
    pure public function progress-track(dark: bool) -> color { return dark ? #383838 : #dbe7f5; }
    pure public function combo-bg(dark: bool) -> color { return dark ? #303030 : #fbfdff; }
    pure public function combo-bg-hover(dark: bool) -> color { return dark ? #383838 : #f3f8ff; }
    pure public function combo-bg-disabled(dark: bool) -> color { return dark ? #272727 : #eef2f7; }
    pure public function combo-selected-bg(dark: bool) -> color { return dark ? #14325b : #e7f1ff; }
    pure public function combo-border(dark: bool) -> color { return dark ? #4a4a4a : #dfe8f3; }
    pure public function combo-border-hover(dark: bool) -> color { return dark ? #626262 : #b9d6f7; }

    out property <color> accent: #0d6efd;
    out property <color> success: #22b84c;
    out property <color> warning: #d97706;
}
