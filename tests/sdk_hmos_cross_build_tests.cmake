        "proof-log|build_log_sha256|${fingerprint}" "proof-dependencies|dependency_identity_sha256|${fingerprint}"
        "proof-nonce|nonce|${fingerprint}" "proof-clean-first|build_strategy|clean-first")
        string(REPLACE "|" ";" parts "${spec}")
        list(GET parts 0 name)
        if(CASE STREQUAL name)
            list(GET parts 1 key)
            list(GET parts 2 value)
            string(JSON proof SET "${proof}" "${key}" "\"${value}\"")
        endif()
    endforeach()
    if(CASE STREQUAL "proof-dirty")
        string(JSON proof SET "${proof}" source_dirty true)
    elseif(CASE STREQUAL "proof-inputs")
        string(JSON proof SET "${proof}" inputs_after "{}")
    elseif(CASE STREQUAL "proof-encoder-missing")
        string(JSON proof SET "${proof}" encoders "[\"png\"]")
    elseif(CASE STREQUAL "proof-encoder-duplicate")
        string(JSON proof SET "${proof}" encoders "[\"png\",\"png\",\"avif\",\"jxl\",\"webp\"]")
    elseif(CASE STREQUAL "proof-program-missing")
        string(JSON proof REMOVE "${proof}" test_programs awj_sdk_stdlib_tests)
    elseif(CASE STREQUAL "proof-program-binding")
        string(JSON proof SET "${proof}" test_programs awj_sdk_tests sdk_library_sha256 "\"${fingerprint}\"")
    elseif(CASE STREQUAL "proof-verification-missing")
        string(JSON proof REMOVE "${proof}" verification native_inputs)
    elseif(CASE STREQUAL "proof-verification-extra")
        string(JSON proof SET "${proof}" verification exports "\"passed\"")
    endif()
    awj_sdk_validate_hmos_cross_proof("${proof}" p "${version}" "${head}" "${fingerprint}" "${library_hash}"
        23.1.5 "${compiler_hash}" "${records}" "${manifest}" "${manifest_hash}" "${inputs}" "${build_log_hash}" formal)
endif()
