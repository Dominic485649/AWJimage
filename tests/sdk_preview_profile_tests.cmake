cmake_minimum_required(VERSION 3.30)
# 仅为元数据/ELF 文本契约夹具，不是编译器、SDK 或设备运行证据。
get_filename_component(repo "${CMAKE_CURRENT_LIST_DIR}/.." REALPATH)
include("${repo}/cmake/sdk-preview-profile.cmake")
if(NOT TEST_ROOT OR NOT IS_ABSOLUTE "${TEST_ROOT}")
    message(FATAL_ERROR "指定本项目全新的 TEST_ROOT")
endif()
get_filename_component(parent "${TEST_ROOT}" DIRECTORY)
get_filename_component(leaf "${TEST_ROOT}" NAME)
file(REAL_PATH "${parent}" parent)
file(REAL_PATH "${repo}/build/release-1.3.1/20261101" allowed)
if(NOT parent STREQUAL allowed OR NOT leaf MATCHES "^preview-profile-tests-[A-Za-z0-9_.-]+$")
    message(FATAL_ERROR "预览夹具根必须位于本轮项目验证目录")
endif()
if(NOT CASE)
    if(EXISTS "${TEST_ROOT}")
        message(FATAL_ERROR "保留旧预览夹具，不覆盖")
    endif()
    file(MAKE_DIRECTORY "${TEST_ROOT}")
    file(WRITE "${TEST_ROOT}/FIXTURE-ONLY.txt" "Synthetic metadata/ELF-text fixtures only; no SDK, compiler or device execution.\n")
    set(cases
        "positive-proof|PASS" "positive-program|PASS" "positive-helper-program|PASS"
        "scope-version|预览范围" "scope-platform|预览范围"
        "proof-mode|mode" "proof-status|status" "proof-kind|kind" "proof-tier|validation_tier"
        "proof-platform|platform" "proof-runtime|target_execution" "proof-loader|target_loader"
        "proof-junit|运行验收字段" "proof-consumer-report|运行验收字段" "proof-target-report|运行验收字段"
        "proof-source|source_fingerprint" "proof-library|library_sha256" "proof-build-log|build_log_sha256"
        "proof-compiler|compiler_sha256" "proof-feature|features" "proof-encoder|五编码器"
        "proof-program-missing|七个" "proof-program-hash|sha256"
        "program-arch|AArch64" "program-object|可执行" "program-dso|PIE"
        "program-runtime|运行库依赖" "program-rpath|运行路径" "program-libc|libc.so")
    set(count 0)
    foreach(spec IN LISTS cases)
        string(REPLACE "|" ";" parts "${spec}")
        list(GET parts 0 name)
        list(GET parts 1 expected)
        execute_process(COMMAND "${CMAKE_COMMAND}" "-DTEST_ROOT=${TEST_ROOT}" "-DCASE=${name}" -P "${CMAKE_CURRENT_LIST_FILE}"
            RESULT_VARIABLE code OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
        file(WRITE "${TEST_ROOT}/${name}.log" "FIXTURE ONLY\nexit=${code}\n${stdout}${stderr}")
        if(expected STREQUAL "PASS")
            if(NOT code EQUAL 0)
                message(FATAL_ERROR "正向预览夹具失败：${name}\n${stdout}${stderr}")
            endif()
        elseif(code EQUAL 0 OR NOT "${stdout}${stderr}" MATCHES "${expected}")
            message(FATAL_ERROR "预览负向夹具未正确拒绝：${name}\n${stdout}${stderr}")
        endif()
        math(EXPR count "${count} + 1")
    endforeach()
    file(WRITE "${TEST_ROOT}/summary.json" "{\"fixture_only\":true,\"passed\":${count},\"device_execution\":\"not-run\"}\n")
    message(STATUS "${count} 个预览契约夹具通过；不是 SDK/设备运行验收")
    return()
endif()
if(NOT EXISTS "${TEST_ROOT}/FIXTURE-ONLY.txt" OR NOT CASE MATCHES "^[a-z0-9-]+$")
    message(FATAL_ERROR "只允许本夹具驱动执行 CASE")
endif()
set(version 1.3.1)
awj_sdk_select_profile("${version}" hmos-arm64-api26-clang23 Linux x86_64 p)
string(SHA1 head "FIXTURE ONLY HEAD")
foreach(field IN ITEMS fingerprint library_hash compiler_hash build_log_hash)
    string(SHA256 "${field}" "FIXTURE ONLY ${field}")
endforeach()
set(programs "{}")
awj_sdk_hmos_preview_program_names(names)
foreach(name IN LISTS names)
    string(SHA256 hash "FIXTURE ONLY ${name}")
    string(JSON programs SET "${programs}" "${name}" "{\"sha256\":\"${hash}\"}")
endforeach()
set(proof "{\"schema\":1,\"kind\":\"hmos-cross-build\",\"mode\":\"preview\",\"status\":\"cross-linked\",\"validation_tier\":\"cross-build-preview\",\"target_execution\":\"not-run\",\"target_loader\":\"not-run\",\"version\":\"${version}\",\"git_head\":\"${head}\",\"source_fingerprint\":\"${fingerprint}\",\"source_dirty\":false,\"native_codecs\":true,\"compiled_source_verified\":true,\"profile\":\"hmos-arm64-api26-clang23\",\"platform\":\"hmos-arm64-api26\",\"target_triple\":\"aarch64-unknown-linux-ohos\",\"abi\":1,\"compiler_id\":\"Clang\",\"compiler_version\":\"23.1.5\",\"compiler_sha256\":\"${compiler_hash}\",\"library_sha256\":\"${library_hash}\",\"build_log_sha256\":\"${build_log_hash}\",\"native_sdk_version\":\"26.0.0.105\",\"api\":26,\"libcxx_version\":15004,\"libcxx_abi_version\":1,\"libcxx_abi_namespace\":\"__n1\",\"runtime_linkage\":\"native-static\",\"features\":{\"d3d11\":false,\"shm\":false,\"ffmpeg\":false,\"stream\":false,\"gpu\":false},\"encoders\":[\"png\",\"jpegli\",\"webp\",\"avif\",\"jxl\"],\"test_programs\":${programs}}")
set(binary "Format: elf64-littleaarch64\nArch: aarch64\nAddressSize: 64bit\nType: SharedObject (0x3)\nFLAGS_1 NOW PIE\nNeededLibraries [\nlibawj_sdk.so\nlibc.so\n]\n")
if(CASE STREQUAL "scope-version")
    awj_sdk_require_hmos_preview_scope(1.3.2 p)
elseif(CASE STREQUAL "scope-platform")
    awj_sdk_select_profile(1.3.1 linux-x64-clang23 Linux x86_64 p)
    awj_sdk_require_hmos_preview_scope(1.3.1 p)
elseif(CASE STREQUAL "positive-program" OR CASE STREQUAL "positive-helper-program" OR CASE MATCHES "^program-")
    if(CASE STREQUAL "positive-helper-program")
        string(REPLACE "libawj_sdk.so\n" "" binary "${binary}")
    elseif(CASE STREQUAL "program-arch")
        string(REPLACE "Arch: aarch64" "Arch: x86_64" binary "${binary}")
    elseif(CASE STREQUAL "program-object")
        string(REPLACE "Type: SharedObject" "Type: Relocatable" binary "${binary}")
    elseif(CASE STREQUAL "program-dso")
        string(REPLACE "FLAGS_1 NOW PIE" "FLAGS_1 NOW" binary "${binary}")
    elseif(CASE STREQUAL "program-runtime")
        string(REPLACE "libc.so\n" "libc.so\nlibc++_shared.so\n" binary "${binary}")
    elseif(CASE STREQUAL "program-rpath")
        string(APPEND binary "RUNPATH [/home/fixture/lib]\n")
    elseif(CASE STREQUAL "program-libc")
        string(REPLACE "libc.so\n" "" binary "${binary}")
    endif()
    awj_sdk_check_hmos_preview_program_text("${binary}")
else()
    foreach(spec IN ITEMS
        "proof-mode:mode:formal" "proof-status:status:passed" "proof-kind:kind:target-execution"
        "proof-tier:validation_tier:target-verified" "proof-platform:platform:linux-x64"
        "proof-runtime:target_execution:passed" "proof-loader:target_loader:passed"
        "proof-source:source_fingerprint:${library_hash}" "proof-library:library_sha256:${fingerprint}"
        "proof-build-log:build_log_sha256:${fingerprint}" "proof-compiler:compiler_sha256:${fingerprint}")
        if(spec MATCHES "^${CASE}:([^:]+):(.*)$")
            string(JSON proof SET "${proof}" "${CMAKE_MATCH_1}" "\"${CMAKE_MATCH_2}\"")
        endif()
    endforeach()
    if(CASE STREQUAL "proof-junit")
        string(JSON proof SET "${proof}" test_report_sha256 "\"${fingerprint}\"")
    elseif(CASE STREQUAL "proof-consumer-report")
        string(JSON proof SET "${proof}" consumer_report_sha256 "\"${fingerprint}\"")
    elseif(CASE STREQUAL "proof-target-report")
        string(JSON proof SET "${proof}" target_execution_report_sha256 "\"${fingerprint}\"")
    elseif(CASE STREQUAL "proof-feature")
        string(JSON proof SET "${proof}" features gpu true)
    elseif(CASE STREQUAL "proof-encoder")
        string(JSON proof SET "${proof}" encoders "[\"png\"]")
    elseif(CASE STREQUAL "proof-program-missing")
        string(JSON proof REMOVE "${proof}" test_programs awj_sdk_tests)
    elseif(CASE STREQUAL "proof-program-hash")
        string(JSON proof SET "${proof}" test_programs awj_sdk_tests sha256 "\"${fingerprint}\"")
    endif()
    awj_sdk_validate_hmos_preview_proof("${proof}" p "${version}" "${head}" "${fingerprint}"
        "${library_hash}" 23.1.5 "${compiler_hash}" "${programs}" "${build_log_hash}")
endif()
