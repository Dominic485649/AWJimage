if(NOT DEFINED LIBAVIF_SOURCE_DIR OR NOT DEFINED PROJECT_ROOT OR NOT DEFINED TEST_ROOT)
    message(FATAL_ERROR "预缩放补丁测试缺少路径参数")
endif()
find_package(Git REQUIRED)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef _suffix)
set(_sandbox "${TEST_ROOT}/prescaled-${_suffix}")
if(EXISTS "${_sandbox}")
    message(FATAL_ERROR "测试目录必须全新")
endif()
file(MAKE_DIRECTORY "${_sandbox}")
set(_source "${_sandbox}/source")
execute_process(COMMAND "${GIT_EXECUTABLE}" clone --shared --no-checkout "${LIBAVIF_SOURCE_DIR}" "${_source}"
    RESULT_VARIABLE _result OUTPUT_QUIET ERROR_VARIABLE _error)
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "无法建立固定依赖测试副本：${_error}")
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${_source}" checkout --detach c5240fc79fe5c2407e10afd35f5505ef6333ea49
    COMMAND_ERROR_IS_FATAL ANY OUTPUT_QUIET ERROR_QUIET)
function(_apply name expected)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${_source}" -P
        "${PROJECT_ROOT}/cmake/patch_libavif_${name}.cmake"
        RESULT_VARIABLE _code OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
    if(expected AND NOT _code EQUAL 0)
        message(FATAL_ERROR "预期补丁成功 ${name}：${_output}${_error}")
    elseif(NOT expected AND _code EQUAL 0)
        message(FATAL_ERROR "损坏输入被补丁接受：${name}")
    endif()
endfunction()
foreach(_pass RANGE 1 2)
    foreach(_patch IN ITEMS parallel_grid animation_budget primary_item gain_map_threads prescaled_layers)
        _apply("${_patch}" TRUE)
    endforeach()
endforeach()
foreach(_path IN ITEMS include/avif/avif.h src/codec_aom.c src/write.c)
    file(READ "${_source}/${_path}" _original)
    file(APPEND "${_source}/${_path}" "\n/* AWJ 契约测试：未知输入必须拒绝 */\n")
    _apply(prescaled_layers FALSE)
    file(WRITE "${_source}/${_path}" "${_original}")
    _apply(prescaled_layers TRUE)
endforeach()
# 混合应用状态：只撤销头文件中的一项，不得自动修复不完整 API。
file(READ "${_source}/include/avif/avif.h" _original)
string(REPLACE "    uint32_t width;\n    uint32_t height;\n} avifEncoder;" "} avifEncoder;" _damaged "${_original}")
if(_original STREQUAL _damaged)
    message(FATAL_ERROR "测试未找到已核验的 API 字段")
endif()
file(WRITE "${_source}/include/avif/avif.h" "${_damaged}")
_apply(prescaled_layers FALSE)
file(WRITE "${_source}/include/avif/avif.h" "${_original}")
message(STATUS "预缩放补丁：首次、全部重入、三处未知修改及混合 API 拒绝通过")
# 成功后仅删除本测试创建的全新副本；失败时保留现场，CTest 日志保留过程证据。
file(REMOVE_RECURSE "${_sandbox}")
