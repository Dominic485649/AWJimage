# Patch contract only: no configure/build, real dependency writes, or pixel tests.
# Supply the project's designated results root; failed sandboxes remain there.
if(NOT DEFINED LIBAVIF_SOURCE_DIR OR NOT DEFINED TEST_DIR OR
   LIBAVIF_SOURCE_DIR STREQUAL "" OR TEST_DIR STREQUAL "")
    message(FATAL_ERROR "LIBAVIF_SOURCE_DIR and TEST_DIR are required")
endif()
if(NOT IS_ABSOLUTE "${LIBAVIF_SOURCE_DIR}" OR NOT IS_ABSOLUTE "${TEST_DIR}")
    message(FATAL_ERROR "LIBAVIF_SOURCE_DIR and TEST_DIR must be absolute")
endif()
if(NOT DEFINED PATCH_SCRIPT)
    set(PATCH_SCRIPT "${CMAKE_CURRENT_LIST_DIR}/../cmake/patch_libavif_primary_item.cmake")
endif()
set(REAL_READ_C "${LIBAVIF_SOURCE_DIR}/src/read.c")
set(REAL_INTERNAL_H "${LIBAVIF_SOURCE_DIR}/include/avif/internal.h")
file(SHA256 "${REAL_READ_C}" REAL_READ_BEFORE)
file(SHA256 "${REAL_INTERNAL_H}" REAL_INTERNAL_BEFORE)
file(READ "${REAL_READ_C}" REAL_READ)
file(READ "${REAL_INTERNAL_H}" REAL_INTERNAL)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef NONCE)
set(SANDBOX "${TEST_DIR}/avif-primary-item-contract-${NONCE}")
if(EXISTS "${SANDBOX}")
    message(FATAL_ERROR "Patch test sandbox already exists: ${SANDBOX}")
endif()
file(MAKE_DIRECTORY "${SANDBOX}")

function(fixture NAME READ_TEXT INTERNAL_TEXT)
    file(MAKE_DIRECTORY "${SANDBOX}/${NAME}/src" "${SANDBOX}/${NAME}/include/avif")
    file(WRITE "${SANDBOX}/${NAME}/src/read.c" "${READ_TEXT}")
    file(WRITE "${SANDBOX}/${NAME}/include/avif/internal.h" "${INTERNAL_TEXT}")
endfunction()
function(apply NAME)
    file(SHA256 "${SANDBOX}/${NAME}/include/avif/internal.h" INTERNAL_BEFORE)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${SANDBOX}/${NAME}" -P "${PATCH_SCRIPT}"
        RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
    file(SHA256 "${SANDBOX}/${NAME}/include/avif/internal.h" INTERNAL_AFTER)
    if(NOT RESULT EQUAL 0 OR NOT INTERNAL_BEFORE STREQUAL INTERNAL_AFTER)
        message(FATAL_ERROR "Primary-item patch ${NAME} failed or modified internal.h: ${OUTPUT}${ERROR}; sandbox ${SANDBOX}")
    endif()
endfunction()
function(reject NAME READ_TEXT INTERNAL_TEXT)
    fixture("${NAME}" "${READ_TEXT}" "${INTERNAL_TEXT}")
    file(SHA256 "${SANDBOX}/${NAME}/src/read.c" READ_BEFORE)
    file(SHA256 "${SANDBOX}/${NAME}/include/avif/internal.h" INTERNAL_BEFORE)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${SANDBOX}/${NAME}" -P "${PATCH_SCRIPT}"
        RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
    file(SHA256 "${SANDBOX}/${NAME}/src/read.c" READ_AFTER)
    file(SHA256 "${SANDBOX}/${NAME}/include/avif/internal.h" INTERNAL_AFTER)
    if(RESULT EQUAL 0 OR NOT ERROR MATCHES "libavif primary-item patch:" OR
       NOT READ_BEFORE STREQUAL READ_AFTER OR NOT INTERNAL_BEFORE STREQUAL INTERNAL_AFTER)
        message(FATAL_ERROR "Primary-item patch accepted/changed ${NAME}: ${OUTPUT}${ERROR}; sandbox ${SANDBOX}")
    endif()
endfunction()
function(change OUT INPUT NEEDLE REPLACEMENT)
    string(FIND "${INPUT}" "${NEEDLE}" POS)
    if(POS EQUAL -1 OR NEEDLE STREQUAL REPLACEMENT)
        message(FATAL_ERROR "Patch contract mutation anchor missing: ${NEEDLE}")
    endif()
    string(REPLACE "${NEEDLE}" "${REPLACEMENT}" CHANGED "${INPUT}")
    set(${OUT} "${CHANGED}" PARENT_SCOPE)
endfunction()

# The populated dependency may already have the exact patch from configuration.
# Validate a copy first, before extracting its pinned pristine prefix. Never strip
# an unvalidated marker from the actual dependency and thereby hide a bad patch.
fixture(actual "${REAL_READ}" "${REAL_INTERNAL}")
apply(actual)
file(READ "${SANDBOX}/actual/src/read.c" PATCHED)
set(BEGIN_MARKER "\n// AWJ_AVIF_PRIMARY_ITEM_PATCH_BEGIN\n")
string(FIND "${PATCHED}" "${BEGIN_MARKER}" BEGIN_POS)
if(BEGIN_POS EQUAL -1)
    message(FATAL_ERROR "Primary-item patch omitted its exact begin marker")
endif()
string(SUBSTRING "${PATCHED}" 0 ${BEGIN_POS} PRISTINE)
string(SUBSTRING "${PATCHED}" ${BEGIN_POS} -1 APPENDIX)
string(SHA256 PRISTINE_HASH "${PRISTINE}")
string(SHA256 REAL_INTERNAL_CANONICAL "${REAL_INTERNAL}")
if(NOT PRISTINE_HASH STREQUAL "e1cdbe4ecd139a2d4aff7eea927a48465753aea768d40e30550601ca72e65cdc" OR
   NOT REAL_INTERNAL_CANONICAL STREQUAL "3b23c7a4a4d83ed9b6b03531b0b205675e71e07284d7e39d01531f94c12189ce")
    message(FATAL_ERROR "Primary-item patch changed its pinned parser input")
endif()
foreach(REQUIRED IN ITEMS
        "int awjAvifHasIndependentPrimary(const avifDecoder * decoder)"
        "avifMetaFindColorItem(data->meta)"
        "primary->auxForID || primary->thumbnailForID"
        "avifCodecDecodeInputCreate()"
        "avifCodecDecodeInputFillFromSampleTable(input,"
        "decoder->imageCountLimit"
        "decoder->io->sizeHint"
        "avifCodecDecodeInputDestroy(input)"
        "independent = shared ? 0 : 1;"
        "// AWJ_AVIF_PRIMARY_ITEM_PATCH_END\n")
    string(FIND "${APPENDIX}" "${REQUIRED}" POS)
    if(POS EQUAL -1)
        message(FATAL_ERROR "Primary-item adapter lost a required contract: ${REQUIRED}")
    endif()
endforeach()
# 初次规范化换行后保留全部源码；重复运行不改写。Windows CRLF 与 Linux LF 使用同一固定源码指纹。
string(REPLACE "\n" "\r\n" CRLF_READ "${PRISTINE}")
string(REPLACE "\n" "\r\n" CRLF_INTERNAL "${REAL_INTERNAL}")
fixture(crlf "${CRLF_READ}" "${CRLF_INTERNAL}")
apply(crlf)
file(READ "${SANDBOX}/crlf/src/read.c" CRLF_PATCHED)
if(NOT CRLF_PATCHED STREQUAL PATCHED)
    message(FATAL_ERROR "CRLF and LF patch applications diverged")
endif()
fixture(first "${PRISTINE}" "${REAL_INTERNAL}")
apply(first)
file(READ "${SANDBOX}/first/src/read.c" FIRST)
if(NOT FIRST STREQUAL PATCHED)
    message(FATAL_ERROR "Primary-item first application differs from the validated appendix")
endif()
file(SHA256 "${SANDBOX}/first/src/read.c" FIRST_HASH)
apply(first)
file(SHA256 "${SANDBOX}/first/src/read.c" REPEAT_HASH)
if(NOT FIRST_HASH STREQUAL REPEAT_HASH)
    message(FATAL_ERROR "Primary-item patch is not idempotent")
endif()

reject(unknown_source "// incompatible upstream decoder\n" "${REAL_INTERNAL}")
change(BAD "${PRISTINE}" "    uint32_t primaryItemID;" "    uint64_t primaryItemID;")
reject(changed_upstream "${BAD}" "${REAL_INTERNAL}")
reject(changed_upstream_after_patch "${BAD}${APPENDIX}" "${REAL_INTERNAL}")
change(BAD_INTERNAL "${REAL_INTERNAL}" "    uint32_t itemID;" "    uint64_t itemID;")
reject(changed_internal "${PRISTINE}" "${BAD_INTERNAL}")
reject(changed_internal_after_patch "${PATCHED}" "${BAD_INTERNAL}")
reject(marker_only "${PRISTINE}${BEGIN_MARKER}" "${REAL_INTERNAL}")
reject(declaration_only "${PRISTINE}\nint awjAvifHasIndependentPrimary(const avifDecoder * decoder);\n" "${REAL_INTERNAL}")
change(BAD "${PATCHED}" "// AWJ_AVIF_PRIMARY_ITEM_PATCH_END\n" "")
reject(missing_end "${BAD}" "${REAL_INTERNAL}")
change(BAD "${PATCHED}" "independent = shared ? 0 : 1;" "independent = 1;")
reject(damaged_implementation "${BAD}" "${REAL_INTERNAL}")
reject(duplicate_appendix "${PATCHED}${APPENDIX}" "${REAL_INTERNAL}")
reject(trailing_edit "${PATCHED}\n// unrelated decoder edit\n" "${REAL_INTERNAL}")

file(SHA256 "${REAL_READ_C}" REAL_READ_AFTER)
file(SHA256 "${REAL_INTERNAL_H}" REAL_INTERNAL_AFTER)
if(NOT REAL_READ_BEFORE STREQUAL REAL_READ_AFTER OR NOT REAL_INTERNAL_BEFORE STREQUAL REAL_INTERNAL_AFTER)
    message(FATAL_ERROR "Primary-item patch contract changed the real dependency")
endif()
file(READ "${PATCH_SCRIPT}" PATCH_TEXT)
string(REPLACE "\r\n" "\n" PATCH_TEXT "${PATCH_TEXT}")
string(SHA256 PATCH_HASH "${PATCH_TEXT}")
# Only this fresh, test-owned directory is disposable. Keep it on any failure.
file(REMOVE_RECURSE "${SANDBOX}")
message(STATUS "Normalized primary-item patch SHA-256: ${PATCH_HASH}")
message(STATUS "Primary-item patch contract passed: pristine, repeat, 11 fail-closed cases; real dependency unchanged; successful sandbox removed")
