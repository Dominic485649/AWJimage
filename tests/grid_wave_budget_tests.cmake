# Native C probe of the exact helper injected by patch_libavif_parallel_grid.
# The populated dependency is read-only; patching/building happens in a fresh,
# task-owned child of TEST_DIR. No application modules or encoder library link.
# Required: absolute LIBAVIF_SOURCE_DIR, TEST_DIR and C_COMPILER.
# Optional: PATCH_SCRIPT, PROBE_GENERATOR, MAKE_PROGRAM, PROBE_CONFIG.
cmake_minimum_required(VERSION 3.24)
foreach(_parameter IN ITEMS LIBAVIF_SOURCE_DIR TEST_DIR C_COMPILER)
    if(NOT DEFINED ${_parameter} OR "${${_parameter}}" STREQUAL "" OR
       NOT IS_ABSOLUTE "${${_parameter}}")
        message(FATAL_ERROR "grid wave contract: absolute ${_parameter} is required")
    endif()
endforeach()
if(NOT EXISTS "${LIBAVIF_SOURCE_DIR}/src/write.c" OR NOT EXISTS "${C_COMPILER}")
    message(FATAL_ERROR "grid wave contract: dependency source or native C compiler is missing")
endif()
if(NOT DEFINED PATCH_SCRIPT)
    set(PATCH_SCRIPT "${CMAKE_CURRENT_LIST_DIR}/../cmake/patch_libavif_parallel_grid.cmake")
endif()
if(NOT DEFINED PROBE_GENERATOR)
    set(PROBE_GENERATOR Ninja)
endif()
if(NOT DEFINED PROBE_CONFIG)
    set(PROBE_CONFIG Release)
endif()
file(SHA256 "${LIBAVIF_SOURCE_DIR}/src/write.c" _real_before)
file(SHA256 "${PATCH_SCRIPT}" _patch_hash)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef _nonce)
set(_sandbox "${TEST_DIR}/grid-wave-${_nonce}")
if(EXISTS "${_sandbox}")
    message(FATAL_ERROR "grid wave contract: sandbox must be fresh")
endif()
file(MAKE_DIRECTORY "${_sandbox}/fixture/src" "${_sandbox}/probe")
file(COPY_FILE "${LIBAVIF_SOURCE_DIR}/src/write.c" "${_sandbox}/fixture/src/write.c")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${_sandbox}/fixture" -P "${PATCH_SCRIPT}"
    RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 60)
file(WRITE "${_sandbox}/patch.log" "input_write_sha256=${_real_before}\npatch_sha256=${_patch_hash}\n${_out}${_err}")
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "grid wave contract: patch fixture failed (${_result}); ${_sandbox}/patch.log")
endif()
file(READ "${_sandbox}/fixture/src/write.c" _patched)
string(REPLACE "\r\n" "\n" _patched "${_patched}")
set(_begin_marker "// AWJ_PARALLEL_GRID_PATCH_BEGIN\n")
set(_end_marker "// AWJ_PARALLEL_GRID_PATCH_END")
string(FIND "${_patched}" "${_begin_marker}" _begin)
string(FIND "${_patched}" "${_end_marker}" _end)
if(_begin LESS 0 OR _end LESS _begin)
    message(FATAL_ERROR "grid wave contract: production helper markers missing")
endif()
string(LENGTH "${_end_marker}" _end_length)
math(EXPR _length "${_end}+${_end_length}-${_begin}")
string(SUBSTRING "${_patched}" ${_begin} ${_length} _helper)
if(NOT _helper MATCHES "AWJ_PARALLEL_GRID_WAVE_BUDGET_V3" OR
   NOT _helper MATCHES "avifAWJGridWaveWorkerThreadBudget" OR
   NOT _helper MATCHES "avifAWJEncodeSimpleGridParallel")
    message(FATAL_ERROR "grid wave contract: current wave-budget helper was not injected")
endif()
# Check a second application, not a separately reimplemented budget algorithm.
file(SHA256 "${_sandbox}/fixture/src/write.c" _first_hash)
execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${_sandbox}/fixture" -P "${PATCH_SCRIPT}"
    RESULT_VARIABLE _repeat_result OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 60)
file(SHA256 "${_sandbox}/fixture/src/write.c" _repeat_hash)
file(APPEND "${_sandbox}/patch.log" "patched_write_sha256=${_first_hash}\n${_out}${_err}")
if(NOT _repeat_result EQUAL 0 OR NOT _repeat_hash STREQUAL _first_hash)
    message(FATAL_ERROR "grid wave contract: helper reinjection was not idempotent; ${_sandbox}/patch.log")
endif()
# 覆盖旧标记重入，以及旧升级路径留下的接缝空行；整文件必须回到同一规范状态。
foreach(_migration IN ITEMS old-marker stale-boundary)
    set(_migration_input "${_patched}")
    if(_migration STREQUAL "old-marker")
        string(REPLACE "AWJ_PARALLEL_GRID_WAVE_BUDGET_V3" "AWJ_PARALLEL_GRID_WAVE_BUDGET_V2"
            _migration_input "${_migration_input}")
    else()
        string(REPLACE "// AWJ_PARALLEL_GRID_PATCH_BEGIN" "\n\n// AWJ_PARALLEL_GRID_PATCH_BEGIN"
            _migration_input "${_migration_input}")
        string(REPLACE "    // AWJ_PARALLEL_GRID_LOOP_PATCH_BEGIN" "\n\n    // AWJ_PARALLEL_GRID_LOOP_PATCH_BEGIN"
            _migration_input "${_migration_input}")
    endif()
    file(WRITE "${_sandbox}/fixture/src/write.c" "${_migration_input}")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${_sandbox}/fixture" -P "${PATCH_SCRIPT}"
        RESULT_VARIABLE _migration_result OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 60)
    file(SHA256 "${_sandbox}/fixture/src/write.c" _migration_hash)
    file(APPEND "${_sandbox}/patch.log" "migration=${_migration}\n${_out}${_err}")
    if(NOT _migration_result EQUAL 0 OR NOT _migration_hash STREQUAL _first_hash)
        message(FATAL_ERROR "grid wave contract: ${_migration} changed canonical file state; ${_sandbox}/patch.log")
    endif()
endforeach()
string(SHA256 _helper_hash "${_helper}")
file(WRITE "${_sandbox}/probe/awj_grid_wave_helpers.h" "${_helper}\n")
file(COPY_FILE "${CMAKE_CURRENT_LIST_DIR}/grid_wave_budget_probe.c" "${_sandbox}/probe/grid_wave_budget_probe.c")
file(WRITE "${_sandbox}/probe/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.24)
project(awj_grid_wave_budget_probe LANGUAGES C)
find_package(Threads REQUIRED)
add_executable(awj_grid_wave_budget_probe grid_wave_budget_probe.c)
set_target_properties(awj_grid_wave_budget_probe PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED ON C_EXTENSIONS OFF)
target_link_libraries(awj_grid_wave_budget_probe PRIVATE Threads::Threads)
# The script runs the probe itself; provide a generator-independent location.
set_target_properties(awj_grid_wave_budget_probe PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
foreach(config IN ITEMS DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
    set_target_properties(awj_grid_wave_budget_probe PROPERTIES "RUNTIME_OUTPUT_DIRECTORY_${config}" "${CMAKE_BINARY_DIR}/bin")
endforeach()
]=])
set(_configure "${CMAKE_COMMAND}" -S "${_sandbox}/probe" -B "${_sandbox}/build"
    -G "${PROBE_GENERATOR}" "-DCMAKE_C_COMPILER=${C_COMPILER}" "-DCMAKE_BUILD_TYPE=${PROBE_CONFIG}")
if(DEFINED MAKE_PROGRAM AND NOT MAKE_PROGRAM STREQUAL "")
    list(APPEND _configure "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}")
endif()
execute_process(COMMAND ${_configure} RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 120)
file(WRITE "${_sandbox}/configure.log" "helper_sha256=${_helper_hash}\n${_out}${_err}")
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "grid wave contract: native C configure failed (${_result}); ${_sandbox}/configure.log")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${_sandbox}/build" --config "${PROBE_CONFIG}"
    --target awj_grid_wave_budget_probe RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 120)
file(WRITE "${_sandbox}/build.log" "${_out}${_err}")
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "grid wave contract: C helper probe build failed (${_result}); ${_sandbox}/build.log")
endif()
if(CMAKE_HOST_WIN32)
    set(_executable "${_sandbox}/build/bin/awj_grid_wave_budget_probe.exe")
else()
    set(_executable "${_sandbox}/build/bin/awj_grid_wave_budget_probe")
endif()
execute_process(COMMAND "${_executable}" RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err TIMEOUT 120)
file(WRITE "${_sandbox}/run.log" "${_out}${_err}")
file(SHA256 "${LIBAVIF_SOURCE_DIR}/src/write.c" _real_after)
if(NOT _real_after STREQUAL _real_before)
    message(FATAL_ERROR "grid wave contract: real dependency changed during the read-only probe")
endif()
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "grid wave contract: production helper failed (${_result}); ${_sandbox}/run.log")
endif()
# Successful probes retain the small source/helper and raw logs, not disposable
# dependency copies or a full build tree. Failed probes retain their whole scene.
file(REMOVE_RECURSE "${_sandbox}/fixture" "${_sandbox}/build")
message(STATUS "grid wave contract passed; helper SHA256 ${_helper_hash}; evidence ${_sandbox}")
