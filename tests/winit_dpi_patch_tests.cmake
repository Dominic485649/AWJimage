# Pure patch contract plus a small rustc snippet probe; no Slint/AWJ build.
# Supply WINIT_SOURCE_ARCHIVE (official .crate) or WINIT_SOURCE_DIR (pristine extraction).
# Repeated CTest calls get a fresh child, without overwriting earlier evidence.
if(NOT DEFINED TEST_DIR OR TEST_DIR STREQUAL "")
    message(FATAL_ERROR "winit contract: TEST_DIR is required")
endif()
if(EXISTS "${TEST_DIR}")
    string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
    set(TEST_DIR "${TEST_DIR}/run-${run_id}")
    if(EXISTS "${TEST_DIR}")
        message(FATAL_ERROR "winit contract: fresh test directory collision")
    endif()
endif()
if(NOT DEFINED WINIT_SOURCE_ARCHIVE AND NOT DEFINED WINIT_SOURCE_DIR)
    message(FATAL_ERROR "winit contract: WINIT_SOURCE_ARCHIVE or WINIT_SOURCE_DIR is required")
endif()
set(patch "${CMAKE_CURRENT_LIST_DIR}/../cmake/patch_winit_dpi.cmake")
set(paths Cargo.toml src/platform_impl/windows/dark_mode.rs src/platform_impl/windows/event_loop.rs)
file(MAKE_DIRECTORY "${TEST_DIR}")
if(DEFINED WINIT_SOURCE_ARCHIVE)
    file(SHA256 "${WINIT_SOURCE_ARCHIVE}" archive_hash)
    if(NOT archive_hash STREQUAL "a6755fa58a9f8350bd1e472d4c3fcc25f824ec358933bba33306d0b63df5978d")
        message(FATAL_ERROR "winit contract: official crate SHA256 mismatch")
    endif()
    file(MAKE_DIRECTORY "${TEST_DIR}/extract")
    file(ARCHIVE_EXTRACT INPUT "${WINIT_SOURCE_ARCHIVE}" DESTINATION "${TEST_DIR}/extract")
    set(source "${TEST_DIR}/extract/winit-0.30.13")
else()
    # A minimal fixture is sufficient; production patching verifies these full files.
    set(source "${TEST_DIR}/source")
    foreach(path IN LISTS paths)
        get_filename_component(parent "${source}/${path}" DIRECTORY)
        file(MAKE_DIRECTORY "${parent}")
        file(COPY_FILE "${WINIT_SOURCE_DIR}/${path}" "${source}/${path}")
    endforeach()
endif()
set(original_hashes
    2aeb741d47b763ee198ca915c330a6bf0b1fc094dd69357e80278b7852289c61
    9fa225a2462e0a0467b7608fc126515f5138d7762f0f86688b17ef9d627f0fe1
    f99c748e189ea8ce4bde08ec186ee27306756ce93d5235371e198c07e582c52d)
foreach(path hash IN ZIP_LISTS paths original_hashes)
    file(READ "${source}/${path}" original)
    string(REPLACE "\r\n" "\n" original "${original}")
    string(SHA256 actual "${original}")
    if(NOT actual STREQUAL hash)
        message(FATAL_ERROR "winit contract: pristine hash mismatch in ${path}")
    endif()
    set("original_${path}" "${original}")
endforeach()
function(run_patch expected label)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${source}" ${ARGN} -P "${patch}"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    file(WRITE "${TEST_DIR}/${label}.log" "${out}${err}")
    if(expected STREQUAL "pass")
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "${label} failed: ${out}${err}")
        endif()
    elseif(result EQUAL 0 OR NOT "${out}${err}" MATCHES "${expected}")
        message(FATAL_ERROR "${label} did not fail as expected: ${out}${err}")
    endif()
endfunction()
function(snapshot output)
    set(hashes "")
    foreach(path IN LISTS paths)
        file(SHA256 "${source}/${path}" hash)
        list(APPEND hashes "${hash}")
    endforeach()
    set(${output} "${hashes}" PARENT_SCOPE)
endfunction()
run_patch("already-patched" verify-pristine -DAWJ_WINIT_VERIFY_ONLY=ON)
file(APPEND "${source}/src/platform_impl/windows/event_loop.rs" "\n// unrecognized pristine drift\n")
snapshot(before_rejection)
run_patch("SHA256 mismatch" reject-pristine-drift)
snapshot(after_rejection)
if(NOT before_rejection STREQUAL after_rejection)
    message(FATAL_ERROR "winit pristine-input rejection wrote partial changes")
endif()
file(WRITE "${source}/src/platform_impl/windows/event_loop.rs" "${original_src/platform_impl/windows/event_loop.rs}")
run_patch(pass first)
snapshot(first_hashes)
foreach(path IN LISTS paths)
    file(READ "${source}/${path}" text)
    set("patched_${path}" "${text}")
endforeach()
run_patch(pass repeated)
run_patch(pass verify-patched -DAWJ_WINIT_VERIFY_ONLY=ON)
snapshot(repeated_hashes)
if(NOT first_hashes STREQUAL repeated_hashes)
    message(FATAL_ERROR "winit contract: repeated patch changed files")
endif()

set(event src/platform_impl/windows/event_loop.rs)
set(dark src/platform_impl/windows/dark_mode.rs)
# Verify that the entire legacy geometry block survives byte-for-byte.
set(legacy_start "                let suggested_ul =")
set(legacy_end "\n            unsafe {\n                SetWindowPos(")
foreach(kind IN ITEMS original patched)
    string(FIND "${${kind}_${event}}" "${legacy_start}" start)
    string(FIND "${${kind}_${event}}" "${legacy_end}" end)
    math(EXPR length "${end} - ${start}")
    string(SUBSTRING "${${kind}_${event}}" ${start} ${length} "${kind}_legacy")
endforeach()
if(NOT original_legacy STREQUAL patched_legacy)
    message(FATAL_ERROR "winit contract: legacy positioning/nudge block changed")
endif()

foreach(case IN ITEMS missing-anchor duplicate-anchor unrelated-change partial-file partial-tree)
    set(changed "${patched_${event}}")
    if(case STREQUAL missing-anchor)
        string(REPLACE "let suggested_ul =" "let broken_suggested_ul =" changed "${changed}")
    elseif(case STREQUAL duplicate-anchor)
        string(APPEND changed "\n            let new_outer_rect: RECT;\n            {\n                let suggested_ul =\n")
    elseif(case STREQUAL unrelated-change)
        string(APPEND changed "\n// unrecognized source drift\n")
    elseif(case STREQUAL partial-file)
        string(REPLACE "pub(super) static WIN10_BUILD_VERSION" "static WIN10_BUILD_VERSION" broken "${patched_${dark}}")
        file(WRITE "${source}/${dark}" "${broken}")
    else()
        set(changed "${original_${event}}")
    endif()
    file(WRITE "${source}/${event}" "${changed}")
    snapshot(before_rejection)
    run_patch("anchor missing|SHA256 mismatch|partially patched" "reject-${case}")
    snapshot(after_rejection)
    if(NOT before_rejection STREQUAL after_rejection)
        message(FATAL_ERROR "winit contract: rejection wrote partial changes (${case})")
    endif()
    foreach(path IN LISTS paths)
        file(WRITE "${source}/${path}" "${patched_${path}}")
    endforeach()
endforeach()

# Compile the actual selected-size, writer-read, OS-query and modern-rect snippets.
# Mocks cover pure geometry only, not native drag behavior or real monitor APIs.
string(REGEX MATCH "super::dark_mode::WIN10_BUILD_VERSION[.]is_some_and[^\n]+" predicate "${patched_${event}}")
string(REPLACE "super::dark_mode::WIN10_BUILD_VERSION" "build" AWJ_BUILD_PREDICATE "${predicate}")
string(REGEX REPLACE " \\{$" "" AWJ_BUILD_PREDICATE "${AWJ_BUILD_PREDICATE}")
string(REGEX MATCH "let new_physical_inner_size = match allow_resize \\{[^;]+;" AWJ_SIZE_POLICY "${patched_${event}}")
set(AWJ_WRITER_READ "let new_physical_inner_size = *new_inner_size.lock().unwrap();\n            drop(new_inner_size);")
string(FIND "${patched_${event}}" "${AWJ_WRITER_READ}" writer_pos)
string(REGEX MATCH "let requested_inner_rect = RECT \\{[^@]+" tail "${patched_${event}}")
string(FIND "${tail}" "\n            } else {" end)
string(SUBSTRING "${tail}" 0 ${end} AWJ_MODERN_RECT)
string(REGEX MATCH "Lazy::new\\(\\|\\| \\{([^@]+)" tail "${patched_${dark}}")
string(LENGTH "Lazy::new(|| {" start)
string(FIND "${tail}" "\n});" end)
math(EXPR length "${end} - ${start}")
string(SUBSTRING "${tail}" ${start} ${length} AWJ_VERSION_QUERY)
if(writer_pos EQUAL -1 OR AWJ_SIZE_POLICY STREQUAL "" OR AWJ_BUILD_PREDICATE STREQUAL "")
    message(FATAL_ERROR "winit contract: behavior probe snippet missing")
endif()
file(MAKE_DIRECTORY "${TEST_DIR}/probe")
configure_file("${CMAKE_CURRENT_LIST_DIR}/winit_dpi_patch_probe.rs.in" "${TEST_DIR}/probe/winit_dpi_patch_probe.rs" @ONLY)
find_program(RUSTC_EXECUTABLE rustc REQUIRED)
if(CMAKE_HOST_WIN32)
    set(exe "${TEST_DIR}/probe/winit_dpi_patch_probe.exe")
else()
    set(exe "${TEST_DIR}/probe/winit_dpi_patch_probe")
endif()
execute_process(COMMAND "${RUSTC_EXECUTABLE}" --edition=2021 --test
    "${TEST_DIR}/probe/winit_dpi_patch_probe.rs" -o "${exe}"
    WORKING_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}/.."
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
file(WRITE "${TEST_DIR}/probe-compile.log" "${out}${err}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "winit snippet probe compile failed: ${out}${err}")
endif()
execute_process(COMMAND "${exe}" --nocapture RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
file(WRITE "${TEST_DIR}/probe-run.log" "${out}${err}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "winit snippet probe failed: ${out}${err}")
endif()
file(SHA256 "${patch}" patch_hash)
file(SHA256 "${CMAKE_CURRENT_LIST_FILE}" contract_hash)
file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/winit_dpi_patch_probe.rs.in" probe_hash)
execute_process(COMMAND "${RUSTC_EXECUTABLE}" --version OUTPUT_VARIABLE rustc_version OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
file(WRITE "${TEST_DIR}/result.txt" "winit 0.30.13 crate SHA256: a6755fa58a9f8350bd1e472d4c3fcc25f824ec358933bba33306d0b63df5978d\nArchive input: ${WINIT_SOURCE_ARCHIVE}\nSource input: ${WINIT_SOURCE_DIR}\nPatch SHA256: ${patch_hash}\nContract SHA256: ${contract_hash}\nProbe template SHA256: ${probe_hash}\nCMake: ${CMAKE_COMMAND} / ${CMAKE_VERSION}\nRust: ${RUSTC_EXECUTABLE} / ${rustc_version}\nfiles: ${paths}\noriginal hashes: ${original_hashes}\npatched hashes: ${first_hashes}\nPristine/repeat/verify-only/pristine-drift/partial/anchor rejection without writes and five synthetic Rust tests passed.\nNo full winit/Slint/AWJ build or real monitor drag performed.\n")
message(STATUS "winit DPI contract passed; patched fixture: ${source}; evidence: ${TEST_DIR}")
