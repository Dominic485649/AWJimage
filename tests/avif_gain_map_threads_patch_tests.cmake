# Self-contained patch contract. Only fresh task-owned fixture directories are
# written; no configure/build or real populated dependency is changed.
if(NOT DEFINED LIBAVIF_SOURCE_DIR OR NOT DEFINED TEST_DIR OR
   NOT IS_ABSOLUTE "${LIBAVIF_SOURCE_DIR}" OR NOT IS_ABSOLUTE "${TEST_DIR}")
    message(FATAL_ERROR "Absolute LIBAVIF_SOURCE_DIR and TEST_DIR are required")
endif()
if(NOT DEFINED PATCH_SCRIPT)
    set(PATCH_SCRIPT "${CMAKE_CURRENT_LIST_DIR}/../cmake/patch_libavif_gain_map_threads.cmake")
endif()
set(REAL_C "${LIBAVIF_SOURCE_DIR}/src/gainmap.c")
set(REAL_H "${LIBAVIF_SOURCE_DIR}/include/avif/internal.h")
set(REAL_ABI "${LIBAVIF_SOURCE_DIR}/include/avif/awj_gain_map.h")
file(SHA256 "${REAL_C}" REAL_C_BEFORE)
file(SHA256 "${REAL_H}" REAL_H_BEFORE)
file(READ "${REAL_C}" REAL_SOURCE)
file(READ "${REAL_H}" REAL_INTERNAL)
set(REAL_HEADER "<missing>")
if(EXISTS "${REAL_ABI}")
    file(SHA256 "${REAL_ABI}" REAL_ABI_BEFORE)
    file(READ "${REAL_ABI}" REAL_HEADER)
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef NONCE)
set(SANDBOX "${TEST_DIR}/gain-map-threads-contract-${NONCE}")
if(EXISTS "${SANDBOX}")
    message(FATAL_ERROR "Fixture directory already exists: ${SANDBOX}")
endif()
file(MAKE_DIRECTORY "${SANDBOX}")
function(fixture NAME SOURCE INTERNAL HEADER)
    file(MAKE_DIRECTORY "${SANDBOX}/${NAME}/src" "${SANDBOX}/${NAME}/include/avif")
    file(WRITE "${SANDBOX}/${NAME}/src/gainmap.c" "${SOURCE}")
    file(WRITE "${SANDBOX}/${NAME}/include/avif/internal.h" "${INTERNAL}")
    if(NOT HEADER STREQUAL "<missing>")
        file(WRITE "${SANDBOX}/${NAME}/include/avif/awj_gain_map.h" "${HEADER}")
    endif()
endfunction()
function(apply NAME)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${SANDBOX}/${NAME}" -P "${PATCH_SCRIPT}"
        RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
    if(NOT RESULT EQUAL 0)
        message(FATAL_ERROR "Gain-map patch ${NAME} failed: ${OUTPUT}${ERROR}; ${SANDBOX}")
    endif()
endfunction()
function(reject NAME SOURCE INTERNAL HEADER)
    fixture("${NAME}" "${SOURCE}" "${INTERNAL}" "${HEADER}")
    file(SHA256 "${SANDBOX}/${NAME}/src/gainmap.c" BEFORE)
    file(SHA256 "${SANDBOX}/${NAME}/include/avif/internal.h" INTERNAL_BEFORE)
    if(NOT HEADER STREQUAL "<missing>")
        file(SHA256 "${SANDBOX}/${NAME}/include/avif/awj_gain_map.h" ABI_BEFORE)
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${SANDBOX}/${NAME}" -P "${PATCH_SCRIPT}"
        RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE ERROR)
    file(SHA256 "${SANDBOX}/${NAME}/src/gainmap.c" AFTER)
    file(SHA256 "${SANDBOX}/${NAME}/include/avif/internal.h" INTERNAL_AFTER)
    if(RESULT EQUAL 0 OR NOT ERROR MATCHES "libavif gain-map threads patch:" OR
       NOT BEFORE STREQUAL AFTER OR NOT INTERNAL_BEFORE STREQUAL INTERNAL_AFTER)
        message(FATAL_ERROR "Gain-map patch accepted/modified ${NAME}: ${OUTPUT}${ERROR}; ${SANDBOX}")
    endif()
    if(HEADER STREQUAL "<missing>")
        if(EXISTS "${SANDBOX}/${NAME}/include/avif/awj_gain_map.h")
            message(FATAL_ERROR "Rejected patch created an ABI header: ${NAME}")
        endif()
    else()
        file(SHA256 "${SANDBOX}/${NAME}/include/avif/awj_gain_map.h" ABI_AFTER)
        if(NOT ABI_BEFORE STREQUAL ABI_AFTER)
            message(FATAL_ERROR "Rejected patch changed its ABI header: ${NAME}")
        endif()
    endif()
endfunction()
function(change OUT INPUT NEEDLE REPLACEMENT)
    string(FIND "${INPUT}" "${NEEDLE}" POS)
    if(POS EQUAL -1 OR NEEDLE STREQUAL REPLACEMENT)
        message(FATAL_ERROR "Missing contract mutation anchor: ${NEEDLE}")
    endif()
    string(REPLACE "${NEEDLE}" "${REPLACEMENT}" CHANGED "${INPUT}")
    set(${OUT} "${CHANGED}" PARENT_SCOPE)
endfunction()
fixture(actual "${REAL_SOURCE}" "${REAL_INTERNAL}" "${REAL_HEADER}")
apply(actual)
file(READ "${SANDBOX}/actual/src/gainmap.c" PATCHED)
file(READ "${SANDBOX}/actual/include/avif/awj_gain_map.h" ABI)
set(MARKER "\n// AWJ_GAIN_MAP_THREADS_BEGIN\n")
string(FIND "${PATCHED}" "${MARKER}" POS)
if(POS EQUAL -1)
    message(FATAL_ERROR "Gain-map patch has no begin marker")
endif()
string(SUBSTRING "${PATCHED}" 0 ${POS} PRISTINE)
string(SUBSTRING "${PATCHED}" ${POS} -1 APPENDIX)
string(SHA256 PRISTINE_HASH "${PRISTINE}")
if(NOT PRISTINE_HASH STREQUAL "b92807d0e621c956239f092f43d0ca5b95458b2ae333e4a4450dc963f173804b")
    message(FATAL_ERROR "Gain-map patch changed upstream reference code")
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/../src/codecs/avif_gain_map_thread_adapter.h" PROJECT_ABI)
if(NOT ABI STREQUAL PROJECT_ABI)
    message(FATAL_ERROR "Generated and project ABI declarations differ")
endif()
foreach(REQUIRED IN ITEMS
        "#define AWJ_GAIN_WORKERS 64"
        "pixels / 16384"
        "count / p->count"
        "error == EAGAIN"
        "error == ENOMEM ? AVIF_RESULT_OUT_OF_MEMORY"
        "((pixel - w->begin) & 255)"
        "rgbSumLinear += ((const float *)w->scratch)[p]"
        "uint64_t * histogram"
        "awjGainPoolDestroy(&pool);"
        "// AWJ_GAIN_MAP_THREADS_END\n")
    string(FIND "${APPENDIX}" "${REQUIRED}" FOUND)
    if(FOUND EQUAL -1)
        message(FATAL_ERROR "Required gain-map contract lost: ${REQUIRED}")
    endif()
endforeach()
fixture(first "${PRISTINE}" "${REAL_INTERNAL}" "<missing>")
apply(first)
file(READ "${SANDBOX}/first/src/gainmap.c" FIRST)
if(NOT FIRST STREQUAL PATCHED)
    message(FATAL_ERROR "First and populated patch application differ")
endif()
file(SHA256 "${SANDBOX}/first/src/gainmap.c" FIRST_HASH)
file(SHA256 "${SANDBOX}/first/include/avif/awj_gain_map.h" ABI_FIRST_HASH)
apply(first)
file(SHA256 "${SANDBOX}/first/src/gainmap.c" SECOND_HASH)
file(SHA256 "${SANDBOX}/first/include/avif/awj_gain_map.h" ABI_SECOND_HASH)
if(NOT FIRST_HASH STREQUAL SECOND_HASH OR NOT ABI_FIRST_HASH STREQUAL ABI_SECOND_HASH)
    message(FATAL_ERROR "Gain-map patch is not idempotent")
endif()
string(REPLACE "\n" "\r\n" CRLF_SOURCE "${PRISTINE}")
string(REPLACE "\n" "\r\n" CRLF_INTERNAL "${REAL_INTERNAL}")
fixture(crlf "${CRLF_SOURCE}" "${CRLF_INTERNAL}" "<missing>")
apply(crlf)
file(READ "${SANDBOX}/crlf/src/gainmap.c" CRLF_PATCHED)
if(NOT CRLF_PATCHED STREQUAL PATCHED)
    message(FATAL_ERROR "Gain-map CRLF and LF applications diverged")
endif()
reject(unknown_source "// unknown upstream\n" "${REAL_INTERNAL}" "<missing>")
change(BAD "${PRISTINE}" "static const float kEpsilon = 1e-10f;" "static const float kEpsilon = 1e-8f;")
reject(changed_upstream "${BAD}" "${REAL_INTERNAL}" "<missing>")
reject(changed_upstream_patched "${BAD}${APPENDIX}" "${REAL_INTERNAL}" "${ABI}")
change(BAD_INTERNAL "${REAL_INTERNAL}" "    uint32_t pixelBytes;" "    uint64_t pixelBytes;")
reject(changed_internal "${PRISTINE}" "${BAD_INTERNAL}" "<missing>")
reject(changed_internal_patched "${PATCHED}" "${BAD_INTERNAL}" "${ABI}")
reject(marker_only "${PRISTINE}${MARKER}" "${REAL_INTERNAL}" "<missing>")
change(BAD "${PATCHED}" "// AWJ_GAIN_MAP_THREADS_END\n" "")
reject(missing_end "${BAD}" "${REAL_INTERNAL}" "${ABI}")
change(BAD "${PATCHED}" "#define AWJ_GAIN_WORKERS 64" "#define AWJ_GAIN_WORKERS 4096")
reject(damaged_budget "${BAD}" "${REAL_INTERNAL}" "${ABI}")
change(BAD "${PATCHED}" "rgbSumLinear += ((const float *)w->scratch)[p]" "rgbSumLinear += 1.0f")
reject(damaged_math "${BAD}" "${REAL_INTERNAL}" "${ABI}")
reject(duplicate_appendix "${PATCHED}${APPENDIX}" "${REAL_INTERNAL}" "${ABI}")
reject(trailing_edit "${PATCHED}\n// unknown edit\n" "${REAL_INTERNAL}" "${ABI}")
reject(missing_header "${PATCHED}" "${REAL_INTERNAL}" "<missing>")
change(BAD_ABI "${ABI}" "uint32_t workers_started;" "uint64_t workers_started;")
reject(damaged_header "${PATCHED}" "${REAL_INTERNAL}" "${BAD_ABI}")
reject(damaged_header_pristine "${PRISTINE}" "${REAL_INTERNAL}" "${BAD_ABI}")
file(SHA256 "${REAL_C}" REAL_C_AFTER)
file(SHA256 "${REAL_H}" REAL_H_AFTER)
if(NOT REAL_C_BEFORE STREQUAL REAL_C_AFTER OR NOT REAL_H_BEFORE STREQUAL REAL_H_AFTER)
    message(FATAL_ERROR "Contract changed the actual populated dependency")
endif()
if(REAL_HEADER STREQUAL "<missing>")
    if(EXISTS "${REAL_ABI}")
        message(FATAL_ERROR "Contract created an ABI header in the real dependency")
    endif()
else()
    file(SHA256 "${REAL_ABI}" REAL_ABI_AFTER)
    if(NOT REAL_ABI_BEFORE STREQUAL REAL_ABI_AFTER)
        message(FATAL_ERROR "Contract changed the real ABI header")
    endif()
endif()
file(READ "${PATCH_SCRIPT}" PATCH_TEXT)
string(SHA256 PATCH_HASH "${PATCH_TEXT}")
string(SHA256 ABI_HASH "${ABI}")
# Successful fixtures contain only reproducible copies of public pinned source.
# A failed run retains its fresh sandbox for diagnosis; never delete another run.
file(REMOVE_RECURSE "${SANDBOX}")
message(STATUS "Gain-map patch SHA-256 (LF): ${PATCH_HASH}")
message(STATUS "Gain-map ABI SHA-256 (LF): ${ABI_HASH}")
message(STATUS "Gain-map patch contract passed: pristine/repeat/CRLF, 14 rejection cases; real dependency unchanged; successful sandbox removed")
