# Pinned git objects, not the potentially patched dependency worktree.
# AWJ_WINIT_SOURCE_DIR is optional; when supplied it must already pass the winit
# patch's verify-only contract. Existing Slint-only invocations need no new args.
if(NOT DEFINED SLINT_SOURCE_DIR OR NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "SLINT_SOURCE_DIR and TEST_DIR are required")
endif()
# CTest reuses its TEST_DIR. Keep prior evidence and make a fresh child on reruns.
if(EXISTS "${TEST_DIR}")
    string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
    set(TEST_DIR "${TEST_DIR}/run-${run_id}")
    if(EXISTS "${TEST_DIR}")
        message(FATAL_ERROR "Slint contract: fresh test directory collision")
    endif()
endif()
find_package(Git REQUIRED)
set(revision 372cf0ee5577c3dfec309a45e7b778ba4e81b734)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SLINT_SOURCE_DIR}" rev-parse HEAD
    OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(NOT head STREQUAL revision)
    message(FATAL_ERROR "Slint contract requires the pinned 1.18.1 revision")
endif()
set(files api/cpp/Cargo.toml api/cpp/include/private/slint_config.h internal/core/window.rs
    internal/backends/winit/winitwindowadapter.rs internal/backends/winit/event_loop.rs
    api/cpp/include/private/slint_models.h internal/renderers/femtovg/itemrenderer.rs)
file(READ "${CMAKE_CURRENT_LIST_DIR}/../release.ps1" windows_release_script)
string(REGEX MATCH "\"slint\"[ \t]+=[ \t]+@\\([^)]*\\)" windows_slint_cache "${windows_release_script}")
set(whitelist ${files})
if(DEFINED AWJ_WINIT_SOURCE_DIR)
    list(APPEND whitelist Cargo.toml Cargo.lock)
endif()
foreach(path IN LISTS whitelist)
    string(FIND "${windows_slint_cache}" "\" M ${path}\"" cache_entry)
    if(cache_entry EQUAL -1)
        message(FATAL_ERROR "Windows release cache whitelist omits patched Slint file: ${path}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${TEST_DIR}")
# Keep generated fixtures separate from the scripts that run against them.
set(source "${TEST_DIR}/source")
set(all_files ${files} Cargo.toml Cargo.lock internal/renderers/software/lib.rs)
foreach(path IN LISTS all_files)
    get_filename_component(parent "${source}/${path}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SLINT_SOURCE_DIR}" show "${revision}:${path}"
        OUTPUT_FILE "${source}/${path}" COMMAND_ERROR_IS_FATAL ANY)
    file(READ "${source}/${path}" original)
    string(REPLACE "\r\n" "\n" original "${original}")
    set("original_${path}" "${original}")
endforeach()
# Both regular and scene software rendering paths already round physical dirty
# bounds outwards. Do not add a renderer patch that duplicates upstream behavior.
set(rounding_anchor ".to_rect()\n                        .round_out()")
string(FIND "${original_internal/renderers/software/lib.rs}" "${rounding_anchor}" regular_rounding)
string(FIND "${original_internal/renderers/software/lib.rs}" ".to_rect()\n                .round_out()" scene_rounding)
if(regular_rounding EQUAL -1 OR scene_rounding EQUAL -1)
    message(FATAL_ERROR "Slint 1.18.1 software dirty-region outward rounding contract changed")
endif()
set(patch "${CMAKE_CURRENT_LIST_DIR}/../cmake/patch_slint_static_import.cmake")
function(run_patch expected label)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_DIR=${source}" ${ARGN} -P "${patch}"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    file(WRITE "${TEST_DIR}/${label}.log" "${out}${err}")
    if(expected STREQUAL "pass")
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "${label} failed: ${out}${err}")
        endif()
    elseif(result EQUAL 0 OR NOT "${out}${err}" MATCHES "${expected}")
        message(FATAL_ERROR "${label} did not fail as expected: ${out}${err}")
    endif()
endfunction()
function(snapshot output)
    set(hashes "")
    foreach(path IN LISTS all_files)
        file(SHA256 "${source}/${path}" hash)
        list(APPEND hashes "${hash}")
    endforeach()
    set(${output} "${hashes}" PARENT_SCOPE)
endfunction()
snapshot(original_hashes)
file(APPEND "${source}/internal/renderers/femtovg/itemrenderer.rs" "\n// unrecognized pristine drift\n")
snapshot(before_rejection)
run_patch("SHA256 mismatch" reject-pristine-drift)
snapshot(after_rejection)
if(NOT before_rejection STREQUAL after_rejection)
    message(FATAL_ERROR "Slint pristine-input rejection wrote partial changes")
endif()
file(WRITE "${source}/internal/renderers/femtovg/itemrenderer.rs" "${original_internal/renderers/femtovg/itemrenderer.rs}")
run_patch(pass first)
snapshot(first_hashes)
foreach(path IN LISTS all_files)
    file(READ "${source}/${path}" text)
    set("patched_${path}" "${text}")
endforeach()
run_patch(pass repeated)
snapshot(repeated_hashes)
if(NOT first_hashes STREQUAL repeated_hashes)
    message(FATAL_ERROR "Slint patches are not idempotent")
endif()

# Upgrade precisely the seven-file legacy patch state, not arbitrary partial trees.
set(adapter internal/backends/winit/winitwindowadapter.rs)
set(call "        #[cfg(target_os = \"windows\")]\n        self.mark_windows_update_region_dirty();\n\n")
set(method_start "    /// Windows invalidates the surface on DPI changes, independently of buffer age.")
set(method_end "    pub fn window_state_event(&self) {")
string(FIND "${patched_${adapter}}" "${method_start}" start)
string(FIND "${patched_${adapter}}" "${method_end}" end)
math(EXPR length "${end} - ${start}")
string(SUBSTRING "${patched_${adapter}}" ${start} ${length} method)
string(REPLACE "${method}" "" legacy "${patched_${adapter}}")
string(REPLACE "${call}" "" legacy "${legacy}")
file(WRITE "${source}/${adapter}" "${legacy}")
run_patch(pass legacy-upgrade)
snapshot(legacy_hashes)
if(NOT first_hashes STREQUAL legacy_hashes)
    message(FATAL_ERROR "Slint legacy upgrade differs from pristine application")
endif()
foreach(case IN ITEMS missing-event missing-renderer source-drift partial-dirty-method partial-tree duplicate-dirty-call)
    set(path "${adapter}")
    set(changed "${patched_${path}}")
    if(case STREQUAL missing-event)
        set(path internal/backends/winit/event_loop.rs)
        set(changed "// incompatible source\n")
    elseif(case STREQUAL missing-renderer)
        set(path internal/renderers/femtovg/itemrenderer.rs)
        set(changed "// incompatible source\n")
    elseif(case STREQUAL source-drift)
        string(APPEND changed "\n// unrecognized source drift\n")
    elseif(case STREQUAL partial-dirty-method)
        string(REPLACE "${method}" "" changed "${changed}")
    elseif(case STREQUAL partial-tree)
        set(path api/cpp/include/private/slint_config.h)
        set(changed "${original_${path}}")
    else()
        string(REPLACE "${call}" "${call}${call}" changed "${changed}")
    endif()
    file(WRITE "${source}/${path}" "${changed}")
    snapshot(before_rejection)
    run_patch("anchor missing|SHA256 mismatch|partially patched" "reject-${case}")
    snapshot(after_rejection)
    if(NOT before_rejection STREQUAL after_rejection)
        message(FATAL_ERROR "Slint rejection wrote partial changes (${case})")
    endif()
    file(WRITE "${source}/${path}" "${patched_${path}}")
endforeach()

if(DEFINED AWJ_WINIT_SOURCE_DIR)
    set(override_arg "-DAWJ_WINIT_SOURCE_DIR=${AWJ_WINIT_SOURCE_DIR}")
    run_patch(pass override-first "${override_arg}")
    snapshot(override_hashes)
    run_patch(pass override-repeated "${override_arg}")
    snapshot(override_again)
    if(NOT override_hashes STREQUAL override_again)
        message(FATAL_ERROR "Slint winit override is not idempotent")
    endif()
    file(READ "${source}/Cargo.toml" override_manifest)
    file(READ "${source}/Cargo.lock" override_lock)
    set(registry_lines "source = \"registry+https://github.com/rust-lang/crates.io-index\"\nchecksum = \"a6755fa58a9f8350bd1e472d4c3fcc25f824ec358933bba33306d0b63df5978d\"\n")
    string(REPLACE "${registry_lines}" "" expected_lock "${original_Cargo.lock}")
    if(NOT override_lock STREQUAL expected_lock)
        message(FATAL_ERROR "Slint override changed more than the fixed winit source/checksum")
    endif()
    file(REAL_PATH "${AWJ_WINIT_SOURCE_DIR}" winit_real)
    file(RELATIVE_PATH expected_path "${source}" "${winit_real}")
    string(REPLACE "\"" "\\\"" expected_path "${expected_path}")
    set(expected_manifest "${original_Cargo.toml}\n# AWJ_WINIT_DPI_OVERRIDE: winit 0.30.13 / PR #4341.\n[patch.crates-io]\nwinit = { path = \"${expected_path}\" }\n")
    if(NOT override_manifest STREQUAL expected_manifest)
        message(FATAL_ERROR "Slint override is not the exact portable relative TOML path")
    endif()
    # A changed vendor path must fail, not leave a stale or silently rewritten path.
    file(MAKE_DIRECTORY "${TEST_DIR}/other vendor")
    foreach(path IN ITEMS Cargo.toml src/platform_impl/windows/dark_mode.rs src/platform_impl/windows/event_loop.rs)
        get_filename_component(parent "${TEST_DIR}/other vendor/${path}" DIRECTORY)
        file(MAKE_DIRECTORY "${parent}")
        file(COPY_FILE "${winit_real}/${path}" "${TEST_DIR}/other vendor/${path}")
    endforeach()
    foreach(case IN ITEMS missing-argument changed-path partial-lock changed-lock)
        if(case STREQUAL missing-argument)
            set(args "")
        elseif(case STREQUAL changed-path)
            set(args "-DAWJ_WINIT_SOURCE_DIR=${TEST_DIR}/other vendor")
        else()
            set(args "${override_arg}")
            if(case STREQUAL partial-lock)
                file(WRITE "${source}/Cargo.lock" "${original_Cargo.lock}")
            else()
                file(APPEND "${source}/Cargo.lock" "\n# unrecognized lock drift\n")
            endif()
        endif()
        snapshot(before_rejection)
        run_patch("requires AWJ_WINIT_SOURCE_DIR|path/state mismatch|partially patched|SHA256 mismatch" "reject-override-${case}" ${args})
        snapshot(after_rejection)
        if(NOT before_rejection STREQUAL after_rejection)
            message(FATAL_ERROR "Slint override rejection wrote changes (${case})")
        endif()
        file(WRITE "${source}/Cargo.lock" "${override_lock}")
    endforeach()
    # Exercise a space-containing path on a pristine manifest pair.
    file(WRITE "${source}/Cargo.toml" "${original_Cargo.toml}")
    file(WRITE "${source}/Cargo.lock" "${original_Cargo.lock}")
    run_patch(pass override-space-path "-DAWJ_WINIT_SOURCE_DIR=${TEST_DIR}/other vendor")
    file(READ "${source}/Cargo.toml" space_manifest)
    if(NOT space_manifest MATCHES "path = \"[.][.]/other vendor\"")
        message(FATAL_ERROR "Slint space-containing relative TOML path failed")
    endif()
    # Leave the successful main fixture linked to the caller's vendor root.
    file(WRITE "${source}/Cargo.toml" "${override_manifest}")
    file(WRITE "${source}/Cargo.lock" "${override_lock}")
else()
    foreach(path IN ITEMS Cargo.toml Cargo.lock)
        if(NOT "${original_${path}}" STREQUAL "${patched_${path}}")
            message(FATAL_ERROR "Slint-only invocation changed ${path}")
        endif()
    endforeach()
endif()
file(READ "${source}/internal/renderers/software/lib.rs" software_after)
if(NOT software_after STREQUAL "${original_internal/renderers/software/lib.rs}")
    message(FATAL_ERROR "Slint software renderer was unnecessarily modified")
endif()
snapshot(final_hashes)
file(SHA256 "${patch}" patch_hash)
file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/../cmake/patch_winit_dpi.cmake" winit_patch_hash)
file(SHA256 "${CMAKE_CURRENT_LIST_FILE}" contract_hash)
file(WRITE "${TEST_DIR}/result.txt" "Slint revision: ${revision}\nGit object source: ${SLINT_SOURCE_DIR}\nPatch SHA256: ${patch_hash}\nWinit patch SHA256: ${winit_patch_hash}\nContract SHA256: ${contract_hash}\nCMake: ${CMAKE_COMMAND} / ${CMAKE_VERSION}\nfiles: ${all_files}\nOriginal hashes: ${original_hashes}\nSlint-only patched hashes: ${first_hashes}\nFinal hashes: ${final_hashes}\nWinit override source: ${AWJ_WINIT_SOURCE_DIR}\nPristine/repeat/legacy-upgrade/hash/partial/anchor rejection without writes passed.\nSoftware renderer outward rounding verified in both existing paths; renderer unchanged.\nNo full Slint/AWJ build or native-window behavior test performed.\n")
message(STATUS "Slint patch contract passed (winit override: ${AWJ_WINIT_SOURCE_DIR}); evidence: ${TEST_DIR}")
